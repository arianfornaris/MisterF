<%- include('partials/app-shell-open') %>

<section class="app-page roleplays-page">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <%- include('partials/resource-page-kicker', { resourceType: 'roleplay', pageLabel: t('quizzes.participationKicker') }) %>
      <h1 class="app-page-title"><%= selectedRoleplay.title %></h1>
      <%- include('partials/breadcrumb', { crumbs: [
        { label: t('resources.title'), href: '/resources' },
        ...(resourceFolderPath || []).map((folder) => ({
          label: folder.title,
          href: `/resources/folders/${encodeURIComponent(folder.id)}`,
        })),
        { label: selectedRoleplay.title, href: `/roleplays/${encodeURIComponent(selectedRoleplay.id)}` },
        { label: t('quizzes.participationKicker') },
      ] }) %>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>"
        aria-label="<%= t('common.close') %>"
        title="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (collectedAttempts.length === 0) { %>
    <div class="alert alert-light border mt-4 mb-0" role="status">
      <div class="d-flex align-items-start gap-3">
        <i class="bi bi-people fs-3 text-body-secondary" aria-hidden="true"></i>
        <div>
          <h2 class="h5 mb-1"><%= t('quizzes.participantsEmptyTitle') %></h2>
          <p class="mb-0 text-body-secondary"><%= t('quizzes.participantsEmptyBody') %></p>
        </div>
      </div>
    </div>
  <% } else { %>
    <% if (participationSummaryError) { %>
      <div class="alert alert-warning" role="alert">
        <p class="mb-<%= participationSummaryError.isCredit ? '2' : '0' %>"><%= participationSummaryError.message %></p>
        <% if (participationSummaryError.isCredit) { %>
          <a class="btn btn-primary btn-sm" href="/credits?returnTo=<%= encodeURIComponent(`/roleplays/${selectedRoleplay.id}/participation`) %>"><%= t('credit.buy') %></a>
        <% } %>
      </div>
    <% } %>

    <% if (evaluatedCount > 0) { %>
      <section class="resource-section">
        <div class="card">
          <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
              <h2 class="h5 mb-0"><i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.aiSummaryTitle') %></h2>
              <% if (participationSummary && participationSummary.stale) { %>
                <span class="badge text-bg-warning"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i><%= t('quizzes.aiSummaryStale') %></span>
              <% } %>
            </div>

            <% if (participationSummary) { %>
              <div class="resource-markdown" data-render-markdown><%= participationSummary.text %></div>
              <p class="text-body-secondary small mt-2 mb-2"><%= t('quizzes.aiSummaryGeneratedAt', { when: participationSummary.generatedAtRelative }) %></p>
            <% } else { %>
              <p class="text-body-secondary mb-2"><%= t('quizzes.aiSummaryIntro') %></p>
            <% } %>

            <form method="post" action="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/summary" data-roleplay-pending-form>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-<%= participationSummary ? 'outline-secondary' : 'primary' %> btn-sm" type="submit" data-roleplay-pending-submit>
                <i class="bi bi-<%= participationSummary ? 'arrow-clockwise' : 'stars' %> me-1" aria-hidden="true"></i>
                <%= participationSummary ? t('quizzes.aiSummaryRegenerate') : t('quizzes.aiSummaryGenerate') %>
              </button>
            </form>
          </div>
        </div>
      </section>
    <% } %>

    <div class="resource-section">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h5 mb-0"><%= t('quizzes.participantsSectionTitle') %></h2>
        <span class="badge text-bg-light border"><%= collectedAttempts.length %></span>
      </div>
      <div class="list-group shadow-sm">
        <% collectedAttempts.forEach((attempt) => { %>
          <% if (attempt.status === 'evaluated') { %>
            <a class="list-group-item list-group-item-action" href="/roleplay-attempts/<%= encodeURIComponent(attempt.id) %>/result">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span>
                  <i class="bi bi-person-circle me-1" aria-hidden="true"></i><%= attempt.participantLabel %>
                  <span class="badge <%= attempt.statusBadgeClass %> ms-1"><%= attempt.statusLabel %></span>
                </span>
                <span class="text-body-secondary"><%= attempt.relativeUpdatedAt %></span>
              </div>
            </a>
          <% } else { %>
            <div class="list-group-item">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span>
                  <i class="bi bi-person-circle me-1" aria-hidden="true"></i><%= attempt.participantLabel %>
                  <span class="badge <%= attempt.statusBadgeClass %> ms-1"><%= attempt.statusLabel %></span>
                </span>
                <span class="text-body-secondary"><%= attempt.relativeUpdatedAt %></span>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    </div>
  <% } %>
</section>

<%- include('partials/roleplay-pending-modal', {
  roleplayPendingMessage: t('quizzes.aiSummaryGenerating'),
}) %>

<%- include('partials/app-shell-close', { pageScriptPartial: 'roleplays-client-script' }) %>
