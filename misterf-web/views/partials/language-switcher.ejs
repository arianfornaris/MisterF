<% const rawSwitcherPath = typeof languageSwitcherPath !== 'undefined' && languageSwitcherPath ? languageSwitcherPath : '/'; %>
<% const switcherPath = rawSwitcherPath.split('?')[0] || '/'; %>
<div class="language-switcher btn-group btn-group-sm" role="group" aria-label="<%= t('language.label') %>">
  <% languages.forEach((language) => { %>
    <a
      class="btn btn-outline-secondary <%= locale === language.code ? 'active' : '' %>"
      href="<%= switcherPath %>?lang=<%= language.code %>"
      <%= locale === language.code ? 'aria-current="true"' : '' %>
    ><%= language.endonym %></a>
  <% }) %>
</div>
