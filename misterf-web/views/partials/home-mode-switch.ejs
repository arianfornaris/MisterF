<%# One-click switch between the two home compositions (Roadmap V3 §1.14).
    It writes the active profile's stored preference, so there is a single
    source of truth and the choice survives the next visit — the same value the
    profile form edits. It gates nothing: both modes reach every feature.

    Rendered as the theme's `.mf-mode-switch` on a row of its own. It was nav
    pills until the theme landed; the segmented control is the same idea, but
    its selected option paints itself with the mode accent rather than with the
    app's primary, so the control shows which mode you are in instead of only
    saying it. %>
<form
  class="mf-mode-switch home-mode-switch"
  method="post"
  action="/home/mode"
  aria-label="<%= t('home.modeAria') %>"
>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="returnTo" value="/">
  <% const activeHomeMode = activeProfile ? activeProfile.homeMode : 'learn'; %>
  <button
    type="submit"
    name="homeMode"
    value="learn"
    <%= activeHomeMode === 'learn' ? 'aria-current="page"' : '' %>
  >
    <i class="bi bi-mortarboard me-2" aria-hidden="true"></i><%= t('home.modeLearn') %>
  </button>
  <button
    type="submit"
    name="homeMode"
    value="teach"
    <%= activeHomeMode === 'teach' ? 'aria-current="page"' : '' %>
  >
    <i class="bi bi-easel me-2" aria-hidden="true"></i><%= t('home.modeTeach') %>
  </button>
</form>
