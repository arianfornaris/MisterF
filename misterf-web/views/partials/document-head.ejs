    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <%# Optional, and read through `locals` so the app pages that include this
        partial without them keep rendering. Only public pages need them. %>
    <% if (locals.metaDescription) { %>
      <meta name="description" content="<%= locals.metaDescription %>">
      <meta property="og:description" content="<%= locals.metaDescription %>">
    <% } %>
    <% if (locals.noindex) { %>
      <%# Crawlable but not indexed. The robots.txt route has to allow these
          paths for this tag to ever be read — a Disallow stops the crawl
          before the page, and a link-preview bot may refuse it outright. %>
      <meta name="robots" content="noindex, follow">
    <% } %>
    <% if (locals.canonicalUrl) { %>
      <link rel="canonical" href="<%= locals.canonicalUrl %>">
      <meta property="og:url" content="<%= locals.canonicalUrl %>">
      <meta property="og:type" content="website">
      <meta property="og:site_name" content="Mister F">
      <meta property="og:title" content="<%= locals.ogTitle || title %>">
      <meta name="twitter:card" content="<%= locals.ogImageUrl ? 'summary_large_image' : 'summary' %>">
    <% } %>
    <% if (locals.ogImageUrl) { %>
      <meta property="og:image" content="<%= locals.ogImageUrl %>">
    <% } %>
    <%# Reciprocal hreflang: every edition lists every edition, itself included,
        which is what tells a crawler these pages are translations rather than
        duplicates. %>
    <% (locals.alternateEditions || []).forEach((edition) => { %>
      <link rel="alternate" hreflang="<%= edition.hreflang %>" href="<%= edition.href %>">
    <% }) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600;7..72,700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="/public/brand/favicon-32.png">
    <%# The application theme. A public page can opt out with
        `includeAppStyles: false` and bring its own stylesheet instead — the
        landing does, so it ships no Bootstrap, no icon font, and no script. %>
    <% if (locals.includeAppStyles !== false) { %>
      <link rel="stylesheet" href="/vendor/bootswatch/flatly/bootstrap.min.css">
      <% if (locals.includeBootstrapIcons) { %>
        <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.css">
      <% } %>
      <%- include('app-stylesheet') %>
      <%- include('client-error-telemetry-script') %>
    <% } %>
    <% if (locals.pageStylesheet) { %>
      <link rel="stylesheet" href="<%= locals.pageStylesheet %>">
    <% } %>
