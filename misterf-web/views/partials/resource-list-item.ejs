<%
  const resourceCanMove = resource.canManage
    && !resource.archivedAt
    && (selectedFolder || resourceFolderOptions.some((folder) => folder.id !== resource.id));
%>
<div class="list-group-item position-relative d-flex align-items-start justify-content-between gap-2">
  <div class="min-w-0 flex-grow-1">
    <a class="stretched-link" href="<%= resource.detailPath %>">
      <span class="visually-hidden"><%= t('resources.open') %> <%= resource.label %> <%= resource.title %></span>
    </a>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <h2 class="h6 fw-normal mb-0">
        <i class="bi <%= resource.iconClass %> me-2" aria-hidden="true"></i><%= resource.title %>
      </h2>
      <span class="badge rounded-pill <%= resource.badgeClass %>"><%= resource.label %></span>
      <%# Compact badges: the icon carries the meaning and the label moves to the
          tooltip, so a long title keeps the row readable. The visually-hidden
          text is what a screen reader announces, since the icon is decorative. %>
      <% if (resource.isSharedWithMe) { %>
        <span class="badge text-bg-light border" title="<%= t('resources.sharedWithMeBadge') %>">
          <i class="bi bi-people" aria-hidden="true"></i>
          <span class="visually-hidden"><%= t('resources.sharedWithMeBadge') %></span>
        </span>
      <% } %>
      <% if (resource.isSharedByMe) { %>
        <% const sharedByMeTooltip = resource.sharedByMeProfileCount === 1
          ? t('resources.sharedByMeBadgeTooltipOne')
          : t('resources.sharedByMeBadgeTooltip', {
              count: resource.sharedByMeProfileCount,
            }); %>
        <span class="badge text-bg-light border" title="<%= sharedByMeTooltip %>">
          <i class="bi bi-share" aria-hidden="true"></i>
          <span class="ms-1"><%= resource.sharedByMeProfileCount %></span>
          <span class="visually-hidden"><%= sharedByMeTooltip %></span>
        </span>
      <% } %>
      <% if (resource.archivedAt) { %>
        <span class="badge text-bg-light border"><%= t('resources.archived') %></span>
      <% } %>
    </div>
    <p class="mb-0 small text-body-secondary">
      <%= t('resources.updated') %> <%= resource.relativeUpdatedAt %>
      <% if (resource.folderTitle) { %>
        <span class="mx-1" aria-hidden="true">·</span>
        <i class="bi bi-folder me-1" aria-hidden="true"></i><%= t('resources.inFolder', { folder: resource.folderTitle }) %>
      <% } %>
    </p>
  </div>
  <% if (resource.canManage) { %>
    <div class="dropdown position-relative z-1 flex-shrink-0 ms-2">
      <button
        class="btn btn-sm btn-link link-body-emphasis text-decoration-none p-0 resource-card-menu-button"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        aria-label="<%= t('resources.actionsOf', { title: resource.title }) %>"
        title="<%= t('resources.actions') %>"
      >
        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <% if (resource.type === 'resource_folder') { %>
          <% if (resourceCanMove) { %>
            <li>
              <button
                class="dropdown-item"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#moveResourceModal"
                data-resource-move-open
                data-resource-id="<%= resource.id %>"
                data-resource-title="<%= resource.title %>"
                data-resource-type="<%= resource.type %>"
                data-current-folder-id="<%= selectedFolder ? selectedFolder.id : '' %>"
              >
                <i class="bi bi-folder-symlink me-2" aria-hidden="true"></i><%= t('resources.moveFolder') %>
              </button>
            </li>
          <% } %>
          <% if (!resource.archivedAt) { %>
            <li>
              <form method="post" action="/resources/<%= encodeURIComponent(resource.id) %>/duplicate">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="returnTo" value="<%= currentPath %>">
                <button class="dropdown-item" type="submit">
                  <i class="bi bi-copy me-2" aria-hidden="true"></i><%= t('resources.duplicate') %>
                </button>
              </form>
            </li>
            <li>
              <a class="dropdown-item" href="<%= resource.detailPath %>?share=profile">
                <i class="bi bi-person me-2" aria-hidden="true"></i><%= t('resources.shareWithProfile') %>
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="<%= resource.detailPath %>?share=link">
                <i class="bi bi-share me-2" aria-hidden="true"></i><%= t('resources.share') %>
              </a>
            </li>
          <% } %>
          <% if (resourceCanMove || !resource.archivedAt) { %>
            <li><hr class="dropdown-divider"></li>
          <% } %>
          <li>
            <form method="post" action="/resources/<%= encodeURIComponent(resource.id) %>/<%= resource.archivedAt ? 'restore' : 'archive' %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="<%= currentPath %>">
              <button class="dropdown-item" type="submit">
                <i class="bi <%= resource.archivedAt ? 'bi-arrow-counterclockwise' : 'bi-archive' %> me-2" aria-hidden="true"></i>
                <%= resource.archivedAt ? t('resources.restore') : t('resources.archive') %>
              </button>
            </form>
          </li>
          <% if (!resource.archivedAt) { %>
            <li><hr class="dropdown-divider"></li>
            <li>
              <button
                class="dropdown-item"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#editResourceFolderModal"
                data-resource-folder-edit
                data-resource-folder-id="<%= resource.id %>"
                data-resource-folder-title="<%= resource.title %>"
                data-resource-folder-description="<%= resource.description %>"
              >
                <i class="bi bi-pencil me-2" aria-hidden="true"></i><%= t('resources.editFolder') %>
              </button>
            </li>
          <% } %>
        <% } else { %>
          <% if (!resource.archivedAt) { %>
            <li><a class="dropdown-item" href="<%= resource.detailPath %>?share=profile"><i class="bi bi-person me-2" aria-hidden="true"></i><%= t('resources.shareWithProfile') %></a></li>
            <li><a class="dropdown-item" href="<%= resource.detailPath %>?share=link"><i class="bi bi-share me-2" aria-hidden="true"></i><%= t('resources.share') %></a></li>
            <% if (resourceCanMove) { %>
              <li><hr class="dropdown-divider"></li>
              <li>
                <button
                  class="dropdown-item"
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#moveResourceModal"
                  data-resource-move-open
                  data-resource-id="<%= resource.id %>"
                  data-resource-title="<%= resource.title %>"
                  data-resource-type="<%= resource.type %>"
                  data-current-folder-id="<%= selectedFolder ? selectedFolder.id : '' %>"
                >
                  <i class="bi bi-folder-symlink me-2" aria-hidden="true"></i><%= t('resources.moveToFolder') %>
                </button>
              </li>
            <% } %>
            <li><hr class="dropdown-divider"></li>
          <% } %>
          <li>
            <form method="post" action="/resources/<%= encodeURIComponent(resource.id) %>/<%= resource.archivedAt ? 'restore' : 'archive' %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="<%= currentPath %>">
              <button class="dropdown-item" type="submit">
                <i class="bi <%= resource.archivedAt ? 'bi-arrow-counterclockwise' : 'bi-archive' %> me-2" aria-hidden="true"></i>
                <%= resource.archivedAt ? t('resources.restore') : t('resources.archive') %>
              </button>
            </form>
          </li>
        <% } %>
      </ul>
    </div>
  <% } %>
</div>
