<div class="dropdown d-inline-block">
  <button
    class="btn btn-secondary dropdown-toggle"
    type="button"
    data-bs-toggle="dropdown"
    aria-expanded="false"
  >
    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i><%= t('createResource.submit') %>
  </button>
  <ul class="dropdown-menu">
    <li>
      <button class="dropdown-item" type="button" data-create-resource-from-context data-resource-type="quiz">
        <i class="bi bi-ui-checks-grid me-2" aria-hidden="true"></i><%= t('chat.resourceTypeQuiz') %>
      </button>
    </li>
    <li>
      <button class="dropdown-item" type="button" data-create-resource-from-context data-resource-type="practice_guide">
        <i class="bi bi-journal-plus me-2" aria-hidden="true"></i><%= t('chat.resourceTypePracticeGuide') %>
      </button>
    </li>
    <li>
      <button class="dropdown-item" type="button" data-create-resource-from-context data-resource-type="roleplay">
        <i class="bi bi-person-video3 me-2" aria-hidden="true"></i><%= t('chat.resourceTypeRoleplay') %>
      </button>
    </li>
  </ul>
</div>

<div
  class="modal fade"
  id="createResourceFromContextModal"
  tabindex="-1"
  aria-labelledby="createResourceFromContextModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form method="post" action="<%= action %>" data-create-resource-from-context-form>
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="createResourceFromContextModalLabel">
            <%= t('createResource.titlePrefix') %> <span data-create-resource-from-context-label><%= t('createResource.genericLabel') %></span>
          </h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
        </div>
        <div class="modal-body">
          <p>
            <%= t('createResource.bodyResult') %>
          </p>
          <label class="form-label" for="createResourceFromContextPrompt">
            <%= t('createResource.promptLabel') %>
          </label>
          <textarea
            class="form-control"
            id="createResourceFromContextPrompt"
            name="prompt"
            rows="3"
            maxlength="2000"
            placeholder="<%= t('createResource.promptPlaceholderResult') %>"
          ></textarea>
        </div>
        <div class="modal-footer">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (typeof guestToken !== 'undefined' && guestToken) { %><input type="hidden" name="guestToken" value="<%= guestToken %>"><% } %>
          <input type="hidden" name="type" value="" data-create-resource-from-context-type>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
          <button
            type="submit"
            class="btn btn-primary"
            data-create-resource-from-context-submit
            data-loading-text="<%= t('createResource.submitLoading') %>"
          >
            <%= t('createResource.submit') %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
