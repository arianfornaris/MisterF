<div class="modal fade" tabindex="-1" aria-hidden="true" data-scene-media-pending-modal data-bs-backdrop="static" data-bs-keyboard="false" data-generic-error="<%= t('mediaLibrary.creationFailed') %>">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body py-5 px-4 text-center">
        <div data-scene-media-pending-loading>
          <div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden"><%= t('common.loading') %></span></div>
          <p class="mb-3 fw-semibold" data-scene-media-pending-message><%= t('mediaLibrary.progress.starting') %></p>
          <div class="progress" role="progressbar" aria-label="<%= t('mediaLibrary.generationPending') %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-scene-media-pending-progress>
            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%" data-scene-media-pending-bar></div>
          </div>
        </div>
        <div class="d-none" data-scene-media-pending-error>
          <div class="alert alert-danger mb-3" role="alert" data-scene-media-pending-error-message></div>
          <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-primary d-none" href="/credits" data-scene-media-pending-credit-link><%= t('credits.buyCredits') %></a>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.close') %></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
