<!doctype html>
<html lang="<%= htmlLang %>">
  <head>
    <%- include('document-head', { includeBootstrapIcons: true }) %>
  </head>
  <body
    data-authenticated="<%= isAuthenticated ? 'true' : 'false' %>"
    data-socket-auth-token="<%= socketAuthToken %>"
    data-auth-message="<%= authMessage %>"
    data-guest-initial-greeting="<%= guestInitialGreeting %>"
    data-initial-conversation-id="<%= initialConversationId || '' %>"
    data-chat-mode="<%= chatMode %>"
    data-current-view="<%= currentView %>"
    data-active-profile-model-tier="<%= activeProfileModelTier || 'regular' %>"
  >
    <main class="app-shell">
      <div class="chat-workspace has-toolbar">
          <div class="chat-toolbar" aria-label="<%= t('nav.chatControls') %>">
            <button
              class="btn btn-link chat-menu-button d-lg-none"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#conversationPanel"
              aria-controls="conversationPanel"
              title="<%= t('nav.conversations') %>"
              aria-label="<%= t('nav.conversations') %>"
            >
              <i class="bi bi-list fs-4" aria-hidden="true"></i>
            </button>

            <% if (hasSession) { %>
              <button
                class="btn btn-link translator-button d-lg-none"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#translatorModal"
                data-open-translator
                title="<%= t('nav.translator') %>"
                aria-label="<%= t('nav.translator') %>"
              >
                <i class="bi bi-translate fs-5" aria-hidden="true"></i>
              </button>
            <% } %>
          </div>

          <aside
            class="offcanvas-lg offcanvas-start conversation-panel"
            tabindex="-1"
            id="conversationPanel"
            aria-label="<%= t('nav.sidePanel') %>"
          >
            <div class="offcanvas-header">
              <a
                class="panel-home-link d-lg-none"
                href="/"
                title="<%= t('nav.goHome') %>"
                aria-label="<%= t('nav.goHome') %>"
              >
                <img
                  class="panel-home-logo"
                  src="/public/brand/panel-brand-64.png"
                  alt="Mister F"
                  width="24"
                  height="24"
                >
              </a>
              <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" aria-label="<%= t('common.close') %>"></button>
            </div>
            <div class="offcanvas-body">
              <div class="panel-nav">
                <a class="panel-nav-link d-none d-lg-inline-flex" href="/">
                  <img
                    class="panel-nav-brand-logo"
                    src="/public/brand/panel-brand-64.png"
                    alt=""
                    width="20"
                    height="20"
                    aria-hidden="true"
                  >
                  Mr. F
                </a>
              </div>

              <% if (hasSession) { %>
                <div class="panel-nav">
                  <a class="panel-nav-link" href="/" data-new-conversation>
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                    <%= t('nav.newConversation') %>
                  </a>

                  <a class="panel-nav-link <%= currentView === 'resources' ? 'is-active' : '' %>" href="/resources">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i>
                    <%= t('nav.resources') %>
                  </a>

                  <a class="panel-nav-link <%= currentView === 'progress' ? 'is-active' : '' %>" href="/progress">
                    <i class="bi bi-graph-up" aria-hidden="true"></i>
                    <%= t('nav.progress') %>
                  </a>

                  <button
                    class="panel-nav-link d-none d-lg-inline-flex"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#translatorModal"
                    data-open-translator
                  >
                    <i class="bi bi-translate" aria-hidden="true"></i>
                    <%= t('nav.translator') %>
                  </button>
                </div>

                <div class="panel-recents">
                  <p class="panel-section-label"><%= t('nav.recent') %></p>

                  <% if (conversations.length > 0) { %>
                    <div class="conversation-list">
                      <% conversations.forEach((conversation) => { %>
                        <div
                          class="conversation-item"
                          data-conversation-id="<%= conversation.id %>"
                        >
                          <a
                            class="panel-nav-link conversation-open-button"
                            href="/c/<%= encodeURIComponent(conversation.id) %><%= conversation.closedAt ? '?tab=summary' : '' %>"
                            data-open-conversation
                          >
                            <i class="bi <%= conversation.closedAt ? 'bi-check-circle' : 'bi-chat-dots' %> conversation-open-icon" aria-hidden="true"></i>
                            <span class="conversation-open-copy">
                              <span class="conversation-title"><%= conversation.title %></span>
                              <time class="conversation-date" datetime="<%= conversation.updatedAt %>" title="<%= conversation.updatedAt %>">
                                <%= conversation.relativeUpdatedAt || conversation.updatedAt %>
                              </time>
                            </span>
                          </a>

                          <div class="conversation-actions dropdown">
                            <button
                              class="conversation-actions-button"
                              type="button"
                              data-bs-toggle="dropdown"
                              aria-expanded="false"
                              title="<%= t('nav.conversationOptions') %>"
                              aria-label="<%= t('nav.conversationOptions') %>"
                            >
                              <i class="bi bi-three-dots" aria-hidden="true"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end">
                              <button class="dropdown-item" type="button" data-rename-conversation><%= t('nav.rename') %></button>
                              <% if (!conversation.closedAt) { %>
                                <button class="dropdown-item" type="button" data-finalize-conversation><%= t('nav.finalizeAndSummarize') %></button>
                              <% } %>
                              <button class="dropdown-item text-danger" type="button" data-delete-conversation><%= t('common.delete') %></button>
                            </div>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p class="conversation-empty"><%= t('nav.noConversations') %></p>
                  <% } %>
                </div>
              <% } else { %>
                <div class="panel-recents d-flex flex-column justify-content-center">
                  <div>
                    <h2 class="h6 mb-2"><%= t('nav.signedOutTitle') %></h2>
                    <p class="mb-0 text-body-secondary">
                      <%= t('nav.signedOutBody') %>
                    </p>
                  </div>
                </div>
              <% } %>

              <div class="panel-bottom">
                <% if (hasSession) { %>
                  <div class="user-menu dropdown">
                    <button
                      class="btn btn-link panel-nav-link user-panel-button"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      title="<%= activeProfile ? activeProfile.name : t('nav.profile') %>"
                      aria-label="<%= activeProfile ? activeProfile.name : t('nav.profile') %>"
                    >
                      <i class="bi bi-person-circle" aria-hidden="true"></i>
                      <%= activeProfile ? activeProfile.name : t('nav.profile') %>
                    </button>

                    <div class="dropdown-menu user-menu-panel">
                      <% if (activeProfile) { %>
                        <p class="user-menu-email"><strong><%= activeProfile.name %></strong></p>
                      <% } %>
                      <p class="user-menu-email"><%= user.email %></p>
                      <a class="dropdown-item" href="/profiles"><%= t('nav.switchProfile') %></a>
                      <a class="dropdown-item" href="/settings"><%= t('nav.accountSettings') %></a>
                      <a class="dropdown-item" href="/credits"><%= t('nav.credits') %></a>
                      <form method="post" action="/logout">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="dropdown-item" type="submit"><%= t('nav.signOut') %></button>
                      </form>
                    </div>
                  </div>
                <% } else { %>
                  <div class="d-grid gap-2">
                    <a class="btn btn-primary" href="/login"><%= t('nav.signIn') %></a>
                    <a class="btn btn-secondary" href="/signup"><%= t('nav.createAccount') %></a>
                    <div class="d-flex justify-content-center pt-1">
                      <%- include('language-switcher', { languageSwitcherPath: currentPath }) %>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </aside>

          <div
            class="modal fade"
            id="deleteConversationModal"
            tabindex="-1"
            aria-labelledby="deleteConversationModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content delete-conversation-modal">
                <div class="modal-header">
                  <h2 class="modal-title fs-5" id="deleteConversationModalLabel"><%= t('deleteConversation.title') %></h2>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
                </div>
                <div class="modal-body">
                  <p class="mb-0">
                    <%= t('deleteConversation.bodyBefore') %><span data-delete-conversation-title></span><%= t('deleteConversation.bodyAfter') %>
                  </p>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                  <button type="button" class="btn btn-danger" data-confirm-delete-conversation><%= t('common.delete') %></button>
                </div>
              </div>
            </div>
          </div>

          <div
            class="modal fade"
            id="closeTutorPlanModal"
            tabindex="-1"
            aria-labelledby="closeTutorPlanModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h2 class="modal-title fs-5" id="closeTutorPlanModalLabel"><%= t('closeTutorPlan.title') %></h2>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
                </div>
                <div class="modal-body">
                  <p>
                    <%= t('closeTutorPlan.body1') %>
                  </p>
                  <p class="mb-0 text-body-secondary">
                    <%= t('closeTutorPlan.body2') %>
                  </p>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                  <button type="button" class="btn btn-primary" data-confirm-close-tutor-plan><%= t('closeTutorPlan.title') %></button>
                </div>
              </div>
            </div>
          </div>

          <div
            class="modal fade"
            id="createResourceFromConversationModal"
            tabindex="-1"
            aria-labelledby="createResourceFromConversationModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <form method="post" data-create-resource-from-conversation-form>
                  <div class="modal-header">
                    <h2 class="modal-title fs-5" id="createResourceFromConversationModalLabel">
                      <%= t('createResource.titlePrefix') %> <span data-create-resource-from-conversation-label><%= t('createResource.genericLabel') %></span>
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
                  </div>
                  <div class="modal-body">
                    <p>
                      <%= t('createResource.body') %>
                    </p>
                    <label class="form-label" for="createResourceFromConversationPrompt">
                      <%= t('createResource.promptLabel') %>
                    </label>
                    <textarea
                      class="form-control"
                      id="createResourceFromConversationPrompt"
                      name="prompt"
                      rows="3"
                      maxlength="2000"
                      placeholder="<%= t('createResource.promptPlaceholder') %>"
                    ></textarea>
                  </div>
                  <div class="modal-footer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="type" value="" data-create-resource-from-conversation-type>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                    <button
                      type="submit"
                      class="btn btn-primary"
                      data-create-resource-from-conversation-submit
                      data-loading-text="<%= t('createResource.submitLoading') %>"
                    >
                      <%= t('createResource.submit') %>
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <div
            class="modal fade"
            id="finalizeConversationModal"
            tabindex="-1"
            aria-labelledby="finalizeConversationModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <form method="post" data-finalize-conversation-form>
                  <div class="modal-header">
                    <h2 class="modal-title fs-5" id="finalizeConversationModalLabel"><%= t('finalizeConversation.title') %></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
                  </div>
                  <div class="modal-body">
                    <p>
                      <%= t('finalizeConversation.body1') %>
                    </p>
                    <p class="mb-0 text-body-secondary">
                      <%= t('finalizeConversation.body2') %>
                    </p>
                  </div>
                  <div class="modal-footer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                    <button
                      type="submit"
                      class="btn btn-primary"
                      data-finalize-conversation-submit
                      data-loading-text="<%= t('finalizeConversation.submitLoading') %>"
                    >
                      <%= t('finalizeConversation.submit') %>
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <div
            class="modal fade"
            id="tutorReportPendingModal"
            tabindex="-1"
            aria-labelledby="tutorReportPendingModalLabel"
            aria-hidden="true"
            data-tutor-report-pending-modal
            data-bs-backdrop="static"
            data-bs-keyboard="false"
          >
            <div class="modal-dialog modal-dialog-centered modal-sm">
              <div class="modal-content">
                <div class="modal-body text-center py-4 d-grid gap-3">
                  <div
                    class="spinner-border text-primary mx-auto"
                    role="status"
                    aria-hidden="true"
                  ></div>
                  <div>
                    <h2 class="fs-6 mb-1" id="tutorReportPendingModalLabel" data-tutor-report-pending-title>
                      <%= t('tutorReportPending.title') %>
                    </h2>
                    <p class="mb-0 text-body-secondary small">
                      <%= t('tutorReportPending.body') %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div
            class="modal fade"
            id="translatorModal"
            tabindex="-1"
            aria-labelledby="translatorModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content translator-modal">
                <form id="translatorForm" autocomplete="off">
                  <div class="modal-header">
                    <h2 class="modal-title fs-5" id="translatorModalLabel"><%= t('translator.title') %></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
                  </div>
                  <div class="modal-body">
                    <div class="translator-mode btn-group" role="group" aria-label="<%= t('translator.mode') %>">
                      <input class="btn-check" type="radio" name="translatorMode" id="translatorModeAuto" value="auto" checked>
                      <label class="btn btn-outline-secondary" for="translatorModeAuto"><%= t('translator.auto') %></label>

                      <input class="btn-check" type="radio" name="translatorMode" id="translatorModeEsEn" value="es-en">
                      <label class="btn btn-outline-secondary" for="translatorModeEsEn"><%= t('translator.esEn') %></label>

                      <input class="btn-check" type="radio" name="translatorMode" id="translatorModeEnEs" value="en-es">
                      <label class="btn btn-outline-secondary" for="translatorModeEnEs"><%= t('translator.enEs') %></label>
                    </div>

                    <label class="visually-hidden" for="translatorInput"><%= t('translator.inputLabel') %></label>
                    <div class="translator-box">
                      <textarea
                        class="form-control translator-textarea"
                        id="translatorInput"
                        rows="5"
                        maxlength="2000"
                        autocomplete="off"
                        autocapitalize="none"
                        autocorrect="off"
                        spellcheck="false"
                      ></textarea>
                      <button
                        class="translator-copy-button"
                        type="button"
                        data-translator-copy="input"
                        title="<%= t('translator.copyText') %>"
                        aria-label="<%= t('translator.copyText') %>"
                      >
                        <i class="bi bi-copy" aria-hidden="true"></i>
                      </button>
                    </div>

                    <div class="translator-box translator-result-box">
                      <div class="translator-result" id="translatorResult" aria-live="polite"></div>
                      <button
                        class="translator-copy-button"
                        type="button"
                        data-translator-copy="result"
                        title="<%= t('translator.copyTranslation') %>"
                        aria-label="<%= t('translator.copyTranslation') %>"
                      >
                        <i class="bi bi-copy" aria-hidden="true"></i>
                      </button>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.close') %></button>
                    <button type="submit" class="btn btn-primary" data-translator-submit><%= t('translator.submit') %></button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <div
            class="modal fade"
            id="creditModal"
            tabindex="-1"
            aria-labelledby="creditModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content credit-modal">
                <div class="modal-header">
                  <h2 class="modal-title fs-5" id="creditModalLabel"><%= t('credit.title') %></h2>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
                </div>
                <div class="modal-body">
                  <p class="mb-0" data-credit-message>
                    <%= t('credit.body') %>
                  </p>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.close') %></button>
                  <a class="btn btn-primary" href="/credits" data-credit-buy-link><%= t('credit.buy') %></a>
                </div>
              </div>
            </div>
          </div>

          <div
            class="modal fade"
            id="practiceGuideHelpModal"
            tabindex="-1"
            aria-labelledby="practiceGuideHelpModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered modal-lg">
              <div class="modal-content translator-modal">
                <div class="modal-header">
                  <h2 class="modal-title fs-5" id="practiceGuideHelpModalLabel"><%= t('practiceGuideHelp.title') %></h2>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
                </div>
                <div class="modal-body practice-guide-help-modal-body">
                  <section class="practice-guide-help-section">
                    <h3><%= t('practiceGuideHelp.typesTitle') %></h3>
                    <ul>
                      <li><%= t('practiceGuideHelp.type1') %></li>
                      <li><%= t('practiceGuideHelp.type2') %></li>
                      <li><%= t('practiceGuideHelp.type3') %></li>
                      <li><%= t('practiceGuideHelp.type4') %></li>
                      <li><%= t('practiceGuideHelp.type5') %></li>
                      <li><%= t('practiceGuideHelp.type6') %></li>
                      <li><%= t('practiceGuideHelp.type7') %></li>
                    </ul>
                  </section>

                  <section class="practice-guide-help-section">
                    <h3><%= t('practiceGuideHelp.examplesTitle') %></h3>
                    <ul>
                      <li><%= t('practiceGuideHelp.example1') %></li>
                      <li><%= t('practiceGuideHelp.example2') %></li>
                      <li><%= t('practiceGuideHelp.example3') %></li>
                      <li><%= t('practiceGuideHelp.example4') %></li>
                    </ul>
                  </section>

                  <section class="practice-guide-help-section">
                    <h3><%= t('practiceGuideHelp.goodPracticesTitle') %></h3>
                    <ul>
                      <li><%= t('practiceGuideHelp.goodPractice1') %></li>
                      <li><%= t('practiceGuideHelp.goodPractice2') %></li>
                      <li><%= t('practiceGuideHelp.goodPractice3') %></li>
                      <li><%= t('practiceGuideHelp.goodPractice4') %></li>
                    </ul>
                  </section>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.understood') %></button>
                </div>
              </div>
            </div>
          </div>
