<%#
  The learning composition of the signed-in home (Roadmap V3 §1.14): a compact
  panel above the composer, rendered only on the empty chat state so the
  conversation stays the center of the page. Deterministic queries only — no
  suggestion engine and no inference.
%>
<section class="home-learning-panel card mx-auto mb-4" data-learning-home-panel>
  <div class="card-body">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
      <h2 class="h6 mb-0">
        <i class="bi bi-inbox me-2" aria-hidden="true"></i><%= t('home.learnTitle') %>
        <% if (learningHome.pendingCount > 0) { %>
          <span class="badge text-bg-primary ms-1"><%= learningHome.pendingCount %></span>
        <% } %>
      </h2>
      <%- include('home-mode-switch') %>
    </div>

    <% if (learningHome.sharedWithMe.length > 0) { %>
      <div class="list-group list-group-flush mb-3">
        <% learningHome.sharedWithMe.forEach((activity) => { %>
          <a class="list-group-item list-group-item-action px-0 d-flex align-items-start justify-content-between gap-3" href="<%= activity.detailPath %>">
            <span class="min-w-0">
              <span class="d-block text-truncate">
                <i class="bi <%= activity.iconClass %> me-2" aria-hidden="true"></i><%= activity.title %>
              </span>
              <span class="d-block small text-body-secondary">
                <%= t(activity.labelKey) %>
                <span class="mx-1" aria-hidden="true">·</span>
                <%= t('home.sharedWithYou', { time: activity.sharedRelative }) %>
              </span>
            </span>
            <% if (!activity.hasStarted) { %>
              <span class="badge text-bg-primary flex-shrink-0"><%= t('home.pending') %></span>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="small text-body-secondary"><%= t('home.learnEmpty') %></p>
    <% } %>

    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-sm btn-secondary" href="/progress">
        <i class="bi bi-graph-up me-1" aria-hidden="true"></i><%= t('home.viewProgress') %>
      </a>
      <a class="btn btn-sm btn-secondary" href="/resources">
        <i class="bi bi-folder2-open me-1" aria-hidden="true"></i><%= t('home.viewResources') %>
      </a>
    </div>
  </div>
</section>
