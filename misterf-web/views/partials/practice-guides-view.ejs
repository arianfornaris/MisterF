        <%
          const practiceGuideCurrentFolder = resourceCurrentFolder || null;
          const practiceGuideFolderOptions = Array.isArray(resourceFolderOptions) ? resourceFolderOptions : [];
          const practiceGuideFolderPath = Array.isArray(resourceFolderPath) ? resourceFolderPath : [];
          const showPracticeGuideMoveOption = practiceGuidePageMode === 'detail'
            && selectedPracticeGuide
            && canManagePracticeGuide
            && !selectedPracticeGuide.archivedAt
            && (practiceGuideCurrentFolder || practiceGuideFolderOptions.length > 0);
        %>
        <section
          class="app-page practice-guides-page"
          aria-label="<%= t('practiceGuides.kicker') %>"
        >
          <div class="app-page-header app-page-header-detail">
            <div>
              <%- include('resource-page-kicker', { resourceType: 'practice_guide' }) %>
              <h1 class="app-page-title">
                <%= selectedPracticeGuide ? selectedPracticeGuide.title : t('practiceGuides.defaultTitle') %>
              </h1>
              <% if (selectedPracticeGuide) { %>
                <%- include('breadcrumb', { crumbs: [
                  { label: t('resources.title'), href: '/resources' },
                  ...practiceGuideFolderPath.map((folder) => ({
                    label: folder.title,
                    href: `/resources/folders/${encodeURIComponent(folder.id)}`,
                  })),
                  { label: selectedPracticeGuide.title },
                ] }) %>
              <% } %>
            </div>
          </div>

          <% if (practiceGuidePageMode === 'detail' && selectedPracticeGuide) { %>
            <section class="app-page-detail-shell">
              <div class="d-grid gap-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                  <form method="post" action="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/chats">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-primary" type="submit">
                      <i class="bi bi-play-fill me-1" aria-hidden="true"></i>
                      <%= t('quizzes.test') %>
                    </button>
                  </form>

                  <% if (canManagePracticeGuide) { %>
                  <div class="dropdown">
                    <button
                      class="btn btn-secondary dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                    >
                      <%= t('resources.options') %>
                    </button>
                    <ul class="dropdown-menu">
                      <% if (!selectedPracticeGuide.archivedAt) { %>
                        <% if (showPracticeGuideMoveOption) { %>
                          <li>
                            <button
                              class="dropdown-item"
                              type="button"
                              data-bs-toggle="modal"
                              data-bs-target="#moveResourceModal"
                              data-resource-move-open
                              data-resource-id="<%= selectedPracticeGuide.id %>"
                              data-resource-title="<%= selectedPracticeGuide.title %>"
                              data-resource-type="practice_guide"
                              data-current-folder-id="<%= practiceGuideCurrentFolder ? practiceGuideCurrentFolder.id : '' %>"
                            >
                              <i class="bi bi-folder-symlink me-2" aria-hidden="true"></i>
                              <%= t('resources.moveToFolder') %>
                            </button>
                          </li>
                        <% } %>
                        <li>
                          <form method="post" action="/resources/<%= encodeURIComponent(selectedPracticeGuide.id) %>/duplicate">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="dropdown-item" type="submit">
                              <i class="bi bi-copy me-2" aria-hidden="true"></i><%= t('resources.duplicate') %>
                            </button>
                          </form>
                        </li>
                        <li>
                          <button
                            class="dropdown-item"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#sharePracticeGuideProfileModal"
                          >
                            <i class="bi bi-person me-2" aria-hidden="true"></i>
                            <%= t('resources.shareWithProfile') %>
                          </button>
                        </li>
                        <li>
                          <button
                            class="dropdown-item"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#sharePracticeGuideLinkModal"
                          >
                            <i class="bi bi-share me-2" aria-hidden="true"></i>
                            <%= t('resources.share') %>
                          </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <a
                            class="dropdown-item"
                            href="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit"
                          >
                            <i class="bi bi-pencil me-2" aria-hidden="true"></i>
                            <%= t('practiceGuides.editGuide') %>
                          </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                      <% } %>
                      <li>
                        <form
                          method="post"
                          action="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/<%= selectedPracticeGuide.archivedAt ? 'restore' : 'archive' %>"
                          onsubmit="return window.confirm('<%= selectedPracticeGuide.archivedAt ? t('practiceGuides.confirmRestore') : t('practiceGuides.confirmArchive') %>');"
                        >
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="returnTo" value="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>">
                          <button class="dropdown-item" type="submit">
                            <i class="bi <%= selectedPracticeGuide.archivedAt ? 'bi-arrow-counterclockwise' : 'bi-archive' %> me-2" aria-hidden="true"></i>
                            <%= selectedPracticeGuide.archivedAt ? t('practiceGuides.restoreGuide') : t('practiceGuides.archiveGuide') %>
                          </button>
                        </form>
                      </li>
                    </ul>
                  </div>
                  <% } %>
                </div>

                <% if (selectedPracticeGuide.sharedVia || !canManagePracticeGuide) { %>
                  <div class="d-flex">
                    <% if (selectedPracticeGuideSharedFromProfileName) { %>
                      <span class="badge text-bg-light border practice-guide-shared-badge" role="status">
                        <%= t('practiceGuides.sharedBy', { name: selectedPracticeGuideSharedFromProfileName }) %>
                      </span>
                    <% } else { %>
                      <span class="badge text-bg-light border practice-guide-shared-badge" role="status">
                        <%= selectedPracticeGuide.sharedVia === 'link' ? t('practiceGuides.sharedByLink') : t('practiceGuides.sharedFromProfile') %>
                      </span>
                    <% } %>
                  </div>
                <% } %>

                <% if (canManagePracticeGuide) { %>
                  <div class="card">
                    <div class="card-body">
                      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <h2 class="h5 mb-0"><%= t('quizzes.participantsSectionTitle') %></h2>
                        <a class="btn btn-outline-secondary btn-sm" href="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/participation">
                          <i class="bi bi-people me-1" aria-hidden="true"></i><%= t('quizzes.participationLink') %>
                        </a>
                      </div>
                      <% if (collectedReportCount === 0) { %>
                        <p class="text-body-secondary mb-0"><%= t('quizzes.participantsEmpty') %></p>
                      <% } else { %>
                        <div class="resource-meta-row">
                          <span><i class="bi bi-check-circle" aria-hidden="true"></i> <%= t('resources.participantsCompletedCount', { count: collectedReportCount }) %></span>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% } %>

                <p class="app-page-section-copy"><%= t('resources.description') %></p>
                <div class="card">
                  <div class="card-body">
                    <div class="resource-markdown" data-render-markdown><%= selectedPracticeGuide.description %></div>
                  </div>
                </div>

                <p class="app-page-section-copy"><%= t('practiceGuides.tutorInstructions') %></p>
                <div class="card">
                  <div class="card-body">
                    <div class="resource-markdown" data-render-markdown><%= selectedPracticeGuide.tutorInstructions %></div>
                  </div>
                </div>

                <%# Mirrors the quiz and roleplay detail pages: the owner's own
                    chats here are their test runs, and they already have the
                    Participantes card for other people's sessions, so this list
                    only serves a non-owner recipient resuming their own chat. %>
                <% if (!canManagePracticeGuide) { %>
                  <p class="app-page-section-copy"><%= t('practiceGuides.chatsOfGuide') %></p>
                  <% if (practiceGuideConversations.length > 0) { %>
                    <div class="practice-guide-chat-list list-group">
                      <% practiceGuideConversations.forEach((conversation) => { %>
                        <a
                          class="practice-guide-chat-item list-group-item list-group-item-action d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-1"
                          href="/c/<%= encodeURIComponent(conversation.id) %>"
                        >
                          <span class="practice-guide-chat-title"><%= conversation.title %></span>
                          <time class="practice-guide-chat-date" datetime="<%= conversation.updatedAt %>">
                            <%= conversation.updatedAt %>
                          </time>
                        </a>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p class="text-body-secondary mb-0"><%= t('practiceGuides.noChats') %></p>
                  <% } %>
                <% } %>
              </div>
            </section>
          <% } %>
        </section>

        <% if (practiceGuidePageMode === 'detail' && selectedPracticeGuide && canManagePracticeGuide) { %>
          <div
            class="modal fade"
            id="sharePracticeGuideProfileModal"
            tabindex="-1"
            aria-labelledby="sharePracticeGuideProfileModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h2 class="modal-title fs-5" id="sharePracticeGuideProfileModalLabel"><%= t('resources.shareWithProfile') %></h2>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
                </div>
                <div class="modal-body">
                  <% if (shareTargetPracticeGuideProfiles.length > 0) { %>
                    <form method="post" action="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/share/profile" class="d-grid gap-3">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div>
                        <label class="form-label" for="shareTargetProfileId"><%= t('resources.targetProfile') %></label>
                        <select class="form-select" id="shareTargetProfileId" name="targetProfileId" required>
                          <% shareTargetPracticeGuideProfiles.forEach((profile) => { %>
                            <option value="<%= profile.id %>"><%= profile.name %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div>
                        <div class="form-check form-switch mb-1">
                          <input
                            class="form-check-input"
                            type="checkbox"
                            role="switch"
                            id="practiceGuideShareProfileCollectResults"
                            name="collectResults"
                            checked
                          >
                          <label class="form-check-label" for="practiceGuideShareProfileCollectResults">
                            <%= t('resources.shareCollectResultsLabel') %>
                          </label>
                        </div>
                        <p class="form-text mb-0"><%= t('resources.shareCollectResultsProfileHint') %></p>
                      </div>
                      <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                        <button type="submit" class="btn btn-primary"><%= t('resources.shareNow') %></button>
                      </div>
                    </form>
                  <% } else { %>
                    <p class="mb-0 text-body-secondary"><%= t('practiceGuides.noOtherProfiles') %></p>
                  <% } %>
                </div>
                <% if (shareTargetPracticeGuideProfiles.length === 0) { %>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <div
            class="modal fade"
            id="sharePracticeGuideLinkModal"
            tabindex="-1"
            aria-labelledby="sharePracticeGuideLinkModalLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h2 class="modal-title fs-5" id="sharePracticeGuideLinkModalLabel"><%= t('resources.shareLinkTitle') %></h2>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
                </div>
                <div class="modal-body d-grid gap-3">
                  <p class="mb-0 text-body-secondary">
                    <%= t('practiceGuides.shareLinkBody') %>
                  </p>
                  <div>
                    <form
                      method="post"
                      action="/resources/<%= encodeURIComponent(selectedPracticeGuide.id) %>/share/collect-results"
                      class="form-check form-switch mb-1"
                    >
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="returnTo" value="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        role="switch"
                        id="practiceGuideShareCollectResults"
                        name="collectResults"
                        <%= selectedPracticeGuideShareLink && selectedPracticeGuideShareLink.collectResults ? 'checked' : '' %>
                        onchange="this.form.requestSubmit()"
                      >
                      <label class="form-check-label" for="practiceGuideShareCollectResults">
                        <%= t('resources.shareCollectResultsLabel') %>
                      </label>
                    </form>
                    <p class="form-text mb-0"><%= t('resources.shareCollectResultsHint') %></p>
                  </div>
                  <div>
                    <label class="form-label" for="practiceGuideShareLinkField"><%= t('resources.link') %></label>
                    <input
                      class="form-control"
                      id="practiceGuideShareLinkField"
                      type="text"
                      readonly
                      value="<%= practiceGuideShareUrl %>"
                      data-practiceGuide-share-link-field
                    >
                  </div>
                  <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-secondary" type="button" data-copy-practiceGuide-share-link>
                      <i class="bi bi-copy me-1" aria-hidden="true"></i>
                      <%= t('resources.copy') %>
                    </button>
                    <button class="btn btn-outline-secondary" type="button" data-native-share-practiceGuide-link>
                      <i class="bi bi-share me-1" aria-hidden="true"></i>
                      <%= t('resources.share') %>
                    </button>
                  </div>
                  <% if (practiceGuideShareQrDataUrl) { %>
                    <div class="d-flex justify-content-center">
                      <img
                        src="<%= practiceGuideShareQrDataUrl %>"
                        alt="<%= t('practiceGuides.qrAlt') %>"
                        width="180"
                        height="180"
                      >
                    </div>
                  <% } %>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
                </div>
              </div>
            </div>
          </div>

          <%- include('resource-move-modal', {
            resourceMoveCurrentFolder: practiceGuideCurrentFolder,
            resourceMoveFolderOptions: practiceGuideFolderOptions,
          }) %>
        <% } %>
