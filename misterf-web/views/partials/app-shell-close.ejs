        </div>
      </main>

    <%# The legal footer lives at the bottom of the side panel
        (`app-shell-open.ejs`): the shell fills the window, and a footer after
        it would make the whole document scroll. %>

    <script>
      window.__APP_LOCALE__ = "<%= locale %>";
      window.__APP_I18N__ = <%- clientI18nJson %>;
      window.__TRANSLATOR_LANGUAGES__ = <%- translatorLanguagesJson %>;
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/vendor/dompurify/purify.min.js"></script>
    <script src="/vendor/marked/marked.umd.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <%- include('translator-client-script') %>
    <% if (typeof pageScriptPartial === 'string' && pageScriptPartial) { %>
      <%- include(pageScriptPartial) %>
    <% } %>
  </body>
</html>
