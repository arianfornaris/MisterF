        </div>
      </main>

    <%# Always the last thing on the page, centered (founder direction
        2026-09-12). `.app-body` is a column exactly as tall as the window, so
        the shell takes the height left above this footer and the document
        never scrolls — the panel and the content scroll inside themselves. %>
    <%- include('legal-footer') %>

    <script>
      window.__APP_LOCALE__ = "<%= locale %>";
      window.__APP_I18N__ = <%- clientI18nJson %>;
      window.__TRANSLATOR_LANGUAGES__ = <%- translatorLanguagesJson %>;
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/vendor/dompurify/purify.min.js"></script>
    <script src="/vendor/marked/marked.umd.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <%- include('translator-client-script') %>
    <% if (typeof pageScriptPartial === 'string' && pageScriptPartial) { %>
      <%- include(pageScriptPartial) %>
    <% } %>
  </body>
</html>
