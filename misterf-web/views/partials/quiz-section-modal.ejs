<%
  // Params: modalId, modalTitle, formAction, submitLabel, section (or null), draft, csrfToken.
  const sectionOrNull = typeof section !== 'undefined' ? section : null;
  const fieldIdPrefix = modalId;
%>
<div class="modal fade" id="<%= modalId %>" tabindex="-1" aria-labelledby="<%= modalId %>Label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <form class="modal-content" method="post" action="<%= formAction %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="<%= modalId %>Label"><%= modalTitle %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label" for="<%= fieldIdPrefix %>Title">Título (opcional)</label>
          <input
            class="form-control"
            id="<%= fieldIdPrefix %>Title"
            name="title"
            maxlength="200"
            value="<%= sectionOrNull ? (sectionOrNull.title || '') : '' %>"
          >
        </div>
        <div class="mb-3">
          <label class="form-label" for="<%= fieldIdPrefix %>Instructions">Instrucciones para el estudiante</label>
          <textarea
            class="form-control"
            id="<%= fieldIdPrefix %>Instructions"
            name="instructions"
            rows="4"
            maxlength="2000"
            required
          ><%= sectionOrNull ? sectionOrNull.instructions : '' %></textarea>
          <div class="form-text">Se muestran como enunciado de la sección antes de sus bloques.</div>
        </div>
        <p class="form-label mb-2">Bloques de esta sección</p>
        <div class="quiz-section-block-checklist">
          <% draft.blocks.forEach((block, blockIndex) => { %>
            <label class="form-check quiz-section-block-check">
              <input
                class="form-check-input"
                type="checkbox"
                name="blockIds"
                value="<%= block.id %>"
                <%= sectionOrNull && block.sectionId === sectionOrNull.id ? 'checked' : '' %>
              >
              <span class="form-check-label">
                <span class="text-body-secondary"><%= blockIndex + 1 %>.</span>
                <%= block.item.prompt.length > 90 ? `${block.item.prompt.slice(0, 90)}…` : block.item.prompt %>
              </span>
            </label>
          <% }) %>
        </div>
        <div class="form-text">Un bloque solo puede pertenecer a una sección; si marcas uno que ya está en otra sección, se moverá a esta.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" type="submit"><%= submitLabel %></button>
      </div>
    </form>
  </div>
</div>
