        <% const isTutorConversationClosed = Boolean(selectedTutorConversation && selectedTutorConversation.closedAt); %>
        <% const activeTutorConversationTab = selectedTutorConversationTab === 'summary' ? 'summary' : 'conversation'; %>
        <section class="chat-layout <%= currentView === 'chat' ? '' : 'd-none' %> <%= isTutorConversationClosed ? 'is-closed-conversation' : '' %>" aria-label="<%= t('chat.ariaLabel') %>">
          <% if (isTutorConversationClosed) { %>
            <div class="bg-body px-3 pt-3">
              <p class="mb-3 small text-body-secondary">
                <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                <%= t('chat.closedNotice') %>
              </p>
              <ul class="nav nav-pills" role="tablist">
                <li class="nav-item" role="presentation">
                  <a
                    class="nav-link <%= activeTutorConversationTab === 'conversation' ? 'active' : '' %>"
                    href="/c/<%= encodeURIComponent(selectedTutorConversation.id) %>?tab=conversation"
                  >
                    <%= t('chat.tabConversation') %>
                  </a>
                </li>
                <li class="nav-item" role="presentation">
                  <a
                    class="nav-link <%= activeTutorConversationTab === 'summary' ? 'active' : '' %>"
                    href="/c/<%= encodeURIComponent(selectedTutorConversation.id) %>?tab=summary"
                  >
                    <%= t('chat.tabSummary') %>
                  </a>
                </li>
              </ul>
            </div>
          <% } %>
          <div
            class="messages"
            id="chatPane"
            tabindex="0"
          >
            <% if (isTutorConversationClosed && activeTutorConversationTab === 'summary') { %>
              <div id="messages" class="d-none" aria-live="polite"></div>
              <article class="conversation-summary-view mx-auto py-4 px-3 px-md-4">
                <% if (selectedTutorConversationReport) { %>
                  <% const report = selectedTutorConversationReport.report; %>
                  <header class="conversation-summary-header border-bottom pb-3 mb-4">
                    <p class="text-body-secondary small text-uppercase fw-semibold mb-2"><%= t('chat.summaryKicker') %></p>
                    <h1 class="h3 mb-3"><%= selectedTutorConversationReport.summaryTitle %></h1>
                    <p class="lead mb-0"><%= selectedTutorConversationReport.summaryDescription %></p>
                  </header>

                  <div class="conversation-summary-actions d-flex flex-wrap gap-2 mb-4">
                    <form
                      method="post"
                      action="/c/<%= encodeURIComponent(selectedTutorConversation.id) %>/report/practice"
                      data-tutor-report-pending-form
                      data-tutor-report-pending-label="<%= t('chat.preparingPractice') %>"
                    >
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-primary" type="submit" data-tutor-report-pending-button><%= t('chat.practiceThese') %></button>
                    </form>
                    <div class="dropdown">
                      <button
                        class="btn btn-secondary dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                      >
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i><%= t('chat.createResource') %>
                      </button>
                      <ul class="dropdown-menu">
                        <% ['quiz', 'practice_guide', 'roleplay'].forEach((resourceType) => { %>
                          <li>
                            <button
                              class="dropdown-item"
                              type="button"
                              data-create-resource-from-conversation
                              data-resource-type="<%= resourceType %>"
                              data-resource-action="/c/<%= encodeURIComponent(selectedTutorConversation.id) %>/report/resource"
                            >
                              <i class="bi <%= resourceType === 'quiz' ? 'bi-ui-checks-grid' : resourceType === 'practice_guide' ? 'bi-journal-plus' : 'bi-person-video3' %> me-2" aria-hidden="true"></i>
                              <%= resourceType === 'quiz' ? t('chat.resourceTypeQuiz') : resourceType === 'practice_guide' ? t('chat.resourceTypePracticeGuide') : t('chat.resourceTypeRoleplay') %>
                            </button>
                          </li>
                        <% }) %>
                      </ul>
                    </div>
                  </div>

                  <%- include('tutor-report-document', { report }) %>
                <% } else { %>
                  <div class="alert alert-warning mb-0" role="alert">
                    <h1 class="h4"><%= t('chat.summaryUnavailableTitle') %></h1>
                    <p class="mb-0"><%= t('chat.summaryUnavailableBody') %></p>
                  </div>
                <% } %>
              </article>
            <% } else { %>
              <section class="practice-guide-start-panel d-none" data-practice-guide-start-panel>
                <p class="app-page-kicker"><%= t('chat.practiceGuideKicker') %></p>
                <h2 class="practice-guide-start-title" data-practiceGuide-start-title></h2>
                <p class="practice-guide-start-description" data-practiceGuide-start-description></p>
                <p class="practice-guide-start-status text-body-secondary d-none" data-practice-guide-start-status>
                  <%= t('chat.practiceGuideStarting') %>
                </p>
                <button class="btn btn-primary" type="button" data-practiceGuide-start-button>
                  <%= t('chat.practiceGuideStart') %>
                </button>
              </section>
              <div id="messages" aria-live="polite"></div>
            <% } %>
          </div>

          <% if (!isTutorConversationClosed) { %>
            <form id="chatForm" class="composer" autocomplete="off">
              <section
                class="tutor-plan-panel card d-none"
                data-tutor-plan-panel
                aria-live="polite"
              ></section>
              <label class="visually-hidden" for="messageInput"><%= t('chat.messagePlaceholder') %></label>
              <div class="composer-input-wrap">
                <textarea
                  id="messageInput"
                  class="composer-input"
                  rows="1"
                  maxlength="1200"
                  placeholder="<%= t('chat.messagePlaceholder') %>"
                  autocomplete="off"
                  autocapitalize="none"
                  autocorrect="off"
                  spellcheck="false"
                  autofocus
                ></textarea>
              </div>
              <div class="composer-footer">
                <% if (hasSession) { %>
                  <button
                    class="btn btn-secondary btn-sm"
                    type="button"
                    data-finalize-current-conversation
                    <%= initialConversationId ? '' : 'disabled' %>
                  >
                    <%= t('chat.finalize') %>
                  </button>
                  <div class="dropdown d-inline-block">
                    <button
                      class="btn btn-secondary btn-sm dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      data-create-resource-from-conversation-toggle
                      <%= initialConversationId ? '' : 'disabled' %>
                    >
                      <i class="bi bi-plus-lg me-1" aria-hidden="true"></i><%= t('chat.createResource') %>
                    </button>
                    <ul class="dropdown-menu">
                      <li>
                        <button class="dropdown-item" type="button" data-create-resource-from-conversation data-resource-type="quiz">
                          <i class="bi bi-ui-checks-grid me-2" aria-hidden="true"></i><%= t('chat.resourceTypeQuiz') %>
                        </button>
                      </li>
                      <li>
                        <button class="dropdown-item" type="button" data-create-resource-from-conversation data-resource-type="practice_guide">
                          <i class="bi bi-journal-plus me-2" aria-hidden="true"></i><%= t('chat.resourceTypePracticeGuide') %>
                        </button>
                      </li>
                      <li>
                        <button class="dropdown-item" type="button" data-create-resource-from-conversation data-resource-type="roleplay">
                          <i class="bi bi-person-video3 me-2" aria-hidden="true"></i><%= t('chat.resourceTypeRoleplay') %>
                        </button>
                      </li>
                    </ul>
                  </div>
                <% } %>
                <button
                  class="btn btn-primary send-button"
                  type="submit"
                  title="<%= t('chat.send') %>"
                  aria-label="<%= t('chat.send') %>"
                  data-send-button
                >
                  <i class="bi bi-send" aria-hidden="true"></i>
                </button>
              </div>
              <div
                class="composer-status small text-body-secondary d-none"
                data-tool-status
                aria-live="polite"
              ></div>
            </form>
          <% } else { %>
            <form id="chatForm" class="composer d-none" autocomplete="off">
              <textarea id="messageInput" class="composer-input" rows="1"></textarea>
              <button class="btn btn-primary send-button" type="submit" data-send-button></button>
              <div class="composer-status small text-body-secondary d-none" data-tool-status aria-live="polite"></div>
            </form>
          <% } %>
        </section>
