<%- include('partials/app-shell-open') %>

<section class="app-resource-view practice-guides-page">
  <div class="resource-page-header resource-page-header-has-close">
    <div>
      <p class="resource-eyebrow"><%= t('practiceGuides.kicker') %></p>
      <h1><%= t('practiceGuides.newTitle') %></h1>
    </div>
    <div class="resource-page-header-actions">
      <a
        class="resource-page-close-button"
        href="/resources"
        title="<%= t('common.close') %>"
        aria-label="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (generationError) { %>
    <div class="alert <%= generationCreditExhausted ? 'alert-warning' : 'alert-danger' %>" role="alert">
      <p class="mb-<%= generationCreditExhausted ? '2' : '0' %>"><%= generationError %></p>
      <% if (generationCreditExhausted) { %>
        <a class="btn btn-primary btn-sm" href="/credits?returnTo=<%= encodeURIComponent('/practice-guides/new') %>"><%= t('credit.buy') %></a>
      <% } %>
    </div>
  <% } %>

  <div class="card resource-form-card">
    <div class="card-body">
      <form method="post" action="/practice-guides/generate-draft" data-resource-generate-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label" for="practiceGuidePrompt"><%= t('practiceGuides.describeLabel') %></label>
          <textarea
            class="form-control"
            id="practiceGuidePrompt"
            name="prompt"
            rows="10"
            required
            placeholder="<%= t('practiceGuides.describePlaceholder') %>"
          ><%= generationPrompt || '' %></textarea>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-primary" type="submit" data-resource-generate-submit data-loading-text="<%= t('practiceGuides.creatingShort') %>">
            <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('practiceGuides.create') %>
          </button>
          <a class="btn btn-outline-secondary" href="/resources"><%= t('common.cancel') %></a>
        </div>
      </form>
    </div>
  </div>
</section>

<div
  class="modal fade"
  tabindex="-1"
  aria-hidden="true"
  data-resource-pending-modal
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body d-flex align-items-center gap-3">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <p class="mb-0"><%= t('practiceGuides.creating') %></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-shell-close', { pageScriptPartial: 'practice-guides-client-script' }) %>
