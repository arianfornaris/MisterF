<!doctype html>
<html lang="<%= htmlLang %>">
  <% const safeReturnTo = typeof returnTo === 'string' ? returnTo : '/'; %>
  <head>
    <%- include('partials/document-head', { includeBootstrapIcons: true }) %>
  </head>
  <body>
    <main class="container min-vh-100 d-flex align-items-center py-5">
      <section class="row justify-content-center w-100" aria-label="<%= title %>">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
          <form
            class="card shadow-sm"
            <%= mode === 'signup' ? 'data-signup-form' : '' %>
            method="post"
            action="<%= mode === 'login' ? '/login' : mode === 'signup' ? '/signup' : mode === 'forgot' ? '/forgot-password' : '/reset-password' %>"
            novalidate
          >
            <div class="card-body p-4 p-md-5">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="<%= safeReturnTo %>">

              <% if (mode === 'signup') { %>
                <%# Bot trap, checked in `src/server/auth/signupBotTrap.ts`: the
                    signed render time that lets the handler reject instant
                    submissions, and a decoy input only a script fills.

                    The decoy is moved off-screen rather than hidden, because a
                    script that skips hidden inputs would skip the trap too. Its
                    label is deliberately not an i18n key — it is never shown to
                    anyone, and translating it would put a fake field in front of
                    translators. `tabindex="-1"` is what keeps the focusable
                    input out of the `aria-hidden` subtree in practice. %>
                <input type="hidden" name="signupFormStamp" value="<%= signupFormStamp %>">

                <%# Filled by `src/client/signup/index.js`: the hash of the
                    stamp above, which only a browser running JavaScript can
                    produce, and a flag set by the first real touch or key
                    event. Both are recorded and not enforced until
                    SIGNUP_BROWSER_CHECK_MODE=enforce. %>
                <input type="hidden" name="signupBrowserAnswer" value="">
                <input type="hidden" name="signupInteraction" value="">

                <div class="signup-trap" aria-hidden="true">
                  <label for="<%= honeypotFieldName %>">Website</label>
                  <input
                    id="<%= honeypotFieldName %>"
                    name="<%= honeypotFieldName %>"
                    type="text"
                    tabindex="-1"
                    autocomplete="off"
                    value=""
                  >
                </div>
              <% } %>

              <div class="mb-4">
                <p class="text-uppercase text-body-secondary small fw-semibold mb-2">
                  <%= t('auth.kicker.' + mode) %>
                </p>
                <h1 class="h3 mb-2">
                  <%= t('auth.heading.' + mode) %>
                </h1>
                <p class="text-body-secondary mb-0">
                  <%= t('auth.intro.' + mode) %>
                </p>
              </div>

              <% if (error) { %>
                <div class="alert alert-danger" role="alert"><%= error %></div>
              <% } %>

              <% if (mode === 'login' || mode === 'signup') { %>
                <div class="d-grid gap-3 mb-4">
                  <a class="btn btn-light border text-body" href="/auth/google?returnTo=<%= encodeURIComponent(safeReturnTo) %>">
                    <i class="bi bi-google me-2" aria-hidden="true"></i>
                    <%= t('auth.googleContinue') %>
                  </a>
                  <div class="d-flex align-items-center gap-3 text-body-secondary small" aria-hidden="true">
                    <span class="border-top flex-grow-1"></span>
                    <span><%= t('auth.or') %></span>
                    <span class="border-top flex-grow-1"></span>
                  </div>
                </div>
              <% } %>

              <div class="d-grid gap-3">
                <% if (mode === 'signup') { %>
                  <div>
                    <label class="form-label" for="fullName"><%= t('auth.fullName') %></label>
                    <input
                      id="fullName"
                      class="form-control <%= fieldErrors.fullName ? 'is-invalid' : '' %>"
                      name="fullName"
                      type="text"
                      autocomplete="name"
                      value="<%= values.fullName %>"
                      required
                      autofocus
                    >
                    <% if (fieldErrors.fullName) { %>
                      <div class="invalid-feedback"><%= fieldErrors.fullName %></div>
                    <% } %>
                  </div>
                <% } %>

                <% if (mode !== 'reset') { %>
                  <div>
                    <label class="form-label" for="email"><%= t('auth.email') %></label>
                    <input
                      id="email"
                      class="form-control <%= fieldErrors.email ? 'is-invalid' : '' %>"
                      name="email"
                      type="email"
                      autocomplete="email"
                      value="<%= values.email %>"
                      required
                      <%= mode === 'login' || mode === 'forgot' ? 'autofocus' : '' %>
                    >
                    <% if (fieldErrors.email) { %>
                      <div class="invalid-feedback"><%= fieldErrors.email %></div>
                    <% } %>
                  </div>
                <% } %>

                <% if (mode === 'reset') { %>
                  <div>
                    <label class="form-label" for="email"><%= t('auth.email') %></label>
                    <input
                      id="email"
                      class="form-control <%= fieldErrors.email ? 'is-invalid' : '' %>"
                      name="email"
                      type="email"
                      autocomplete="email"
                      value="<%= values.email %>"
                      required
                      autofocus
                    >
                    <% if (fieldErrors.email) { %>
                      <div class="invalid-feedback"><%= fieldErrors.email %></div>
                    <% } %>
                  </div>

                  <div>
                    <label class="form-label" for="code"><%= t('auth.code') %></label>
                    <input
                      id="code"
                      class="form-control <%= fieldErrors.code ? 'is-invalid' : '' %>"
                      name="code"
                      type="text"
                      autocomplete="one-time-code"
                      inputmode="text"
                      value="<%= values.code %>"
                      required
                    >
                    <% if (fieldErrors.code) { %>
                      <div class="invalid-feedback"><%= fieldErrors.code %></div>
                    <% } %>
                  </div>
                <% } %>

                <% if (mode !== 'forgot') { %>
                  <div>
                    <label class="form-label" for="password"><%= t('auth.password') %></label>
                    <input
                      id="password"
                      class="form-control <%= fieldErrors.password ? 'is-invalid' : '' %>"
                      name="password"
                      type="password"
                      autocomplete="<%= mode === 'login' ? 'current-password' : 'new-password' %>"
                      minlength="10"
                      required
                    >
                    <% if (fieldErrors.password) { %>
                      <div class="invalid-feedback"><%= fieldErrors.password %></div>
                    <% } %>
                    <% if (mode !== 'login') { %>
                      <div class="form-text"><%= t('auth.passwordHelp') %></div>
                    <% } %>
                  </div>
                <% } %>

                <% if (mode === 'signup') { %>
                  <div>
                    <label class="form-label" for="confirmPassword"><%= t('auth.confirmPassword') %></label>
                    <input
                      id="confirmPassword"
                      class="form-control <%= fieldErrors.confirmPassword ? 'is-invalid' : '' %>"
                      name="confirmPassword"
                      type="password"
                      autocomplete="new-password"
                      minlength="10"
                      required
                    >
                    <% if (fieldErrors.confirmPassword) { %>
                      <div class="invalid-feedback"><%= fieldErrors.confirmPassword %></div>
                    <% } %>
                  </div>
                <% } %>

                <button class="btn btn-primary" type="submit">
                  <%= t('auth.submit.' + mode) %>
                </button>
              </div>

              <div class="mt-4 mb-0 text-body-secondary">
                <% if (mode === 'login') { %>
                  <%= t('auth.noAccount') %>
                  <a href="/signup?returnTo=<%= encodeURIComponent(safeReturnTo) %>"><%= t('auth.createOne') %></a>.
                  <a href="/forgot-password"><%= t('auth.forgotPassword') %></a>.
                <% } else if (mode === 'signup') { %>
                  <%= t('auth.hasAccount') %>
                  <a href="/login?returnTo=<%= encodeURIComponent(safeReturnTo) %>"><%= t('auth.signIn') %></a>.
                <% } else { %>
                  <a href="/login"><%= t('auth.backToLogin') %></a>.
                <% } %>
              </div>

              <div class="mt-3 pt-3 border-top small text-body-secondary d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>
                  <a href="/privacy"><%= t('auth.privacy') %></a>
                  <span aria-hidden="true">·</span>
                  <a href="/terms"><%= t('auth.terms') %></a>
                </span>
                <%- include('partials/language-switcher', { languageSwitcherPath: mode === 'login' ? '/login' : mode === 'signup' ? '/signup' : mode === 'forgot' ? '/forgot-password' : '/reset-password' }) %>
              </div>
            </div>
          </form>
        </div>
      </section>
    </main>
    <%- include('partials/legal-footer') %>
    <% if (mode === 'signup') { %>
      <%- include('partials/signup-client-script') %>
    <% } %>
  </body>
</html>
