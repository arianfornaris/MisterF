<%- include('partials/app-shell-open') %>

<section class="app-page quizzes-page">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <p class="app-page-kicker"><%= t('quizzes.participationKicker') %></p>
      <h1 class="app-page-title"><%= selectedQuiz.title %></h1>
      <%- include('partials/breadcrumb', { crumbs: [
        { label: t('resources.title'), href: '/resources' },
        { label: selectedQuiz.title, href: `/quizzes/${encodeURIComponent(selectedQuiz.id)}` },
        { label: t('quizzes.participationKicker') },
      ] }) %>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>"
        aria-label="<%= t('common.close') %>"
        title="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (canManageQuiz && quizResponsesSummary && quizResponsesSummary.respondedCount > 0) { %>
    <% if (quizResponsesSummaryError) { %>
      <div class="alert alert-warning" role="alert">
        <p class="mb-<%= quizResponsesSummaryError.isCredit ? '2' : '0' %>"><%= quizResponsesSummaryError.message %></p>
        <% if (quizResponsesSummaryError.isCredit) { %>
          <a class="btn btn-primary btn-sm" href="/credits?returnTo=<%= encodeURIComponent(`/quizzes/${selectedQuiz.id}/participation`) %>"><%= t('credit.buy') %></a>
        <% } %>
      </div>
    <% } %>

    <% if (quizResponsesSummary.evaluatedCount > 0) { %>
      <section class="resource-section">
        <div class="card">
          <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
              <h2 class="h5 mb-0"><i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.aiSummaryTitle') %></h2>
              <% if (quizAiSummary && quizAiSummary.stale) { %>
                <span class="badge text-bg-warning"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i><%= t('quizzes.aiSummaryStale') %></span>
              <% } %>
            </div>

            <% if (quizAiSummary) { %>
              <div class="resource-markdown" data-render-markdown><%= quizAiSummary.text %></div>
              <p class="text-body-secondary small mt-2 mb-2"><%= t('quizzes.aiSummaryGeneratedAt', { when: quizAiSummary.generatedAtRelative }) %></p>
            <% } else { %>
              <p class="text-body-secondary mb-2"><%= t('quizzes.aiSummaryIntro') %></p>
            <% } %>

            <form method="post" action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/summary" data-quiz-generate-form>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-<%= quizAiSummary ? 'outline-secondary' : 'primary' %> btn-sm" type="submit" data-quiz-generate-submit>
                <i class="bi bi-<%= quizAiSummary ? 'arrow-clockwise' : 'stars' %> me-1" aria-hidden="true"></i>
                <%= quizAiSummary ? t('quizzes.aiSummaryRegenerate') : t('quizzes.aiSummaryGenerate') %>
              </button>
            </form>
          </div>
        </div>
      </section>

      <section class="resource-section">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
          <h2 class="h5 mb-0"><%= t('quizzes.responsesSummaryTitle') %></h2>
          <span class="badge text-bg-light border"><%= t('quizzes.responsesSummaryCount', { responded: quizResponsesSummary.respondedCount, evaluated: quizResponsesSummary.evaluatedCount }) %></span>
        </div>
        <div class="list-group shadow-sm">
          <% quizResponsesSummary.questions.forEach((question, index) => { %>
            <div class="list-group-item">
              <div class="d-flex align-items-start gap-3">
                <span class="badge rounded-pill text-bg-light border flex-shrink-0">#<%= index + 1 %></span>
                <div class="flex-grow-1">
                  <p class="mb-1 text-break"><%= question.prompt %></p>
                  <div class="d-flex flex-wrap gap-2">
                    <% if (question.correct > 0) { %>
                      <span class="badge text-bg-success"><%= question.correct %>/<%= question.total %> <%= t('quizzes.correctSuffix') %></span>
                    <% } %>
                    <% if (question.partial > 0) { %>
                      <span class="badge text-bg-warning"><%= question.partial %>/<%= question.total %> <%= t('quizzes.partialSuffix') %></span>
                    <% } %>
                    <% if (question.incorrect > 0) { %>
                      <span class="badge text-bg-danger"><%= question.incorrect %>/<%= question.total %> <%= t('quizzes.toImproveSuffix') %></span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% } else { %>
      <section class="resource-section">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
          <h2 class="h5 mb-0"><%= t('quizzes.responsesSummaryTitle') %></h2>
          <span class="badge text-bg-light border"><%= t('quizzes.responsesSummaryCount', { responded: quizResponsesSummary.respondedCount, evaluated: quizResponsesSummary.evaluatedCount }) %></span>
        </div>
        <p class="text-body-secondary mb-0"><%= t('quizzes.responsesSummaryNoneEvaluated') %></p>
      </section>
    <% } %>
  <% } %>

  <% if (canManageQuiz) { %>
    <div class="resource-section">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h5 mb-0"><%= t('quizzes.participantsSectionTitle') %></h2>
        <span class="badge text-bg-light border"><%= quizCollectedAttempts.length %></span>
      </div>
      <% if (quizCollectedAttempts.length === 0) { %>
        <p class="text-body-secondary mb-0"><%= t('quizzes.participantsEmpty') %></p>
      <% } else { %>
        <div class="list-group shadow-sm">
          <% quizCollectedAttempts.forEach((attempt) => { %>
            <% if (attempt.status === 'evaluated') { %>
              <a class="list-group-item list-group-item-action" href="/quiz-attempts/<%= encodeURIComponent(attempt.id) %>/result">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <span>
                    <i class="bi bi-person-circle me-1" aria-hidden="true"></i><%= attempt.participantLabel %>
                    <span class="badge <%= attempt.statusBadgeClass %> ms-1"><%= attempt.statusLabel %></span>
                    <% if (attempt.resultSummaryLabel) { %>
                      <span class="badge text-bg-light border ms-1"><%= attempt.resultSummaryLabel %></span>
                    <% } %>
                  </span>
                  <span class="text-body-secondary"><%= attempt.relativeUpdatedAt %></span>
                </div>
              </a>
            <% } else { %>
              <div class="list-group-item">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <span>
                    <i class="bi bi-person-circle me-1" aria-hidden="true"></i><%= attempt.participantLabel %>
                    <span class="badge <%= attempt.statusBadgeClass %> ms-1"><%= attempt.statusLabel %></span>
                  </span>
                  <span class="text-body-secondary"><%= attempt.relativeUpdatedAt %></span>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>
      <% } %>
    </div>
  <% } %>
  <% if (quizResponsesSummary && quizResponsesSummary.respondedCount === 0) { %>
    <div class="resource-section">
      <p class="text-body-secondary mb-0"><%= t('quizzes.participantsEmpty') %></p>
    </div>
  <% } %>
</section>

<div class="modal fade" tabindex="-1" aria-hidden="true" data-quiz-pending-modal data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body d-flex align-items-center gap-3">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <p class="mb-0"><%= t('quizzes.aiSummaryGenerating') %></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-shell-close', { pageScriptPartial: 'quizzes-client-script' }) %>
