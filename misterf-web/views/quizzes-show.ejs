<%- include('partials/app-shell-open') %>

<%
  const quizCurrentFolder = resourceCurrentFolder || null;
  const quizFolderOptions = Array.isArray(resourceFolderOptions) ? resourceFolderOptions : [];
  const quizFolderPath = Array.isArray(resourceFolderPath) ? resourceFolderPath : [];
  const showQuizMoveOption = canManageQuiz && !selectedQuiz.archivedAt && (quizCurrentFolder || quizFolderOptions.length > 0);
%>

<section class="app-page quizzes-page">
  <div class="app-page-header app-page-header-detail">
    <div>
      <p class="app-page-kicker"><%= t('quizzes.quizKicker') %></p>
      <h1 class="app-page-title"><%= selectedQuiz.title %></h1>
      <%- include('partials/breadcrumb', { crumbs: [
        { label: t('resources.title'), href: '/resources' },
        ...quizFolderPath.map((folder) => ({
          label: folder.title,
          href: `/resources/folders/${encodeURIComponent(folder.id)}`,
        })),
        { label: selectedQuiz.title },
      ] }) %>
    </div>
  </div>

  <div class="resource-action-row">
    <form method="post" action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/test-attempts">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-primary" type="submit">
        <i class="bi bi-play-circle me-1" aria-hidden="true"></i><%= t('quizzes.test') %>
      </button>
    </form>
    <% if (canManageQuiz) { %>
    <div class="dropdown">
      <button
        class="btn btn-secondary dropdown-toggle"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false"
      >
        <%= t('resources.options') %>
      </button>
      <ul class="dropdown-menu">
        <% if (!selectedQuiz.archivedAt) { %>
          <% if (showQuizMoveOption) { %>
            <li>
              <button
                class="dropdown-item"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#moveResourceModal"
                data-resource-move-open
                data-resource-id="<%= selectedQuiz.id %>"
                data-resource-title="<%= selectedQuiz.title %>"
                data-resource-type="quiz"
                data-current-folder-id="<%= quizCurrentFolder ? quizCurrentFolder.id : '' %>"
              >
                <i class="bi bi-folder-symlink me-2" aria-hidden="true"></i>
                <%= t('resources.moveToFolder') %>
              </button>
            </li>
          <% } %>
          <li>
            <button
              class="dropdown-item"
              type="button"
              data-bs-toggle="modal"
              data-bs-target="#quizShareProfileModal"
            >
              <i class="bi bi-person me-2" aria-hidden="true"></i>
              <%= t('resources.shareWithProfile') %>
            </button>
          </li>
          <li>
            <button
              class="dropdown-item"
              type="button"
              data-bs-toggle="modal"
              data-bs-target="#quizShareLinkModal"
            >
              <i class="bi bi-share me-2" aria-hidden="true"></i>
              <%= t('resources.share') %>
            </button>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <a class="dropdown-item" href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit">
              <i class="bi bi-pencil me-2" aria-hidden="true"></i>
              <%= t('quizzes.editQuiz') %>
            </a>
          </li>
          <li><hr class="dropdown-divider"></li>
        <% } %>
        <li>
          <form
            method="post"
            action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/<%= selectedQuiz.archivedAt ? 'restore' : 'archive' %>"
            onsubmit="return window.confirm('<%= selectedQuiz.archivedAt ? t('quizzes.confirmRestore') : t('quizzes.confirmArchive') %>');"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="returnTo" value="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>">
            <button class="dropdown-item" type="submit">
              <i class="bi <%= selectedQuiz.archivedAt ? 'bi-arrow-counterclockwise' : 'bi-archive' %> me-2" aria-hidden="true"></i>
              <%= selectedQuiz.archivedAt ? t('quizzes.restoreQuiz') : t('quizzes.archiveQuiz') %>
            </button>
          </form>
        </li>
      </ul>
    </div>
    <% } %>
  </div>

  <div class="resource-detail-summary">
    <div class="resource-markdown mb-2" data-render-markdown><%= selectedQuiz.description || draft.targetTopic || t('quizzes.noDescription') %></div>
    <div class="resource-meta-row">
      <% if (draft.targetTopic) { %><span><i class="bi bi-bullseye" aria-hidden="true"></i> <%= draft.targetTopic %></span><% } %>
      <% if (draft.level) { %><span><i class="bi bi-bar-chart" aria-hidden="true"></i> <%= draft.level %></span><% } %>
      <span><i class="bi bi-list-check" aria-hidden="true"></i> <%= draft.blocks.length %> <%= t('quizzes.blocksSuffix') %></span>
    </div>
  </div>

  <% if (selectedQuiz.sharedVia || !canManageQuiz) { %>
    <div class="d-flex">
      <% if (selectedQuizSharedFromProfileName) { %>
        <span class="badge text-bg-light border" role="status">
          <%= t('quizzes.sharedBy', { name: selectedQuizSharedFromProfileName }) %>
        </span>
      <% } else { %>
        <span class="badge text-bg-light border" role="status">
          <%= selectedQuiz.sharedVia === 'link' ? t('quizzes.sharedByLink') : t('quizzes.sharedFromProfile') %>
        </span>
      <% } %>
    </div>
  <% } %>

  <% if (canManageQuiz) { %>
    <section class="resource-section">
      <div class="card">
        <div class="card-body">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h2 class="h5 mb-0"><%= t('quizzes.participantsSectionTitle') %></h2>
            <a class="btn btn-outline-secondary btn-sm" href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/participation">
              <i class="bi bi-people me-1" aria-hidden="true"></i><%= t('quizzes.participationLink') %>
            </a>
          </div>
          <% if (quizParticipationCounts.submissions === 0) { %>
            <p class="text-body-secondary mb-0"><%= t('quizzes.participantsEmpty') %></p>
          <% } else { %>
            <div class="resource-meta-row">
              <span><i class="bi bi-check-circle" aria-hidden="true"></i> <%= t('quizzes.participantsCompletedCount', { count: quizParticipationCounts.completed }) %></span>
              <span><i class="bi bi-inbox" aria-hidden="true"></i> <%= t('quizzes.participantsSubmissionsCount', { count: quizParticipationCounts.submissions }) %></span>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  <% } %>

  <section class="resource-section">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <h2 class="h5 mb-0"><%= t('quizzes.blocks') %></h2>
      <span class="badge text-bg-light border"><%= draft.blocks.length %></span>
    </div>
    <div class="list-group shadow-sm">
      <% quizBlockOutlineItems.forEach((block) => { %>
        <% if (block.section && block.section.isFirstBlock) { %>
          <div class="list-group-item quiz-outline-section-header">
            <p class="quiz-section-eyebrow mb-1"><%= t('quizzes.section') %> <%= block.section.number %></p>
            <% if (block.section.title) { %>
              <h3 class="h6 mb-1 text-break"><%= block.section.title %></h3>
            <% } %>
            <p class="mb-0 text-body-secondary text-break"><%= block.section.instructions %></p>
          </div>
        <% } %>
        <article class="list-group-item">
          <div class="d-flex align-items-start gap-3">
            <span class="badge rounded-pill text-bg-light border flex-shrink-0">#<%= block.blockNumber %></span>
            <div class="flex-grow-1">
              <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h3 class="h6 mb-0 text-break"><%= block.prompt %></h3>
                <span class="badge text-bg-secondary"><%= block.kindLabel %></span>
              </div>
              <% if (block.sentence) { %>
                <p class="mb-2 text-body-secondary text-break"><%= block.sentence %></p>
              <% } %>
              <% if (block.metaItems.length > 0) { %>
                <div class="d-flex flex-wrap gap-2">
                  <% block.metaItems.forEach((item) => { %>
                    <span class="badge text-bg-light border"><%= item %></span>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>


  <%# The owner's own attempts here are their Probar test runs; they have the
      Participantes card for others' attempts, so this list only serves a
      non-owner recipient who needs to reach their own result. %>
  <% if (!canManageQuiz && quizAttempts.length > 0) { %>
    <div class="resource-section">
      <h2 class="h5"><%= t('quizzes.submissions') %></h2>
      <div class="list-group">
        <% quizAttempts.forEach((attempt) => { %>
          <a class="list-group-item list-group-item-action" href="/quiz-attempts/<%= encodeURIComponent(attempt.id) %>/result">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
              <span>
                <%= t('quizzes.submission') %>
                <span class="badge <%= attempt.statusBadgeClass %> ms-1"><%= attempt.statusLabel %></span>
              </span>
              <span class="text-body-secondary"><%= attempt.relativeUpdatedAt %></span>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>
</section>

<% if (canManageQuiz) { %>
  <div
    class="modal fade"
    id="quizShareProfileModal"
    tabindex="-1"
    aria-labelledby="quizShareProfileModalLabel"
    aria-hidden="true"
    <%= quizShareMode === 'profile' ? 'data-auto-open-quiz-share-modal' : '' %>
  >
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="quizShareProfileModalLabel"><%= t('resources.shareWithProfile') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body">
        <% if (shareTargetQuizProfiles.length > 0) { %>
          <form method="post" action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/share/profile" class="d-grid gap-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div>
              <label class="form-label" for="shareTargetQuizProfileId"><%= t('resources.targetProfile') %></label>
              <select class="form-select" id="shareTargetQuizProfileId" name="targetProfileId" required>
                <% shareTargetQuizProfiles.forEach((profile) => { %>
                  <option value="<%= profile.id %>"><%= profile.name %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <div class="form-check form-switch mb-1">
                <input
                  class="form-check-input"
                  type="checkbox"
                  role="switch"
                  id="quizShareProfileCollectResults"
                  name="collectResults"
                  checked
                >
                <label class="form-check-label" for="quizShareProfileCollectResults">
                  <%= t('resources.shareCollectResultsLabel') %>
                </label>
              </div>
              <p class="form-text mb-0"><%= t('resources.shareCollectResultsProfileHint') %></p>
            </div>
            <div class="d-flex justify-content-end gap-2">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
              <button type="submit" class="btn btn-primary"><%= t('resources.shareNow') %></button>
            </div>
          </form>
        <% } else { %>
          <p class="mb-0 text-body-secondary"><%= t('quizzes.noOtherProfiles') %></p>
        <% } %>
      </div>
      <% if (shareTargetQuizProfiles.length === 0) { %>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
        </div>
      <% } %>
    </div>
  </div>
</div>

  <div
    class="modal fade"
    id="quizShareLinkModal"
    tabindex="-1"
    aria-labelledby="quizShareLinkModalLabel"
    aria-hidden="true"
    <%= quizShareMode === 'link' ? 'data-auto-open-quiz-share-modal' : '' %>
  >
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="quizShareLinkModalLabel"><%= t('resources.shareLinkTitle') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body d-grid gap-3">
        <p class="mb-0 text-body-secondary">
          <%= t('quizzes.shareLinkBody') %>
        </p>
        <div>
          <form
            method="post"
            action="/resources/<%= encodeURIComponent(selectedQuiz.id) %>/share/collect-results"
            class="form-check form-switch mb-1"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="returnTo" value="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>?share=link">
            <input
              class="form-check-input"
              type="checkbox"
              role="switch"
              id="quizShareCollectResults"
              name="collectResults"
              <%= shareLink && shareLink.collectResults ? 'checked' : '' %>
              onchange="this.form.requestSubmit()"
            >
            <label class="form-check-label" for="quizShareCollectResults">
              <%= t('resources.shareCollectResultsLabel') %>
            </label>
          </form>
          <p class="form-text mb-0"><%= t('resources.shareCollectResultsHint') %></p>
        </div>
        <label class="form-label" for="quizShareLink"><%= t('resources.link') %></label>
        <input class="form-control" id="quizShareLink" value="<%= shareUrl %>" readonly data-quiz-share-link-field>
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-outline-secondary" type="button" data-copy-quiz-share-link>
            <i class="bi bi-copy me-1" aria-hidden="true"></i><%= t('resources.copy') %>
          </button>
          <button class="btn btn-outline-secondary" type="button" data-native-share-quiz-link>
            <i class="bi bi-share me-1" aria-hidden="true"></i><%= t('resources.share') %>
          </button>
        </div>
        <% if (quizShareQrDataUrl) { %>
          <div class="d-flex justify-content-center">
            <img
              class="quiz-share-qr"
              src="<%= quizShareQrDataUrl %>"
              alt="<%= t('quizzes.qrAlt') %>"
              width="180"
              height="180"
            >
          </div>
        <% } %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
      </div>
    </div>
  </div>
</div>
<% } %>

<% if (canManageQuiz) { %>
  <%- include('partials/resource-move-modal', {
    resourceMoveCurrentFolder: quizCurrentFolder,
    resourceMoveFolderOptions: quizFolderOptions,
  }) %>
<% } %>

<%- include('partials/app-shell-close', { pageScriptPartial: 'quizzes-client-script' }) %>
