<%- include('partials/app-shell-open') %>

<section class="app-page quizzes-page">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <p class="app-page-kicker">Quiz</p>
      <h1><%= draft.title %></h1>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="/quizzes/<%= encodeURIComponent(attempt.quizId) %>"
        aria-label="<%= t('common.close') %>"
        title="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (attemptError) { %>
    <div class="alert <%= attemptErrorIsCredit ? 'alert-warning' : 'alert-danger' %>" role="alert">
      <p class="mb-<%= attemptErrorIsCredit ? '2' : '0' %>"><%= attemptError %></p>
      <% if (attemptErrorIsCredit) { %>
        <a class="btn btn-primary btn-sm" href="/credits?returnTo=<%= encodeURIComponent(`/quiz-attempts/${attempt.id}`) %>"><%= t('credit.buy') %></a>
      <% } %>
    </div>
  <% } %>

  <form method="post" action="/quiz-attempts/<%= encodeURIComponent(attempt.id) %>/submit" data-quiz-submit-form data-quiz-quiz-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (guestToken) { %>
      <input type="hidden" name="guestToken" value="<%= guestToken %>">
    <% } %>
    <div data-quiz-quiz-host data-quiz-quiz-mode="attempt"></div>
    <div data-quiz-quiz-inputs hidden></div>
    <div class="quiz-block-list" data-quiz-quiz-fallback>
      <% draft.blocks.forEach((block, index) => { %>
        <%
          const blockSection = blockSections[index];
          const previousBlockSection = index > 0 ? blockSections[index - 1] : null;
        %>
        <% if (blockSection && (!previousBlockSection || previousBlockSection.id !== blockSection.id)) { %>
          <%- include('partials/quiz-section-header', {
            quizSectionMode: 'student',
            section: blockSection,
            sectionNumber: draft.sections.findIndex((candidate) => candidate.id === blockSection.id) + 1,
          }) %>
        <% } %>
        <%- include('partials/quiz-item-card', { quizItemMode: 'attempt', block, csrfToken, draft, index, responseIndex: index, selectedQuiz: null }) %>
      <% }) %>
    </div>
    <div class="quiz-submit-bar">
      <button class="btn btn-primary" type="submit" data-quiz-submit-button>
        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i><%= t('quizzes.submit') %>
      </button>
    </div>
  </form>
</section>

<div class="modal fade" tabindex="-1" aria-hidden="true" data-quiz-pending-modal>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body d-flex align-items-center gap-3">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <p class="mb-0"><%= t('quizzes.evaluating') %></p>
      </div>
    </div>
  </div>
</div>

<script type="application/json" data-quiz-quiz-json><%- quizQuizJson %></script>

<%- include('partials/app-shell-close', { pageScriptPartial: 'quizzes-client-script' }) %>
