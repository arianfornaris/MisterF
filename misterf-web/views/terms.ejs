<!doctype html>
<html lang="<%= htmlLang %>">
  <head>
    <%- include('partials/document-head', { includeBootstrapIcons: false }) %>
  </head>
  <body>
    <main class="container py-5">
      <article class="mx-auto" style="max-width: 48rem;">
        <div class="mb-4">
          <p class="text-uppercase text-body-secondary small fw-semibold mb-2">Mister F</p>
          <h1 class="h2"><%= t('legal.termsTitle') %></h1>
          <p class="text-body-secondary mb-0"><%= t('legal.lastUpdated') %></p>
        </div>

        <div class="card shadow-sm">
          <div class="card-body p-4 p-md-5 d-grid gap-4">
            <section>
              <h2 class="h5"><%= t('legal.t1Title') %></h2>
              <p class="mb-0"><%- t('legal.t1Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.t2Title') %></h2>
              <p class="mb-0"><%= t('legal.t2Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.t3Title') %></h2>
              <p class="mb-0"><%= t('legal.t3Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.t4Title') %></h2>
              <p><%= t('legal.t4Body1') %></p>
              <p class="mb-0"><%= t('legal.t4Body2') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.t5Title') %></h2>
              <p class="mb-0"><%- t('legal.t5Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.t6Title') %></h2>
              <p class="mb-0"><%- t('legal.t6Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.t7Title') %></h2>
              <p class="mb-0"><%= t('legal.t7Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.t8Title') %></h2>
              <p class="mb-0"><%= t('legal.t8Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.t9Title') %></h2>
              <p class="mb-0"><%- t('legal.t9Body') %></p>
            </section>
          </div>
        </div>

        <div class="mt-4">
          <a class="btn btn-secondary" href="/"><%= t('legal.back') %></a>
        </div>
      </article>
    </main>
    <%- include('partials/legal-footer') %>
  </body>
</html>
