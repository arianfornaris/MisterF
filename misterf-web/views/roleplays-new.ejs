<%- include('partials/app-shell-open') %>

<section class="app-page roleplays-page">
  <div class="app-page-header">
    <div>
      <p class="app-page-kicker"><%= t('roleplays.kicker') %></p>
      <h1 class="app-page-title"><%= t('roleplays.newTitle') %></h1>
      <%- include('partials/breadcrumb', { crumbs: [
        { label: t('resources.title'), href: '/resources' },
        { label: t('roleplays.newTitle') },
      ] }) %>
      <p class="app-page-copy"><%= t('roleplays.newCopy') %></p>
    </div>
  </div>

  <% if (generationError) { %>
    <div class="alert alert-danger mt-3" role="alert"><%= generationError %></div>
  <% } %>

  <div class="card resource-form-card mt-4">
    <div class="card-body">
      <form method="post" action="/roleplays/generate" data-roleplay-pending-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label" for="roleplayPrompt"><%= t('roleplays.describeLabel') %></label>
          <textarea
            class="form-control"
            id="roleplayPrompt"
            name="prompt"
            rows="10"
            required
            placeholder="<%= t('roleplays.describePlaceholder') %>"
          ><%= generationPrompt || '' %></textarea>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <button
            class="btn btn-primary"
            type="submit"
            data-roleplay-pending-submit
            data-loading-text="<%= t('roleplays.creatingShort') %>"
          >
            <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('roleplays.create') %>
          </button>
          <a class="btn btn-outline-secondary" href="/resources"><%= t('common.cancel') %></a>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include('partials/roleplay-pending-modal', {
  roleplayPendingMessage: t('roleplays.creating'),
}) %>

<%- include('partials/app-shell-close', { pageScriptPartial: 'roleplays-client-script' }) %>
