<%- include('partials/app-shell-open') %>

<%#
  The learning composition of the signed-in home (Roadmap V3 §1.16): its own
  page, no longer the tutor chat with a panel above the composer. It answers
  "what should I do now?" first, keeps Mr. F one text box away, and ends on the
  learner's own ways into practice. Every section is a deterministic query: no
  inference runs here, so opening the app costs nothing and never waits.

  Order is deliberate: the hero carries the greeting and the next step (an
  activity someone is waiting on, else the learner's open conversation), then
  the question box, then what was shared with them, then the rest of their open
  conversations, then self-directed routes.

  Illustrations come from `public/illustrations/` and follow the
  `ui-illustrations` skill: one hero, inline spots beside text that already says
  what they show (so `alt=""`), and an empty-state image only when a list is
  empty. The hero belongs to this composition only — the server decides that by
  rendering this view, never a mode selector.
%>
<%
  const nextStep = learningHome.nextStep;
  const nextStepCard = !nextStep
    ? null
    : nextStep.kind === 'activity'
      ? {
          action: t('home.nextStepStart'),
          chip: t(nextStep.activity.labelKey),
          familyClass: nextStep.activity.familyClass,
          href: nextStep.activity.detailPath,
          meta: t('home.sharedWithYou', { time: nextStep.activity.sharedRelative }),
          title: nextStep.activity.title,
        }
      : {
          action: t('home.nextStepContinue'),
          chip: t('chat.tabConversation'),
          familyClass: 'mf-fam-charla',
          href: nextStep.conversation.path,
          meta: nextStep.conversation.updatedRelative,
          title: nextStep.conversation.title || t('nav.newConversation'),
        };
  const ownRoutes = [
    { body: t('home.createPracticeBody'), href: '/practice-guides/new', illustration: 'spot-guia', title: t('home.createPracticeTitle') },
    { body: t('home.libraryBody'), href: '/resources', illustration: 'spot-biblioteca', title: t('home.libraryTitle') },
    { body: t('home.progressBody'), href: '/progress', illustration: 'spot-progreso', title: t('home.progressTitle') },
  ];
%>

<section class="app-page" aria-labelledby="homeLearningTitle">
  <%# `.home-page` holds the reading measure and is the container the grids
      measure (`src/client/styles/home.css`). %>
  <div class="home-page">
  <section class="mf-hero">
    <div class="mf-hero-copy">
      <p class="mf-eyebrow mb-0"><%= t('home.kicker') %></p>
      <h1 class="mf-page-title" id="homeLearningTitle"><%= t('home.greeting', { name: activeProfile.name }) %></h1>
      <p class="mf-page-lede mt-0">
        <% if (learningHome.pendingCount > 1) { %>
          <%= t('home.learnLedePending', { count: learningHome.pendingCount }) %>
        <% } else if (learningHome.pendingCount === 1) { %>
          <%= t('home.learnLedePendingOne') %>
        <% } else { %>
          <%= t('home.learnLedeIdle') %>
        <% } %>
      </p>

      <% if (nextStepCard) { %>
        <div class="min-w-0 mt-2 <%= nextStepCard.familyClass %>">
          <span class="mf-chip"><%= nextStepCard.chip %></span>
          <p class="h5 mt-2 mb-1"><%= nextStepCard.title %></p>
          <p class="small text-body-secondary mb-3"><%= nextStepCard.meta %></p>
          <a class="btn btn-primary" href="<%= nextStepCard.href %>">
            <i class="bi bi-play-fill me-1" aria-hidden="true"></i><%= nextStepCard.action %>
          </a>
        </div>
      <% } %>
    </div>
    <div
      class="mf-hero-art"
      style="background-image: url('/public/illustrations/hero-aprendo.png')"
      role="img"
      aria-label="<%= t('home.heroAlt') %>"
    ></div>
  </section>

  <section class="card home-ask" aria-labelledby="homeAskTitle">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-2">
        <img class="mf-spot mf-spot-inline" src="/public/illustrations/spot-charla.png" alt="" width="56" height="56">
        <h2 class="h6 mb-0" id="homeAskTitle"><%= t('home.askTutor') %></h2>
      </div>
      <%# The textarea deliberately has no `name`: without JavaScript the form
          still opens `/chat`, and the text can never reach a query string. The
          home script hands it over through sessionStorage instead. %>
      <form method="get" action="/chat" data-home-ask-form>
        <label class="visually-hidden" for="homeAskInput"><%= t('home.askPlaceholder') %></label>
        <div class="d-flex align-items-end gap-2">
          <textarea
            id="homeAskInput"
            class="form-control"
            rows="2"
            maxlength="1200"
            placeholder="<%= t('home.askPlaceholder') %>"
            data-home-ask-input
            data-attachment-prompt
          ></textarea>
          <button
            class="btn btn-primary flex-shrink-0"
            type="submit"
            title="<%= t('home.askSubmit') %>"
            aria-label="<%= t('home.askSubmit') %>"
          >
            <i class="bi bi-send" aria-hidden="true"></i>
          </button>
        </div>
        <%# The chat composer's own picker and wizard (`prompt-attachments`):
            every prompt field offers attachment. Accepted attachments travel
            to `/chat` with the text and are claimed there on send. %>
        <div class="mt-2">
          <%- include('partials/attachment-picker', { compact: true, wizardId: 'homeAskAttachmentWizard' }) %>
        </div>
        <p class="small text-body-secondary mt-2 mb-0"><%= t('home.askHint') %></p>
      </form>
    </div>
  </section>

  <section class="mt-4" aria-labelledby="homeForYouTitle">
    <div class="d-flex align-items-baseline justify-content-between gap-3 mb-3">
      <h2 class="h5 mb-0" id="homeForYouTitle">
        <i class="bi bi-inbox me-2" aria-hidden="true"></i><%= t('home.learnTitle') %>
        <% if (learningHome.pendingCount > 0) { %>
          <span class="badge text-bg-primary ms-1"><%= learningHome.pendingCount %></span>
        <% } %>
      </h2>
      <% if (learningHome.sharedWithMeTotal > learningHome.sharedWithMe.length) { %>
        <a class="small" href="/resources?type=with_me"><%= t('home.viewAllShared') %></a>
      <% } %>
    </div>

    <% if (learningHome.sharedWithMe.length > 0) { %>
      <div class="home-card-grid">
        <% learningHome.sharedWithMe.forEach((activity) => { %>
          <div>
            <a class="mf-rcard h-100 <%= activity.familyClass %>" href="<%= activity.detailPath %>">
              <div class="mf-rcard-cover">
                <i class="bi <%= activity.iconClass %> mf-rcard-glyph" aria-hidden="true"></i>
              </div>
              <div class="mf-rcard-body">
                <div class="d-flex flex-wrap gap-2">
                  <span class="mf-chip"><%= t(activity.labelKey) %></span>
                  <% if (activity.hasStarted) { %>
                    <span class="mf-chip mf-chip-plain"><%= t('home.started') %></span>
                  <% } else { %>
                    <span class="mf-chip mf-chip-warn"><%= t('home.pending') %></span>
                  <% } %>
                </div>
                <p class="mf-rcard-title"><%= activity.title %></p>
                <p class="mf-rcard-meta"><span><%= t('home.sharedWithYou', { time: activity.sharedRelative }) %></span></p>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="mf-empty">
        <img src="/public/illustrations/empty-biblioteca.png" alt="" width="640" height="478" loading="lazy">
        <p class="mf-empty-title"><%= t('home.learnEmptyTitle') %></p>
        <p class="mf-empty-body"><%= t('home.learnEmpty') %></p>
        <a class="btn btn-primary btn-sm" href="/practice-guides/new"><%= t('home.createPracticeTitle') %></a>
      </div>
    <% } %>
  </section>

  <% if (learningHome.openConversations.length > 0) { %>
    <section class="mt-4" aria-labelledby="homeContinueTitle">
      <h2 class="h5 mb-3" id="homeContinueTitle">
        <i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i><%= t('home.continueTitle') %>
      </h2>
      <div class="list-group">
        <% learningHome.openConversations.forEach((conversation) => { %>
          <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="<%= conversation.path %>">
            <i class="bi bi-chat-dots text-body-secondary" aria-hidden="true"></i>
            <span class="min-w-0">
              <span class="d-block fw-semibold text-truncate"><%= conversation.title || t('nav.newConversation') %></span>
              <span class="d-block small text-body-secondary">
                <%= t('home.conversationUpdated', { time: conversation.updatedRelative }) %>
              </span>
            </span>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="mt-4" aria-labelledby="homeOwnTitle">
    <h2 class="h5 mb-3" id="homeOwnTitle">
      <i class="bi bi-compass me-2" aria-hidden="true"></i><%= t('home.ownTitle') %>
    </h2>
    <div class="home-route-grid">
      <% ownRoutes.forEach((route) => { %>
        <div class="col">
          <div class="card h-100">
            <div class="card-body d-flex align-items-start gap-3">
              <img class="mf-spot mf-spot-inline flex-shrink-0" src="/public/illustrations/<%= route.illustration %>.png" alt="" width="56" height="56" loading="lazy">
              <div class="min-w-0">
                <h3 class="h6 mb-1">
                  <a class="stretched-link text-reset text-decoration-none" href="<%= route.href %>"><%= route.title %></a>
                </h3>
                <p class="small text-body-secondary mb-0"><%= route.body %></p>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
  </div>
</section>

<%- include('partials/app-shell-close', { pageScriptPartial: 'home-client-script' }) %>
