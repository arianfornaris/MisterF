<%- include('partials/app-shell-open') %>

<section class="app-page quizzes-page <%= activeTab === 'blocks' ? 'quiz-authoring-blocks-page' : '' %>">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <p class="app-page-kicker"><%= t('quizzes.editingKicker') %></p>
      <h1><%= draft.title %></h1>
      <form class="d-inline-block mt-3" method="post" action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/test-attempts">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary" type="submit">
          <i class="bi bi-play-circle me-1" aria-hidden="true"></i><%= t('quizzes.test') %>
        </button>
      </form>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>"
        title="<%= t('common.close') %>"
        aria-label="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (authoringError) { %>
    <div class="alert alert-danger" role="alert"><%= authoringError %></div>
  <% } %>

  <ul class="nav nav-pills authoring-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'general' ? 'active' : '' %>"
        href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit?tab=general"
        role="tab"
        aria-selected="<%= activeTab === 'general' ? 'true' : 'false' %>"
      >
        <i class="bi bi-card-text me-1" aria-hidden="true"></i><%= t('quizzes.tabGeneral') %>
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'blocks' ? 'active' : '' %>"
        href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit?tab=blocks"
        role="tab"
        aria-selected="<%= activeTab === 'blocks' ? 'true' : 'false' %>"
      >
        <i class="bi bi-ui-checks-grid me-1" aria-hidden="true"></i><%= t('quizzes.blocks') %>
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'chat' ? 'active' : '' %>"
        href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit?tab=chat"
        role="tab"
        aria-selected="<%= activeTab === 'chat' ? 'true' : 'false' %>"
      >
        <i class="bi bi-chat-dots me-1" aria-hidden="true"></i><%= t('quizzes.tabChat') %>
      </a>
    </li>
  </ul>

  <% if (activeTab === 'general') { %>
    <form class="card resource-form-card" method="post" action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit/save">
      <div class="card-body">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label" for="quizTitle"><%= t('quizzes.titleLabel') %></label>
            <input class="form-control" id="quizTitle" name="title" value="<%= draft.title %>" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="quizDescription"><%= t('resources.description') %></label>
            <textarea class="form-control" id="quizDescription" name="description" rows="3"><%= draft.description %></textarea>
          </div>
          <div class="col-12 col-md-8">
            <label class="form-label" for="quizTopic"><%= t('quizzes.topic') %></label>
            <input class="form-control" id="quizTopic" name="targetTopic" value="<%= draft.targetTopic %>">
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label" for="quizLevel"><%= t('quizzes.level') %></label>
            <input class="form-control" id="quizLevel" name="level" value="<%= draft.level %>">
          </div>
          <div class="col-12">
            <label class="form-label" for="quizInstructions"><%= t('quizzes.studentInstructions') %></label>
            <textarea class="form-control" id="quizInstructions" name="instructions" rows="4"><%= draft.instructions %></textarea>
            <div class="form-text"><%= t('quizzes.studentInstructionsHelp') %></div>
          </div>
          <div class="col-12">
            <label class="form-label" for="quizEvaluationInstructions"><%= t('quizzes.modelInstructions') %></label>
            <textarea class="form-control" id="quizEvaluationInstructions" name="evaluationInstructions" rows="3"><%= draft.evaluationInstructions %></textarea>
            <div class="form-text"><%= t('quizzes.modelInstructionsHelp') %></div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <button class="btn btn-primary" type="submit">
            <i class="bi bi-save me-1" aria-hidden="true"></i><%= t('quizzes.saveDetails') %>
          </button>
        </div>
      </div>
    </form>
  <% } %>

  <% if (activeTab === 'blocks') { %>
    <div class="quiz-blocks-panel">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0"><%= t('quizzes.blocks') %></h2>
        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#quizAddBlockModal">
          <i class="bi bi-plus-lg me-1" aria-hidden="true"></i><%= t('quizzes.addBlock') %>
        </button>
      </div>
      <div class="quiz-block-list" aria-label="<%= t('quizzes.quizBlocksAria') %>">
        <% draft.blocks.forEach((block, index) => { %>
          <%
            const blockSection = blockSections[index];
            const previousBlockSection = index > 0 ? blockSections[index - 1] : null;
          %>
          <% if (blockSection && (!previousBlockSection || previousBlockSection.id !== blockSection.id)) { %>
            <%- include('partials/quiz-section-header', {
              quizSectionMode: 'design',
              csrfToken,
              section: blockSection,
              sectionBlockCount: draft.blocks.filter((candidate) => candidate.sectionId === blockSection.id).length,
              sectionNumber: draft.sections.findIndex((candidate) => candidate.id === blockSection.id) + 1,
              selectedQuiz,
            }) %>
          <% } %>
          <%- include('partials/quiz-item-card', { quizItemMode: 'design', block, csrfToken, draft, index, selectedQuiz }) %>
        <% }) %>
        <% draft.sections.forEach((section) => { %>
          <% if (!draft.blocks.some((candidate) => candidate.sectionId === section.id)) { %>
            <%- include('partials/quiz-section-header', {
              quizSectionMode: 'design',
              csrfToken,
              section,
              sectionBlockCount: 0,
              sectionNumber: draft.sections.findIndex((candidate) => candidate.id === section.id) + 1,
              selectedQuiz,
            }) %>
          <% } %>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (activeTab === 'chat') { %>
    <div class="authoring-chat-panel">
      <div class="authoring-chat-context">
        <div class="authoring-chat-context-icon" aria-hidden="true">
          <i class="bi bi-stars"></i>
        </div>
        <div>
          <h2 class="authoring-chat-context-title"><%= t('quizzes.modifyWithAi') %></h2>
          <p class="authoring-chat-context-copy mb-0">
            <%= t('quizzes.modifyWithAiCopy') %>
          </p>
        </div>
      </div>
      <div class="authoring-chat-history messages" aria-label="<%= t('quizzes.authoringChatHistoryAria') %>" data-authoring-chat-history>
        <% if (quizAuthoringMessages.length === 0) { %>
          <article class="message-row is-model authoring-chat-message-row">
            <div class="message-bubble">
              <p class="authoring-chat-message-content mb-0"><%= t('quizzes.authoringChatEmpty') %></p>
            </div>
          </article>
        <% } else { %>
          <% quizAuthoringMessages.forEach((message) => { %>
            <article class="message-row <%= message.role === 'user' ? 'is-user' : 'is-model' %> authoring-chat-message-row">
              <div class="message-bubble">
                <p class="authoring-chat-message-content mb-0"><%= message.content %></p>
              </div>
            </article>
          <% }) %>
        <% } %>
      </div>
      <form
        class="composer authoring-chat-composer"
        method="post"
        action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit/revise"
        data-authoring-chat-form
        data-authoring-chat-credits-return-to="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit?tab=chat"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="visually-hidden" for="quizRevisionMessage"><%= t('quizzes.message') %></label>
        <div class="composer-input-wrap">
          <textarea
            class="composer-input"
            id="quizRevisionMessage"
            name="message"
            rows="2"
            maxlength="4000"
            placeholder="<%= t('quizzes.describeChangesPlaceholder') %>"
            required
          ></textarea>
        </div>
        <div class="composer-footer">
          <button class="btn btn-primary authoring-chat-submit-button" type="submit" data-authoring-chat-submit>
            <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.applyChanges') %>
          </button>
        </div>
      </form>
    </div>
  <% } %>

</section>

<div class="modal fade" id="quizAddBlockModal" tabindex="-1" aria-labelledby="quizAddBlockModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form
      class="modal-content"
      method="post"
      action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit/blocks"
      data-quiz-add-block-form
      data-quiz-add-block-chat-url="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit?tab=chat"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="quizAddBlockModalLabel"><%= t('quizzes.addBlock') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body">
        <p class="form-label mb-2"><%= t('resources.typeLabel') %></p>
        <div class="quiz-block-kind-list mb-3" role="radiogroup" aria-label="<%= t('quizzes.blockTypeAria') %>">
          <% quizBlockKinds.forEach((kind, kindIndex) => { %>
            <label class="quiz-block-kind">
              <input
                class="quiz-block-kind-input visually-hidden"
                type="radio"
                name="blockKind"
                value="<%= kind.value %>"
                data-kind-label="<%= kind.label %>"
                <%= kindIndex === 0 ? 'checked' : '' %>
                required
              >
              <strong><%= kind.label %></strong>
              <span><%= kind.description %></span>
            </label>
          <% }) %>
        </div>
        <label class="form-label" for="quizBlockPrompt">Prompt</label>
        <textarea class="form-control" id="quizBlockPrompt" name="prompt" rows="5" required></textarea>
        <div class="form-text"><%= t('quizzes.addBlockHelp') %></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
        <button class="btn btn-primary" type="submit">
          <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.createBlock') %>
        </button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" tabindex="-1" aria-hidden="true" data-quiz-pending-modal>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body d-flex align-items-center gap-3">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <p class="mb-0"><%= t('quizzes.updating') %></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-shell-close', { pageScriptPartial: 'quizzes-client-script' }) %>
