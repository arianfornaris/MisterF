        <div class="alert alert-danger d-none mb-0" role="alert" data-modify-error>
          <span data-modify-error-message><%= t('quizzes.modificationFailed') %></span>
          <a
            class="alert-link d-none ms-1"
            href="/credits?returnTo=<%= encodeURIComponent(`/quizzes/${selectedQuiz.id}/edit?tab=general`) %>"
            data-modify-credit-link
          ><%= t('credits.buyCredits') %></a>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-modify-dismiss><%= t('common.cancel') %></button>
