<%- include('partials/app-shell-open') %>

<section class="app-page quizzes-page <%= activeTab === 'blocks' ? 'quiz-authoring-blocks-page' : '' %>">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <%- include('partials/resource-page-kicker', { resourceType: 'quiz', pageLabel: t('resources.pageEditing') }) %>
      <h1><%= draft.title %></h1>
      <%- include('partials/breadcrumb', { crumbs: [
        { label: t('resources.title'), href: '/resources' },
        { label: draft.title, href: `/quizzes/${encodeURIComponent(selectedQuiz.id)}` },
        { label: t('quizzes.editingKicker') },
      ] }) %>
      <form class="d-inline-block mt-3" method="post" action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/test-attempts">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary" type="submit">
          <i class="bi bi-play-circle me-1" aria-hidden="true"></i><%= t('quizzes.test') %>
        </button>
      </form>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>"
        title="<%= t('common.close') %>"
        aria-label="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (authoringError) { %>
    <div class="alert alert-danger" role="alert"><%= authoringError %></div>
  <% } %>

  <ul class="nav nav-pills authoring-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'general' ? 'active' : '' %>"
        href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit?tab=general"
        role="tab"
        aria-selected="<%= activeTab === 'general' ? 'true' : 'false' %>"
      >
        <i class="bi bi-card-text me-1" aria-hidden="true"></i><%= t('quizzes.tabGeneral') %>
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'blocks' ? 'active' : '' %>"
        href="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit?tab=blocks"
        role="tab"
        aria-selected="<%= activeTab === 'blocks' ? 'true' : 'false' %>"
      >
        <i class="bi bi-ui-checks-grid me-1" aria-hidden="true"></i><%= t('quizzes.blocks') %>
      </a>
    </li>
  </ul>

<div class="d-flex flex-wrap gap-2 mt-3 mb-3">
  <button class="btn btn-outline-primary" type="button" data-quiz-modify-open>
    <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.modifyWithAi') %>
  </button>
</div>

  <% if (activeTab === 'general') { %>
    <form class="card resource-form-card" method="post" action="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit/save" data-quiz-general-form>
      <div class="card-body">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label" for="quizTitle"><%= t('quizzes.titleLabel') %></label>
            <input class="form-control" id="quizTitle" name="title" value="<%= draft.title %>" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="quizDescription"><%= t('resources.description') %></label>
            <textarea class="form-control" id="quizDescription" name="description" rows="3"><%= draft.description %></textarea>
          </div>
          <div class="col-12 col-md-8">
            <label class="form-label" for="quizTopic"><%= t('quizzes.topic') %></label>
            <input class="form-control" id="quizTopic" name="targetTopic" value="<%= draft.targetTopic %>">
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label" for="quizLevel"><%= t('quizzes.level') %></label>
            <input class="form-control" id="quizLevel" name="level" value="<%= draft.level %>">
          </div>
          <div class="col-12">
            <label class="form-label" for="quizInstructions"><%= t('quizzes.studentInstructions') %></label>
            <textarea class="form-control" id="quizInstructions" name="instructions" rows="4"><%= draft.instructions %></textarea>
            <div class="form-text"><%= t('quizzes.studentInstructionsHelp') %></div>
          </div>
          <div class="col-12">
            <label class="form-label" for="quizEvaluationInstructions"><%= t('quizzes.modelInstructions') %></label>
            <textarea class="form-control" id="quizEvaluationInstructions" name="evaluationInstructions" rows="3"><%= draft.evaluationInstructions %></textarea>
            <div class="form-text"><%= t('quizzes.modelInstructionsHelp') %></div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <button class="btn btn-primary" type="submit">
            <i class="bi bi-save me-1" aria-hidden="true"></i><%= t('quizzes.saveDetails') %>
          </button>
        </div>
      </div>
    </form>
  <% } %>

  <% if (activeTab === 'blocks') { %>
    <div class="quiz-blocks-panel">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0"><%= t('quizzes.blocks') %></h2>
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-outline-secondary" type="button" data-quiz-add-block-open>
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i><%= t('quizzes.addBlock') %>
          </button>
        </div>
      </div>
      <div class="quiz-block-list" aria-label="<%= t('quizzes.quizBlocksAria') %>">
        <% draft.blocks.forEach((block, index) => { %>
          <%
            const blockSection = blockSections[index];
            const previousBlockSection = index > 0 ? blockSections[index - 1] : null;
          %>
          <% if (blockSection && (!previousBlockSection || previousBlockSection.id !== blockSection.id)) { %>
            <%- include('partials/quiz-section-header', {
              quizSectionMode: 'design',
              csrfToken,
              section: blockSection,
              sectionBlockCount: draft.blocks.filter((candidate) => candidate.sectionId === blockSection.id).length,
              sectionNumber: draft.sections.findIndex((candidate) => candidate.id === blockSection.id) + 1,
              selectedQuiz,
            }) %>
          <% } %>
          <%- include('partials/quiz-item-card', { quizItemMode: 'design', block, csrfToken, draft, index, selectedQuiz }) %>
        <% }) %>
        <% draft.sections.forEach((section) => { %>
          <% if (!draft.blocks.some((candidate) => candidate.sectionId === section.id)) { %>
            <%- include('partials/quiz-section-header', {
              quizSectionMode: 'design',
              csrfToken,
              section,
              sectionBlockCount: 0,
              sectionNumber: draft.sections.findIndex((candidate) => candidate.id === section.id) + 1,
              selectedQuiz,
            }) %>
          <% } %>
        <% }) %>
      </div>
    </div>
  <% } %>


</section>

<div
  class="modal fade"
  id="quizAddBlockModal"
  tabindex="-1"
  aria-labelledby="quizAddBlockModalLabel"
  aria-hidden="true"
  data-quiz-add-block-modal
  data-bs-backdrop="static"
  data-bs-keyboard="false"
  data-modify-endpoint="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit/add-block"
  data-modify-apply-endpoint="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit/add-block/apply"
  data-modify-discard-endpoint="/quizzes/<%= encodeURIComponent(selectedQuiz.id) %>/edit/add-block/discard"
  data-generic-error="<%= t('quizzes.modificationFailed') %>"
  data-current-label="<%= t('quizzes.currentVersion') %>"
  data-proposed-label="<%= t('quizzes.proposedVersion') %>"
  data-apply-label="<%= t('quizzes.addBlockApprove') %>"
  data-applying-label="<%= t('quizzes.approvingChanges') %>"
>
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="quizAddBlockModalLabel"><%= t('quizzes.addBlock') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>" data-modify-dismiss></button>
      </div>
      <div class="modal-body">
        <div data-modify-phase="describe">

          <div class="row g-3 mb-3">
            <div class="col-12 col-md-8">
              <label class="form-label" for="quizAddBlockKind"><%= t('resources.typeLabel') %></label>
              <select class="form-select" id="quizAddBlockKind" data-quiz-add-block-kind>
                <% quizBlockKinds.forEach((kind) => { %>
                  <option value="<%= kind.value %>"><%= kind.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-12 col-md-4">
              <label class="form-label" for="quizAddBlockLevel"><%= t('quizzes.level') %></label>
              <input class="form-control" id="quizAddBlockLevel" value="<%= draft.level %>" data-quiz-add-block-level>
            </div>
            <% if (draft.sections.length > 0) { %>
              <div class="col-12 col-md-8">
                <label class="form-label" for="quizAddBlockSection"><%= t('quizzes.section') %></label>
                <select class="form-select" id="quizAddBlockSection" data-quiz-add-block-section>
                  <option value=""><%= t('quizzes.noSection') %></option>
                  <% draft.sections.forEach((section, sectionIndex) => { %>
                    <option value="<%= section.id %>"><%= section.title || `${t('quizzes.section')} ${sectionIndex + 1}` %></option>
                  <% }) %>
                </select>
              </div>
            <% } %>
            <div class="col-12 <%= draft.sections.length > 0 ? 'col-md-4' : 'col-md-4' %>">
              <label class="form-label" for="quizAddBlockPosition"><%= t('quizzes.position') %></label>
              <select class="form-select" id="quizAddBlockPosition" data-quiz-add-block-position>
                <option value="end"><%= t('quizzes.positionEnd') %></option>
                <option value="start"><%= t('quizzes.positionStart') %></option>
              </select>
            </div>
          </div>
          <label class="form-label" for="quizAddBlockRequest"><%= t('quizzes.addBlockDescribeLabel') %></label>
          <textarea
            class="form-control"
            id="quizAddBlockRequest"
            rows="4"
            minlength="3"
            maxlength="2000"
            required
            data-modify-request
            placeholder="<%= t('quizzes.addBlockPlaceholder') %>"
          ></textarea>
          <div class="form-text"><%= t('quizzes.addBlockHelp') %></div>
        </div>

        <div class="text-center py-4 d-none" data-modify-phase="generating">
          <div class="spinner-border text-primary mb-3" role="status">
            <span class="visually-hidden"><%= t('common.loading') %></span>
          </div>
          <p class="mb-0 fw-semibold"><%= t('quizzes.generatingProposal') %></p>
        </div>

        <div class="d-none" data-modify-phase="preview">
          <p class="text-body-secondary"><%= t('quizzes.reviewAddBlockHelp') %></p>
          <div data-modify-comparison></div>
        </div>

        <div class="alert alert-danger d-none mb-0" role="alert" data-modify-error>
          <span data-modify-error-message><%= t('quizzes.modificationFailed') %></span>
          <a
            class="alert-link d-none ms-1"
            href="/credits?returnTo=<%= encodeURIComponent(`/quizzes/${selectedQuiz.id}/edit?tab=blocks`) %>"
            data-modify-credit-link
          ><%= t('credits.buyCredits') %></a>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-modify-dismiss><%= t('common.cancel') %></button>
        <button class="btn btn-outline-primary d-none" type="button" data-modify-retry>
          <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i><%= t('quizzes.tryAnotherModification') %>
        </button>
        <button class="btn btn-primary" type="button" data-modify-generate>
          <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.createBlock') %>
        </button>
        <button class="btn btn-primary d-none" type="button" data-modify-apply>
          <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true" data-modify-apply-spinner></span>
          <i class="bi bi-check-lg me-1" aria-hidden="true" data-modify-apply-icon></i><span data-modify-apply-label><%= t('quizzes.addBlockApprove') %></span>
        </button>
      </div>
    </div>
  </div>
</div>

