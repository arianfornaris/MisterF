<%- include('partials/app-shell-open') %>

<%
  const formatLabel = (format) => t(`mediaLibrary.format.${format}`);
  const generationModeLabel = (mode) => t(`mediaLibrary.mode${mode === 'complete_scene' ? 'CompleteScene' : 'ImageOnly'}`);
  const scriptTypeLabel = (scriptType) => t(`mediaLibrary.scriptType${scriptType ? `${scriptType.charAt(0).toUpperCase()}${scriptType.slice(1)}` : 'Unspecified'}`);
  const sourceLabel = (source) => t(`mediaLibrary.source.${source}`);
%>

<section class="app-page">
  <div class="app-page-header app-page-header-has-close mb-4">
    <div>
      <p class="app-page-kicker"><%= t('mediaLibrary.editingKicker') %></p>
      <h1 class="app-page-title"><%= mediaItem.title %></h1>
    </div>
    <div class="app-page-header-actions">
      <a class="app-page-close-button" href="/media-library/<%= encodeURIComponent(mediaItem.id) %>" title="<%= t('common.close') %>" aria-label="<%= t('common.close') %>">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (authoringError) { %>
    <div class="alert alert-danger" role="alert"><%= authoringError %></div>
  <% } %>

  <ul class="nav nav-pills authoring-tabs mb-4" role="tablist">
    <li class="nav-item" role="presentation">
      <a class="nav-link <%= activeTab === 'general' ? 'active' : '' %>" href="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit?tab=general" role="tab" aria-selected="<%= activeTab === 'general' ? 'true' : 'false' %>">
        <i class="bi bi-card-text me-1" aria-hidden="true"></i><%= t('mediaLibrary.tabInformation') %>
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link <%= activeTab === 'chat' ? 'active' : '' %>" href="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit?tab=chat" role="tab" aria-selected="<%= activeTab === 'chat' ? 'true' : 'false' %>">
        <i class="bi bi-chat-dots me-1" aria-hidden="true"></i><%= t('quizzes.tabChat') %>
      </a>
    </li>
  </ul>

  <% if (activeTab === 'general') { %>
    <div class="row g-4">
      <div class="col-12 col-xl-7">
        <section class="card">
          <% if (mediaItem.image) { %>
            <img
              class="card-img-top scene-media-detail-image"
              src="<%= mediaItem.image.src %>"
              alt="<%= mediaItem.image.alt %>"
            >
          <% } %>
          <div class="card-body">
            <h2 class="h5 mb-3"><%= t('mediaLibrary.imageLayer') %></h2>
            <p class="mb-0"><%= mediaItem.image?.alt || t('mediaLibrary.notSpecified') %></p>
            <% if (mediaItem.image?.width && mediaItem.image?.height) { %>
              <p class="small text-body-secondary mb-0 mt-2">
                <%= t('mediaLibrary.imageDetails', {
                  contentType: mediaItem.image.contentType || t('mediaLibrary.notSpecified'),
                  height: mediaItem.image.height,
                  width: mediaItem.image.width,
                }) %>
              </p>
            <% } %>
          </div>
        </section>

        <section class="card mt-4">
          <div class="card-body">
            <h2 class="h5 mb-3"><%= t('mediaLibrary.script') %></h2>
            <% if (mediaItem.script?.scriptType === 'dialogue') { %>
              <div class="list-group list-group-flush">
                <% mediaItem.script.turns.forEach((turn) => { %>
                  <div class="list-group-item px-0">
                    <p class="fw-semibold mb-1"><%= turn.speaker %></p>
                    <p class="mb-0"><%= turn.text %></p>
                  </div>
                <% }) %>
              </div>
            <% } else if (mediaItem.script) { %>
              <p class="mb-0 scene-media-script-text"><%= mediaItem.script.text %></p>
            <% } else { %>
              <p class="text-body-secondary mb-0"><%= t('mediaLibrary.notSpecified') %></p>
            <% } %>
          </div>
        </section>
      </div>

      <div class="col-12 col-xl-5">
        <div class="d-grid gap-4">
          <form class="card resource-form-card" method="post" action="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit/save" autocomplete="off">
            <div class="card-body">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="form-label" for="mediaTitle"><%= t('quizzes.titleLabel') %></label>
              <input class="form-control" id="mediaTitle" name="title" maxlength="120" value="<%= mediaItem.title %>" required>
              <button class="btn btn-primary mt-3" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i><%= t('quizzes.saveDetails') %></button>
            </div>
          </form>

          <section class="card">
            <div class="card-body">
              <h2 class="h5 mb-3"><%= t('mediaLibrary.metadata') %></h2>
              <dl class="scene-media-definition-list mb-0">
                <dt><%= t('mediaLibrary.level') %></dt>
                <dd><%= mediaItem.level || t('mediaLibrary.notSpecified') %></dd>
                <dt><%= t('mediaLibrary.formatLabel') %></dt>
                <dd><%= formatLabel(mediaItem.format) %></dd>
                <dt><%= t('mediaLibrary.generationMode') %></dt>
                <dd><%= generationModeLabel(mediaItem.generationMode) %></dd>
                <dt><%= t('mediaLibrary.scriptType') %></dt>
                <dd><%= scriptTypeLabel(mediaItem.script?.scriptType || mediaItem.scriptTypePreference) %></dd>
                <dt><%= t('mediaLibrary.setting') %></dt>
                <dd><%= mediaItem.setting || t('mediaLibrary.notSpecified') %></dd>
                <dt><%= t('mediaLibrary.sourceLabel') %></dt>
                <dd><%= sourceLabel(mediaItem.source) %></dd>
                <dt><%= t('mediaLibrary.mediaId') %></dt>
                <dd><code><%= mediaItem.id %></code></dd>
                <dt><%= t('mediaLibrary.sourceMediaId') %></dt>
                <dd><code><%= mediaItem.createdFrom?.sourceMediaId || t('mediaLibrary.notSpecified') %></code></dd>
              </dl>
            </div>
          </section>

          <section class="card">
            <div class="card-body">
              <h2 class="h5 mb-3"><%= t('mediaLibrary.generationPrompt') %></h2>
              <p class="mb-0"><%= mediaItem.generationPrompt || mediaItem.createdFrom?.prompt || t('mediaLibrary.notSpecified') %></p>
            </div>
          </section>

          <section class="card">
            <div class="card-body">
              <h2 class="h5 mb-3"><%= t('mediaLibrary.audio') %></h2>
              <% if (mediaItem.audio) { %>
                <audio class="w-100" controls preload="metadata" src="<%= mediaItem.audio.src %>"></audio>
                <p class="text-body-secondary small mb-0 mt-2">
                  <%= t('mediaLibrary.duration', { seconds: Math.round(mediaItem.audio.durationSeconds) }) %>
                </p>
              <% } else { %>
                <p class="text-body-secondary mb-0"><%= t('mediaLibrary.notSpecified') %></p>
              <% } %>
            </div>
          </section>
        </div>
      </div>
    </div>

    <section class="card mt-4">
      <div class="card-body">
        <h2 class="h5 mb-3"><%= t('mediaLibrary.visualSummary') %></h2>
        <% if (mediaItem.visualSummary.length > 0) { %>
          <ol class="mb-0">
            <% mediaItem.visualSummary.forEach((line) => { %>
              <li><%= line %></li>
            <% }) %>
          </ol>
        <% } else { %>
          <p class="text-body-secondary mb-0"><%= t('mediaLibrary.notSpecified') %></p>
        <% } %>
      </div>
    </section>

    <section class="card mt-4">
      <div class="card-body">
        <div class="row g-4">
          <% [
            { label: t('mediaLibrary.tags'), values: mediaItem.tags },
            { label: t('mediaLibrary.skills'), values: mediaItem.skills },
            { label: t('mediaLibrary.useCases'), values: mediaItem.useCases },
          ].forEach((group) => { %>
            <div class="col-12 col-lg-4">
              <h2 class="h6"><%= group.label %></h2>
              <div class="d-flex flex-wrap gap-2">
                <% if (group.values.length > 0) { %>
                  <% group.values.forEach((value) => { %>
                    <span class="badge text-bg-light border"><%= value %></span>
                  <% }) %>
                <% } else { %>
                  <span class="text-body-secondary"><%= t('mediaLibrary.notSpecified') %></span>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <% if (activeTab === 'chat') { %>
    <div class="authoring-chat-panel">
      <div class="authoring-chat-context">
        <div class="authoring-chat-context-icon" aria-hidden="true"><i class="bi bi-stars"></i></div>
        <div>
          <h2 class="authoring-chat-context-title"><%= t('mediaLibrary.modifyWithAi') %></h2>
          <p class="authoring-chat-context-copy mb-0"><%= t('mediaLibrary.modifyWithAiCopy') %></p>
        </div>
      </div>
      <div class="authoring-chat-history messages" aria-label="<%= t('quizzes.authoringChatHistoryAria') %>" data-authoring-chat-history>
        <% if (mediaAuthoringMessages.length === 0) { %>
          <article class="message-row is-model authoring-chat-message-row"><div class="message-bubble"><p class="authoring-chat-message-content mb-0"><%= t('mediaLibrary.authoringChatEmpty') %></p></div></article>
        <% } else { %>
          <% mediaAuthoringMessages.forEach((message) => { %>
            <article class="message-row <%= message.role === 'user' ? 'is-user' : 'is-model' %> authoring-chat-message-row"><div class="message-bubble"><p class="authoring-chat-message-content mb-0"><%= message.content %></p></div></article>
          <% }) %>
        <% } %>
      </div>
      <form class="composer authoring-chat-composer" method="post" action="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit/revise" data-authoring-chat-form data-authoring-chat-credits-return-to="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit?tab=chat">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="visually-hidden" for="mediaRevisionMessage"><%= t('quizzes.message') %></label>
        <div class="composer-input-wrap"><textarea class="composer-input" id="mediaRevisionMessage" name="message" rows="2" maxlength="4000" placeholder="<%= t('quizzes.describeChangesPlaceholder') %>" required></textarea></div>
        <div class="composer-footer"><button class="btn btn-primary authoring-chat-submit-button" type="submit" data-authoring-chat-submit><i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.applyChanges') %></button></div>
      </form>
    </div>
  <% } %>
</section>

<%- include('partials/app-shell-close', { pageScriptPartial: 'media-library-client-script' }) %>
