<%- include('partials/app-shell-open') %>

<section class="app-page">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <p class="app-page-kicker"><%= t('mediaLibrary.editingKicker') %></p>
      <h1 class="app-page-title"><%= mediaItem.title %></h1>
    </div>
    <div class="app-page-header-actions">
      <a class="app-page-close-button" href="/media-library/<%= encodeURIComponent(mediaItem.id) %>" title="<%= t('common.close') %>" aria-label="<%= t('common.close') %>">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (authoringError) { %>
    <div class="alert alert-danger" role="alert"><%= authoringError %></div>
  <% } %>

  <ul class="nav nav-pills authoring-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <a class="nav-link <%= activeTab === 'general' ? 'active' : '' %>" href="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit?tab=general" role="tab" aria-selected="<%= activeTab === 'general' ? 'true' : 'false' %>">
        <i class="bi bi-card-text me-1" aria-hidden="true"></i><%= t('quizzes.tabGeneral') %>
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link <%= activeTab === 'chat' ? 'active' : '' %>" href="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit?tab=chat" role="tab" aria-selected="<%= activeTab === 'chat' ? 'true' : 'false' %>">
        <i class="bi bi-chat-dots me-1" aria-hidden="true"></i><%= t('quizzes.tabChat') %>
      </a>
    </li>
  </ul>

  <% if (activeTab === 'general') { %>
    <form class="card resource-form-card" method="post" action="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit/save" autocomplete="off">
      <div class="card-body">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="form-label" for="mediaTitle"><%= t('quizzes.titleLabel') %></label>
        <input class="form-control" id="mediaTitle" name="title" maxlength="120" value="<%= mediaItem.title %>" required>
        <button class="btn btn-primary mt-3" type="submit"><i class="bi bi-save me-1" aria-hidden="true"></i><%= t('quizzes.saveDetails') %></button>
      </div>
    </form>
  <% } %>

  <% if (activeTab === 'chat') { %>
    <div class="authoring-chat-panel">
      <div class="authoring-chat-context">
        <div class="authoring-chat-context-icon" aria-hidden="true"><i class="bi bi-stars"></i></div>
        <div>
          <h2 class="authoring-chat-context-title"><%= t('mediaLibrary.modifyWithAi') %></h2>
          <p class="authoring-chat-context-copy mb-0"><%= t('mediaLibrary.modifyWithAiCopy') %></p>
        </div>
      </div>
      <div class="authoring-chat-history messages" aria-label="<%= t('quizzes.authoringChatHistoryAria') %>" data-authoring-chat-history>
        <% if (mediaAuthoringMessages.length === 0) { %>
          <article class="message-row is-model authoring-chat-message-row"><div class="message-bubble"><p class="authoring-chat-message-content mb-0"><%= t('mediaLibrary.authoringChatEmpty') %></p></div></article>
        <% } else { %>
          <% mediaAuthoringMessages.forEach((message) => { %>
            <article class="message-row <%= message.role === 'user' ? 'is-user' : 'is-model' %> authoring-chat-message-row"><div class="message-bubble"><p class="authoring-chat-message-content mb-0"><%= message.content %></p></div></article>
          <% }) %>
        <% } %>
      </div>
      <form class="composer authoring-chat-composer" method="post" action="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit/revise" data-authoring-chat-form data-authoring-chat-credits-return-to="/media-library/<%= encodeURIComponent(mediaItem.id) %>/edit?tab=chat">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="visually-hidden" for="mediaRevisionMessage"><%= t('quizzes.message') %></label>
        <div class="composer-input-wrap"><textarea class="composer-input" id="mediaRevisionMessage" name="message" rows="2" maxlength="4000" placeholder="<%= t('quizzes.describeChangesPlaceholder') %>" required></textarea></div>
        <div class="composer-footer"><button class="btn btn-primary authoring-chat-submit-button" type="submit" data-authoring-chat-submit><i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.applyChanges') %></button></div>
      </form>
    </div>
  <% } %>
</section>

<%- include('partials/app-shell-close', { pageScriptPartial: 'media-library-client-script' }) %>
