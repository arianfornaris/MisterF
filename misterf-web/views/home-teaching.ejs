<%- include('partials/app-shell-open') %>

<%#
  The teaching composition of the signed-in home (Roadmap V3 §1.14). Every card
  on this page is a deterministic query: no inference runs here, so opening the
  app costs nothing and never waits.

  Order is deliberate, and mirrors the learning home. The hero carries the
  greeting and the one thing worth opening now — the shared activity with the
  newest answers — so what happened while the owner was away still comes
  first; the rest of the news follows; creating an activity sits next so a
  profile that has shared nothing yet still has a useful action; the full
  shared list and the tutor close the page.

  Illustrations follow the `ui-illustrations` skill: this composition's own
  hero (`hero-enseno`), the content-family spots on the three creation cards
  (each spot *is* that family's mark), `spot-charla` beside the tutor, and the
  empty-state image when nothing is shared yet.
%>
<%
  const lead = teachingHome.recentActivities[0] || null;
  const moreNews = teachingHome.recentActivities.slice(1);
  const createRoutes = [
    { body: t('home.createQuizBody'), href: '/quizzes/new', illustration: 'spot-quiz', title: t('chat.resourceTypeQuiz') },
    { body: t('home.createGuideBody'), href: '/practice-guides/new', illustration: 'spot-guia', title: t('chat.resourceTypePracticeGuide') },
    { body: t('home.createRoleplayBody'), href: '/roleplays/new', illustration: 'spot-roleplay', title: t('chat.resourceTypeRoleplay') },
  ];
%>

<section class="app-page" aria-labelledby="homeTeachingTitle">
  <section class="mf-hero">
    <div class="mf-hero-copy">
      <p class="mf-eyebrow mb-0"><%= t('home.kicker') %></p>
      <h1 class="mf-page-title" id="homeTeachingTitle"><%= t('home.greeting', { name: activeProfile.name }) %></h1>
      <p class="mf-page-lede mt-0">
        <% if (teachingHome.recentParticipantCount > 1) { %>
          <%= t('home.teachLedeNews', { count: teachingHome.recentParticipantCount }) %>
        <% } else if (teachingHome.recentParticipantCount === 1) { %>
          <%= t('home.teachLedeNewsOne') %>
        <% } else { %>
          <%= t('home.teachCopy') %>
        <% } %>
      </p>

      <% if (lead) { %>
        <div class="min-w-0 mt-2 <%= lead.familyClass %>">
          <span class="mf-chip"><%= t(lead.labelKey) %></span>
          <p class="h5 mt-2 mb-1"><%= lead.title %></p>
          <p class="small text-body-secondary mb-3">
            <%= lead.recentParticipantCount === 1
              ? t('home.newsCountOne')
              : t('home.newsCount', { count: lead.recentParticipantCount }) %>
            <% if (lead.lastParticipationRelative) { %>
              <span class="mx-1" aria-hidden="true">·</span>
              <%= t('home.lastResponse', { time: lead.lastParticipationRelative }) %>
            <% } %>
          </p>
          <a class="btn btn-primary" href="<%= lead.participationPath %>">
            <i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i><%= t('home.viewResponses') %>
          </a>
        </div>
      <% } %>
    </div>
    <div
      class="mf-hero-art"
      style="background-image: url('/public/illustrations/hero-enseno.png')"
      role="img"
      aria-label="<%= t('home.heroTeachAlt') %>"
    ></div>
  </section>

  <% if (moreNews.length > 0) { %>
    <section aria-labelledby="homeNewsTitle">
      <h2 class="h5 mb-1" id="homeNewsTitle">
        <i class="bi bi-bell me-2" aria-hidden="true"></i><%= t('home.newsTitle') %>
      </h2>
      <p class="small text-body-secondary mb-3"><%= t('home.newsCopy') %></p>

      <div class="list-group">
        <% moreNews.forEach((activity) => { %>
          <a class="list-group-item list-group-item-action d-flex align-items-start justify-content-between gap-3" href="<%= activity.participationPath %>">
            <span class="min-w-0">
              <span class="d-block fw-semibold text-truncate">
                <i class="bi <%= activity.iconClass %> me-2" aria-hidden="true"></i><%= activity.title %>
              </span>
              <span class="d-block small text-body-secondary">
                <%= t(activity.labelKey) %>
                <% if (activity.lastParticipationRelative) { %>
                  <span class="mx-1" aria-hidden="true">·</span>
                  <%= t('home.lastResponse', { time: activity.lastParticipationRelative }) %>
                <% } %>
              </span>
            </span>
            <span class="badge text-bg-primary flex-shrink-0">
              <%= activity.recentParticipantCount === 1
                ? t('home.newsCountOne')
                : t('home.newsCount', { count: activity.recentParticipantCount }) %>
            </span>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="<%= moreNews.length > 0 ? 'mt-4' : '' %>" aria-labelledby="homeCreateTitle">
    <h2 class="h5 mb-1" id="homeCreateTitle">
      <i class="bi bi-plus-circle me-2" aria-hidden="true"></i><%= t('home.createTitle') %>
    </h2>
    <p class="small text-body-secondary mb-3"><%= t('home.createCopy') %></p>

    <div class="row row-cols-1 row-cols-md-3 g-3">
      <% createRoutes.forEach((route) => { %>
        <div class="col">
          <div class="card h-100">
            <div class="card-body d-flex align-items-start gap-3">
              <img class="mf-spot mf-spot-inline flex-shrink-0" src="/public/illustrations/<%= route.illustration %>.png" alt="" width="56" height="56" loading="lazy">
              <div class="min-w-0">
                <h3 class="h6 mb-1">
                  <a class="stretched-link text-reset text-decoration-none" href="<%= route.href %>"><%= route.title %></a>
                </h3>
                <p class="small text-body-secondary mb-0"><%= route.body %></p>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="mt-4" aria-labelledby="homeSharedTitle">
    <h2 class="h5 mb-3" id="homeSharedTitle">
      <i class="bi bi-share me-2" aria-hidden="true"></i><%= t('home.sharedTitle') %>
    </h2>

    <% if (teachingHome.sharedActivities.length > 0) { %>
      <div class="list-group">
        <% teachingHome.sharedActivities.forEach((activity) => { %>
          <div class="list-group-item position-relative d-flex align-items-start justify-content-between gap-3">
            <div class="min-w-0">
              <%# The row's title stays body text and the link is the whole row,
                  the same shape the resource catalog uses, so the two lists read
                  alike instead of one turning every title into a green link. %>
              <a class="stretched-link" href="<%= activity.participationPath %>">
                <span class="visually-hidden"><%= t('home.viewResponses') %> <%= activity.title %></span>
              </a>
              <span class="d-block fw-semibold text-truncate">
                <i class="bi <%= activity.iconClass %> me-2" aria-hidden="true"></i><%= activity.title %>
              </span>
              <span class="d-block small text-body-secondary">
                <%= t(activity.labelKey) %>
                <% if (activity.lastParticipationRelative) { %>
                  <span class="mx-1" aria-hidden="true">·</span>
                  <%= t('home.lastResponse', { time: activity.lastParticipationRelative }) %>
                <% } %>
              </span>
            </div>
            <span class="badge <%= activity.participantCount > 0 ? 'text-bg-secondary' : 'text-bg-light border' %> flex-shrink-0">
              <% if (activity.participantCount === 0) { %>
                <%= t('home.noParticipants') %>
              <% } else if (activity.participantCount === 1) { %>
                <%= t('home.participantsOne') %>
              <% } else { %>
                <%= t('home.participants', { count: activity.participantCount }) %>
              <% } %>
            </span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <%# Empty-state illustration per the `ui-illustrations` skill; decorative,
          since the title beside it says the same thing. %>
      <div class="mf-empty">
        <img src="/public/illustrations/empty-clase.png" alt="" width="640" height="478" loading="lazy">
        <p class="mf-empty-title"><%= t('home.sharedEmptyTitle') %></p>
        <p class="mf-empty-body"><%= t('home.sharedEmpty') %></p>
        <a class="btn btn-primary btn-sm" href="/resources"><%= t('home.sharedEmptyAction') %></a>
      </div>
    <% } %>
  </section>

  <section class="card mt-4" aria-labelledby="homeAskTutorTitle">
    <div class="card-body d-flex align-items-start gap-3">
      <img class="mf-spot mf-spot-inline flex-shrink-0" src="/public/illustrations/spot-charla.png" alt="" width="56" height="56" loading="lazy">
      <div class="min-w-0">
        <h2 class="h6 mb-1" id="homeAskTutorTitle">
          <a class="stretched-link text-reset text-decoration-none" href="/chat"><%= t('home.askTutor') %></a>
        </h2>
        <p class="small text-body-secondary mb-0"><%= t('home.askTutorCopy') %></p>
      </div>
    </div>
  </section>
</section>

<%- include('partials/app-shell-close') %>
