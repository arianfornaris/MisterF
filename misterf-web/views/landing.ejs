<!doctype html>
<html lang="<%= htmlLang %>">
  <head>
    <%- include('partials/document-head', {
      includeBootstrapIcons: true,
      metaDescription: t('landing.metaDescription'),
    }) %>
  </head>
  <body>
    <a class="visually-hidden-focusable btn btn-primary m-2" href="#landing-main"><%= t('landing.skipToContent') %></a>

    <header class="border-bottom">
      <nav class="container d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
        <span class="d-inline-flex align-items-center gap-2 fw-semibold">
          <img src="/public/brand/panel-brand-64.png" alt="" width="28" height="28" aria-hidden="true">
          Mister F
        </span>
        <div class="d-flex align-items-center gap-2">
          <%- include('partials/language-switcher', { languageSwitcherPath: '/' }) %>
          <a class="btn btn-sm btn-outline-secondary" href="/login"><%= t('landing.signIn') %></a>
        </div>
      </nav>
    </header>

    <main id="landing-main">
      <section class="container py-5">
        <div class="row gy-5 align-items-center">
          <div class="col-lg-6">
            <p class="text-uppercase text-body-secondary small fw-semibold mb-2"><%= t('landing.heroEyebrow') %></p>
            <h1 class="display-6 fw-bold mb-3"><%= t('landing.heroTitle') %></h1>
            <p class="fs-5 text-body-secondary"><%= t('landing.heroSubtitle') %></p>
            <div class="d-flex flex-wrap gap-2 mt-4">
              <a class="btn btn-primary btn-lg" href="/signup"><%= t('landing.heroPrimaryCta') %></a>
              <% if (locals.demoActivity) { %>
                <a class="btn btn-outline-secondary btn-lg" href="<%= locals.demoActivity.url %>"><%= t('landing.heroSecondaryCta') %></a>
              <% } %>
            </div>
            <p class="small text-body-secondary mt-3 mb-0"><%= t('landing.heroFootnote') %></p>
          </div>

          <div class="col-lg-6">
            <div class="card">
              <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                  <h2 class="h6 text-body-secondary mb-0"><%= t('landing.reportExampleTitle') %></h2>
                  <span class="badge text-bg-secondary"><%= t('landing.reportExampleLabel') %></span>
                </div>
                <p class="fw-semibold mb-3"><%= t('landing.reportExampleActivity') %></p>
                <ul class="list-group list-group-flush">
                  <li class="list-group-item d-flex align-items-start gap-3 px-0">
                    <i class="bi bi-check2-circle fs-5 text-success" aria-hidden="true"></i>
                    <span><%= t('landing.reportExampleCompleted') %></span>
                  </li>
                  <li class="list-group-item d-flex align-items-start gap-3 px-0">
                    <i class="bi bi-exclamation-circle fs-5 text-warning" aria-hidden="true"></i>
                    <span>
                      <span class="d-block small text-body-secondary"><%= t('landing.reportExampleWeakestLabel') %></span>
                      <%= t('landing.reportExampleWeakest') %>
                    </span>
                  </li>
                  <li class="list-group-item d-flex align-items-start gap-3 px-0">
                    <i class="bi bi-arrow-repeat fs-5 text-primary" aria-hidden="true"></i>
                    <span>
                      <span class="d-block small text-body-secondary"><%= t('landing.reportExampleFollowUpLabel') %></span>
                      <%= t('landing.reportExampleFollowUp') %>
                    </span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <% if (locals.demoActivity) { %>
        <section class="bg-body-tertiary border-top border-bottom py-5">
          <div class="container">
            <div class="row justify-content-center text-center">
              <div class="col-lg-8">
                <h2 class="h3 mb-3"><%= t('landing.proofTitle') %></h2>
                <p class="text-body-secondary"><%= t('landing.proofBody') %></p>
                <div class="card mt-4 text-start">
                  <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3 p-4">
                    <div>
                      <p class="small text-body-secondary mb-1"><%= t('landing.proofActivityLabel') %></p>
                      <p class="h5 mb-0">
                        <%= locals.demoActivity.title %>
                        <% if (locals.demoActivity.level) { %>
                          <span class="badge text-bg-secondary align-middle ms-1"><%= locals.demoActivity.level %></span>
                        <% } %>
                      </p>
                    </div>
                    <a class="btn btn-primary btn-lg" href="<%= locals.demoActivity.url %>"><%= t('landing.proofCta') %></a>
                  </div>
                </div>
                <p class="small text-body-secondary mt-3 mb-0"><%= t('landing.proofRandomNote') %></p>
              </div>
            </div>
          </div>
        </section>
      <% } %>

      <section class="container py-5">
        <h2 class="h3 mb-4"><%= t('landing.stepsTitle') %></h2>
        <ol class="list-unstyled row row-cols-1 row-cols-md-2 row-cols-lg-3 gy-4 mb-0">
          <% [1, 2, 3, 4, 5].forEach((step) => { %>
            <li class="col">
              <div class="card h-100">
                <div class="card-body">
                  <span class="badge text-bg-primary rounded-pill mb-3"><%= step %></span>
                  <h3 class="h6"><%= t(`landing.step${step}Title`) %></h3>
                  <p class="text-body-secondary mb-0"><%= t(`landing.step${step}Body`) %></p>
                </div>
              </div>
            </li>
          <% }) %>
        </ol>
      </section>

      <section class="bg-body-tertiary border-top border-bottom py-5">
        <div class="container">
          <div class="row gy-4">
            <div class="col-lg-4">
              <h2 class="h3 mb-0"><%= t('landing.notTitle') %></h2>
            </div>
            <div class="col-lg-8">
              <ul class="list-unstyled d-grid gap-3 mb-0">
                <% [1, 2, 3].forEach((item) => { %>
                  <li class="d-flex align-items-start gap-3">
                    <i class="bi bi-x-circle fs-5 text-body-secondary" aria-hidden="true"></i>
                    <span><%= t(`landing.not${item}`) %></span>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="container py-5">
        <div class="row gy-4">
          <div class="col-lg-6">
            <h2 class="h4"><%= t('landing.founderTitle') %></h2>
            <p class="text-body-secondary"><%= t('landing.founderBody1') %></p>
            <p class="text-body-secondary"><%= t('landing.founderBody2') %></p>
            <p class="text-body-secondary mb-0"><%= t('landing.founderBody3') %></p>
          </div>
          <div class="col-lg-6">
            <div class="card h-100">
              <div class="card-body p-4">
                <h2 class="h5"><%= t('landing.pilotTitle') %></h2>
                <p class="text-body-secondary"><%= t('landing.pilotBody') %></p>
                <h3 class="h6 mt-4"><%= t('landing.priceTitle') %></h3>
                <p class="text-body-secondary"><%= t('landing.priceBody') %></p>
                <a class="btn btn-primary" href="mailto:<%= locals.contactEmail %>"><%= t('landing.pilotCta') %></a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-body-tertiary border-top border-bottom py-5">
        <div class="container">
          <div class="row gy-4 align-items-center">
            <div class="col-lg-7">
              <h2 class="h4"><%= t('landing.learnerTitle') %></h2>
              <p class="text-body-secondary mb-0"><%= t('landing.learnerBody') %></p>
            </div>
            <div class="col-lg-5 text-lg-end">
              <a class="btn btn-outline-secondary btn-lg" href="/chat"><%= t('landing.learnerCta') %></a>
            </div>
          </div>
        </div>
      </section>

      <section class="container py-5">
        <div class="row gy-4">
          <div class="col-lg-5">
            <h2 class="h4"><%= t('landing.privacyTitle') %></h2>
            <ul class="list-unstyled d-grid gap-2 text-body-secondary">
              <% [1, 2, 3, 4].forEach((item) => { %>
                <li class="d-flex align-items-start gap-2">
                  <i class="bi bi-shield-check text-success" aria-hidden="true"></i>
                  <span><%= t(`landing.privacy${item}`) %></span>
                </li>
              <% }) %>
            </ul>
            <a class="link-secondary" href="/privacy"><%= t('landing.privacyLink') %></a>
          </div>

          <div class="col-lg-7">
            <h2 class="h4 mb-3"><%= t('landing.faqTitle') %></h2>
            <div class="accordion" id="landingFaq">
              <% [1, 2, 3, 4, 5, 6].forEach((item) => { %>
                <div class="accordion-item">
                  <h3 class="accordion-header">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#landingFaqAnswer<%= item %>"
                      aria-expanded="false"
                      aria-controls="landingFaqAnswer<%= item %>"
                    ><%= t(`landing.faq${item}Question`) %></button>
                  </h3>
                  <div id="landingFaqAnswer<%= item %>" class="accordion-collapse collapse" data-bs-parent="#landingFaq">
                    <div class="accordion-body text-body-secondary"><%= t(`landing.faq${item}Answer`) %></div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </section>

      <section class="container pb-5">
        <div class="card">
          <div class="card-body p-4 p-md-5 text-center">
            <h2 class="h3 mb-3"><%= t('landing.heroTitle') %></h2>
            <a class="btn btn-primary btn-lg" href="/signup"><%= t('landing.heroPrimaryCta') %></a>
            <p class="small text-body-secondary mt-3 mb-0"><%= t('landing.heroFootnote') %></p>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-top py-4">
      <div class="container">
        <div class="row gy-3 align-items-center">
          <div class="col-md-8">
            <p class="mb-1"><%= t('landing.footerTagline') %></p>
            <p class="small text-body-secondary mb-0"><%= t('landing.footerCompany') %></p>
          </div>
          <div class="col-md-4 text-md-end small">
            <a class="link-secondary" href="mailto:<%= locals.contactEmail %>"><%= t('landing.footerContact') %></a>
            <span aria-hidden="true">·</span>
            <a class="link-secondary" href="/privacy"><%= t('nav.privacy') %></a>
            <span aria-hidden="true">·</span>
            <a class="link-secondary" href="/terms"><%= t('nav.terms') %></a>
          </div>
        </div>
      </div>
    </footer>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
