<!doctype html>
<html lang="<%= htmlLang %>">
  <head>
    <%- include('partials/document-head', {
      includeAppStyles: false,
      metaDescription: t('landing.metaDescription'),
      pageStylesheet: locals.pageStylesheet,
    }) %>
  </head>
  <body>
    <a class="skip-link" href="#landing-main"><%= t('landing.skipToContent') %></a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img src="/public/brand/panel-brand-64.png" alt="" width="30" height="30" aria-hidden="true">
          Mister F
        </a>
        <div class="header-actions">
          <nav class="langs" aria-label="<%= t('language.label') %>">
            <% languages.forEach((language) => { %>
              <a
                href="/?lang=<%= language.code %>"
                <%= locale === language.code ? 'aria-current="true"' : '' %>
              ><span class="lang-full"><%= language.endonym %></span><span class="lang-code"><%= language.code.toUpperCase() %></span></a>
            <% }) %>
          </nav>
          <a class="signin" href="/login"><%= t('landing.signIn') %></a>
        </div>
      </div>
    </header>

    <main id="landing-main">
      <section class="hero">
        <div class="wrap">
          <div>
            <p class="eyebrow"><%= t('landing.heroEyebrow') %></p>
            <h1><%= t('landing.heroTitle') %></h1>
            <p class="lede"><%= t('landing.heroSubtitle') %></p>
            <div class="btn-row">
              <a class="btn btn--primary" href="/signup"><%= t('landing.heroPrimaryCta') %></a>
              <% if (locals.demoActivity) { %>
                <a class="btn btn--ghost" href="<%= locals.demoActivity.url %>"><%= t('landing.heroSecondaryCta') %></a>
              <% } %>
            </div>
            <p class="fineprint"><%= t('landing.heroFootnote') %></p>
          </div>

          <div class="hero-visual">
            <div class="card card--lift">
              <div class="card-head">
                <p class="card-kicker"><%= t('landing.reportExampleTitle') %></p>
                <span class="pill"><%= t('landing.reportExampleLabel') %></span>
              </div>
              <p class="card-title"><%= t('landing.reportExampleActivity') %></p>
              <ul class="report-rows">
                <li>
                  <svg class="icon icon--ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"></path>
                    <path d="m9 11 3 3 9-9"></path>
                  </svg>
                  <span class="row-value"><%= t('landing.reportExampleCompleted') %></span>
                </li>
                <li>
                  <svg class="icon icon--warn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 8v5"></path>
                    <path d="M12 16.5h.01"></path>
                  </svg>
                  <span>
                    <span class="row-label"><%= t('landing.reportExamplePerQuestionLabel') %></span>
                    <span class="row-value"><%= t('landing.reportExamplePerQuestion') %></span>
                  </span>
                </li>
                <li>
                  <svg class="icon icon--loop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3.5 13.9 8l4.6 1.9-4.6 1.9L12 16.4l-1.9-4.6L5.5 9.9 10.1 8Z"></path>
                    <path d="M18.5 15.2l.7 1.6 1.6.7-1.6.7-.7 1.6-.7-1.6-1.6-.7 1.6-.7Z"></path>
                  </svg>
                  <span>
                    <span class="row-label"><%= t('landing.reportExampleSummaryLabel') %></span>
                    <span class="row-value"><%= t('landing.reportExampleSummary') %></span>
                  </span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <% if (locals.demoActivity) { %>
        <section class="band band--dark">
          <div class="wrap center">
            <h2><%= t('landing.proofTitle') %></h2>
            <p class="lede"><%= t('landing.proofBody') %></p>
            <div class="demo">
              <div>
                <p class="card-kicker"><%= t('landing.proofActivityLabel') %></p>
                <p class="demo-name">
                  <%= locals.demoActivity.title %>
                  <% if (locals.demoActivity.level) { %>
                    <span class="level"><%= locals.demoActivity.level %></span>
                  <% } %>
                </p>
              </div>
              <a class="btn btn--primary" href="<%= locals.demoActivity.url %>"><%= t('landing.proofCta') %></a>
            </div>
            <p class="fineprint"><%= t('landing.proofRandomNote') %></p>
          </div>
        </section>
      <% } %>

      <section class="band band--paper">
        <div class="wrap">
          <div class="section-head">
            <h2><%= t('landing.stepsTitle') %></h2>
          </div>
          <ol class="steps">
            <% [1, 2, 3, 4, 5].forEach((step) => { %>
              <li>
                <div>
                  <h3><%= t(`landing.step${step}Title`) %></h3>
                  <p><%= t(`landing.step${step}Body`) %></p>
                </div>
              </li>
            <% }) %>
          </ol>
        </div>
      </section>

      <section class="band">
        <div class="wrap">
          <div class="section-head">
            <h2><%= t('landing.notTitle') %></h2>
          </div>
          <ul class="denials">
            <% [1, 2, 3].forEach((item) => { %>
              <li>
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="m15 9-6 6"></path>
                  <path d="m9 9 6 6"></path>
                </svg>
                <span><%= t(`landing.not${item}`) %></span>
              </li>
            <% }) %>
          </ul>
        </div>
      </section>

      <section class="band band--paper">
        <div class="wrap cols">
          <div>
            <div class="section-head">
              <h2><%= t('landing.founderTitle') %></h2>
            </div>
            <div class="prose founder-quote">
              <p><%= t('landing.founderBody1') %></p>
              <p><%= t('landing.founderBody2') %></p>
            </div>
            <p class="stamp"><%= t('landing.founderBody3') %></p>
          </div>

          <div class="panel">
            <h2><%= t('landing.pilotTitle') %></h2>
            <p><%= t('landing.pilotBody') %></p>
            <h3><%= t('landing.priceTitle') %></h3>
            <p><%= t('landing.priceBody') %></p>
            <a class="btn btn--primary" href="mailto:<%= locals.contactEmail %>"><%= t('landing.pilotCta') %></a>
          </div>
        </div>
      </section>

      <section class="band">
        <div class="wrap cols cols--tight cols--middle">
          <div>
            <h2><%= t('landing.learnerTitle') %></h2>
            <p class="lede"><%= t('landing.learnerBody') %></p>
          </div>
          <div class="btn-row">
            <a class="btn btn--ghost" href="/chat"><%= t('landing.learnerCta') %></a>
          </div>
        </div>
      </section>

      <section class="band band--paper">
        <div class="wrap cols">
          <div>
            <div class="section-head">
              <h2><%= t('landing.faqTitle') %></h2>
            </div>
            <div class="faq">
              <% [1, 2, 3, 4, 5, 6].forEach((item) => { %>
                <details>
                  <summary><%= t(`landing.faq${item}Question`) %></summary>
                  <p><%= t(`landing.faq${item}Answer`) %></p>
                </details>
              <% }) %>
            </div>
          </div>

          <div>
            <div class="section-head">
              <h2><%= t('landing.privacyTitle') %></h2>
            </div>
            <ul class="checks">
              <% [1, 2, 3, 4].forEach((item) => { %>
                <li>
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                  <span><%= t(`landing.privacy${item}`) %></span>
                </li>
              <% }) %>
            </ul>
            <a href="/privacy"><%= t('landing.privacyLink') %></a>
          </div>
        </div>
      </section>

      <section class="band">
        <div class="wrap">
          <div class="closing">
            <h2><%= t('landing.heroTitle') %></h2>
            <div class="btn-row">
              <a class="btn btn--primary" href="/signup"><%= t('landing.heroPrimaryCta') %></a>
            </div>
            <p class="fineprint"><%= t('landing.heroFootnote') %></p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p><%= t('landing.footerTagline') %></p>
          <p class="stamp"><%= t('landing.footerCompany') %></p>
        </div>
        <nav class="footer-links">
          <a href="mailto:<%= locals.contactEmail %>"><%= t('landing.footerContact') %></a>
          <a href="/privacy"><%= t('nav.privacy') %></a>
          <a href="/terms"><%= t('nav.terms') %></a>
        </nav>
      </div>
    </footer>
  </body>
</html>
