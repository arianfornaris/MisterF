<%- include('partials/app-shell-open') %>

<section class="app-page roleplays-page">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <p class="app-page-kicker"><%= t('roleplays.editingKicker') %></p>
      <h1 class="app-page-title"><%= draft.title %></h1>
      <p class="app-page-copy"><%= t('roleplays.editCopy') %></p>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>"
        aria-label="<%= t('common.close') %>"
        title="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (authoringError) { %>
    <div class="alert alert-danger mt-3" role="alert"><%= authoringError %></div>
  <% } %>

  <ul class="nav nav-pills authoring-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'general' ? 'active' : '' %>"
        href="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit?tab=general"
        role="tab"
        aria-selected="<%= activeTab === 'general' ? 'true' : 'false' %>"
      >
        <i class="bi bi-card-text me-1" aria-hidden="true"></i><%= t('quizzes.tabGeneral') %>
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'chat' ? 'active' : '' %>"
        href="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit?tab=chat"
        role="tab"
        aria-selected="<%= activeTab === 'chat' ? 'true' : 'false' %>"
      >
        <i class="bi bi-chat-dots me-1" aria-hidden="true"></i><%= t('quizzes.tabChat') %>
      </a>
    </li>
  </ul>

  <% if (activeTab === 'general') { %>
    <form class="card resource-form-card" method="post" action="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body">
        <h2 class="h5 mb-3"><%= t('quizzes.tabGeneral') %></h2>
        <div class="mb-3">
          <label class="form-label" for="roleplayTitle"><%= t('quizzes.titleLabel') %></label>
          <input class="form-control" id="roleplayTitle" name="title" maxlength="220" required value="<%= draft.title %>">
        </div>
        <div class="mb-3">
          <label class="form-label" for="roleplayDescription"><%= t('resources.description') %></label>
          <div class="form-text mb-2"><%= t('roleplays.descriptionHelp') %></div>
          <textarea
            class="form-control"
            id="roleplayDescription"
            name="description"
            rows="5"
            maxlength="1500"
            data-markdown-editor
            data-markdown-editor-min-height="8rem"
          ><%= draft.description %></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label" for="roleplayScenario"><%= t('roleplays.situation') %></label>
          <div class="form-text mb-2"><%= t('roleplays.situationHelp') %></div>
          <textarea
            class="form-control"
            id="roleplayScenario"
            name="scenario"
            rows="7"
            maxlength="2200"
            required
            data-markdown-editor
            data-markdown-editor-required="true"
            data-markdown-editor-error="roleplayScenarioError"
            data-markdown-editor-min-height="12rem"
          ><%= draft.scenario %></textarea>
          <div class="invalid-feedback" id="roleplayScenarioError" hidden>
            <%= t('roleplays.situationError') %>
          </div>
        </div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="roleplayLevel"><%= t('quizzes.level') %></label>
            <input class="form-control" id="roleplayLevel" name="level" maxlength="120" value="<%= draft.level %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="roleplayMaxLearnerTurns"><%= t('roleplays.turnLimit') %></label>
            <input class="form-control" id="roleplayMaxLearnerTurns" name="maxLearnerTurns" type="number" min="1" max="20" value="<%= draft.maxLearnerTurns || '' %>">
          </div>
        </div>
      </div>

      <div class="card-body border-top">
        <h2 class="h5 mb-3"><%= t('roleplays.pedagogicalFocus') %></h2>
        <label class="form-label" for="roleplayPedagogicalFocus"><%= t('roleplays.pedagogicalFocusLabel') %></label>
        <div class="form-text mb-2"><%= t('roleplays.pedagogicalFocusHelp') %></div>
        <textarea
          class="form-control"
          id="roleplayPedagogicalFocus"
          name="pedagogicalFocus"
          rows="7"
          maxlength="5000"
          data-markdown-editor
          data-markdown-editor-min-height="12rem"
        ><%= draft.pedagogicalFocus %></textarea>
      </div>

      <div class="card-body border-top">
        <h2 class="h5 mb-3"><%= t('roleplays.characters') %></h2>
        <div class="row g-3">
          <div class="col-12">
            <div class="border rounded p-3">
              <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <div
                  class="roleplay-character-avatar-preview"
                  data-roleplay-avatar-preview="learner"
                  aria-hidden="true"
                >
                  <% if (learnerAvatar) { %>
                    <img src="<%= learnerAvatar.imagePath %>" alt="">
                  <% } else { %>
                    <i class="bi bi-person"></i>
                  <% } %>
                </div>
                <div class="min-w-0">
                  <h3 class="h6 mb-1"><%= t('roleplays.studentRole') %></h3>
                  <button
                    class="btn btn-outline-secondary btn-sm"
                    type="button"
                    data-roleplay-avatar-open
                    data-roleplay-avatar-target="learner"
                  >
                    <i class="bi bi-person-bounding-box me-1" aria-hidden="true"></i><%= t('roleplays.chooseAvatar') %>
                  </button>
                </div>
              </div>
              <input
                type="hidden"
                name="learnerCharacterAvatarId"
                value="<%= learnerCharacter.avatarId || '' %>"
                data-roleplay-avatar-input="learner"
              >
              <div class="mb-3">
                <label class="form-label" for="learnerCharacterName"><%= t('roleplays.visibleName') %></label>
                <input class="form-control" id="learnerCharacterName" name="learnerCharacterName" maxlength="120" value="<%= learnerCharacter.name %>" required>
              </div>
              <label class="form-label" for="learnerCharacterDescription"><%= t('resources.description') %></label>
              <textarea class="form-control" id="learnerCharacterDescription" name="learnerCharacterDescription" rows="4" maxlength="1200" required><%= learnerCharacter.description %></textarea>
            </div>
          </div>
          <div class="col-12">
            <div class="border rounded p-3">
              <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <div
                  class="roleplay-character-avatar-preview"
                  data-roleplay-avatar-preview="ai"
                  aria-hidden="true"
                >
                  <% if (aiAvatar) { %>
                    <img src="<%= aiAvatar.imagePath %>" alt="">
                  <% } else { %>
                    <i class="bi bi-person-video3"></i>
                  <% } %>
                </div>
                <div class="min-w-0">
                  <h3 class="h6 mb-1"><%= t('roleplays.aiRole') %></h3>
                  <button
                    class="btn btn-outline-secondary btn-sm"
                    type="button"
                    data-roleplay-avatar-open
                    data-roleplay-avatar-target="ai"
                  >
                    <i class="bi bi-person-bounding-box me-1" aria-hidden="true"></i><%= t('roleplays.chooseAvatar') %>
                  </button>
                </div>
              </div>
              <input
                type="hidden"
                name="aiCharacterAvatarId"
                value="<%= aiCharacter.avatarId || '' %>"
                data-roleplay-avatar-input="ai"
              >
              <div class="mb-3">
                <label class="form-label" for="aiCharacterName"><%= t('roleplays.visibleName') %></label>
                <input class="form-control" id="aiCharacterName" name="aiCharacterName" maxlength="120" value="<%= aiCharacter.name %>" required>
              </div>
              <label class="form-label" for="aiCharacterDescription"><%= t('resources.description') %></label>
              <textarea class="form-control" id="aiCharacterDescription" name="aiCharacterDescription" rows="4" maxlength="1200" required><%= aiCharacter.description %></textarea>
            </div>
          </div>
        </div>
      </div>

      <div class="card-footer d-flex justify-content-end gap-2">
        <a class="btn btn-secondary" href="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>"><%= t('common.cancel') %></a>
        <button class="btn btn-primary" type="submit"><%= t('common.saveChanges') %></button>
      </div>
    </form>
  <% } %>

  <% if (activeTab === 'chat') { %>
    <div class="authoring-chat-panel">
      <div class="authoring-chat-context">
        <div class="authoring-chat-context-icon" aria-hidden="true">
          <i class="bi bi-stars"></i>
        </div>
        <div>
          <h2 class="authoring-chat-context-title"><%= t('roleplays.modifyWithAi') %></h2>
          <p class="authoring-chat-context-copy mb-0">
            <%= t('roleplays.modifyWithAiCopy') %>
          </p>
        </div>
      </div>
      <div class="authoring-chat-history messages" aria-label="<%= t('quizzes.authoringChatHistoryAria') %>" data-authoring-chat-history>
        <% if (roleplayAuthoringMessages.length === 0) { %>
          <article class="message-row is-model authoring-chat-message-row">
            <div class="message-bubble">
              <p class="authoring-chat-message-content mb-0"><%= t('roleplays.authoringChatEmpty') %></p>
            </div>
          </article>
        <% } else { %>
          <% roleplayAuthoringMessages.forEach((message) => { %>
            <article class="message-row <%= message.role === 'user' ? 'is-user' : 'is-model' %> authoring-chat-message-row">
              <div class="message-bubble">
                <p class="authoring-chat-message-content mb-0"><%= message.content %></p>
              </div>
            </article>
          <% }) %>
        <% } %>
      </div>
      <form
        class="composer authoring-chat-composer"
        method="post"
        action="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit/revise"
        data-authoring-chat-form
        data-authoring-chat-credits-return-to="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit?tab=chat"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="visually-hidden" for="roleplayRevisionMessage"><%= t('quizzes.message') %></label>
        <div class="composer-input-wrap">
          <textarea
            class="composer-input"
            id="roleplayRevisionMessage"
            name="message"
            rows="2"
            maxlength="4000"
            required
            placeholder="<%= t('quizzes.describeChangesPlaceholder') %>"
          ></textarea>
        </div>
        <div class="composer-footer">
          <button class="btn btn-primary authoring-chat-submit-button" type="submit" data-authoring-chat-submit>
            <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.applyChanges') %>
          </button>
        </div>
      </form>
    </div>
  <% } %>
</section>

<div
  class="modal fade"
  id="roleplayAvatarSelectorModal"
  tabindex="-1"
  aria-labelledby="roleplayAvatarSelectorTitle"
  aria-hidden="true"
  data-roleplay-avatar-selector-modal
>
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5" id="roleplayAvatarSelectorTitle"><%= t('roleplays.chooseAvatar') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body">
        <div class="roleplay-avatar-grid" role="list" aria-label="<%= t('roleplays.availableAvatarsAria') %>">
          <button
            class="roleplay-avatar-option"
            type="button"
            data-roleplay-avatar-option
            data-avatar-id=""
            data-avatar-name="<%= t('roleplays.noAvatar') %>"
            data-avatar-src=""
            role="listitem"
          >
            <span class="roleplay-avatar-option-image" aria-hidden="true">
              <i class="bi bi-person"></i>
            </span>
            <span class="roleplay-avatar-option-name"><%= t('roleplays.noAvatar') %></span>
            <span class="roleplay-avatar-option-meta"><%= t('roleplays.useIcon') %></span>
          </button>
          <% roleplayAvatarOptions.forEach((avatar) => { %>
            <button
              class="roleplay-avatar-option"
              type="button"
              data-roleplay-avatar-option
              data-avatar-id="<%= avatar.id %>"
              data-avatar-name="<%= avatar.name %>"
              data-avatar-src="<%= avatar.imagePath %>"
              role="listitem"
            >
              <span class="roleplay-avatar-option-image" aria-hidden="true">
                <img src="<%= avatar.imagePath %>" alt="">
              </span>
              <span class="roleplay-avatar-option-name"><%= avatar.name %></span>
              <span class="roleplay-avatar-option-meta"><%= avatar.age %> · <%= avatar.gender %></span>
            </button>
          <% }) %>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" tabindex="-1" aria-hidden="true" data-roleplay-pending-modal data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body d-flex align-items-center gap-3">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <p class="mb-0"><%= t('roleplays.applyingChanges') %></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-shell-close', { pageScriptPartial: 'roleplays-client-script' }) %>
