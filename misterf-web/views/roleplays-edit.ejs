<%- include('partials/app-shell-open') %>

<section class="app-page roleplays-page">
  <div class="app-page-header app-page-header-has-close mb-4 pe-0">
    <div class="flex-grow-1">
      <p class="app-page-kicker"><%= t('roleplays.editingKicker') %></p>
      <h1 class="app-page-title"><%= draft.title %></h1>
      <p class="app-page-copy"><%= t('roleplays.editCopy') %></p>
    </div>
    <div class="app-page-header-actions position-static flex-shrink-0">
      <button class="btn btn-outline-primary" type="button" data-roleplay-modify-open>
        <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('roleplays.modifyWithAiButton') %>
      </button>
      <a
        class="app-page-close-button"
        href="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>"
        aria-label="<%= t('common.close') %>"
        title="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (authoringError) { %>
    <div class="alert alert-danger mt-3" role="alert"><%= authoringError %></div>
  <% } %>

  <form
    class="card resource-form-card"
    method="post"
    action="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit"
    data-roleplay-authoring-form
  >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
          <h2 class="h5 mb-0"><%= t('quizzes.tabGeneral') %></h2>
        </div>
        <div class="mb-3">
          <label class="form-label" for="roleplayTitle"><%= t('quizzes.titleLabel') %></label>
          <input class="form-control" id="roleplayTitle" name="title" maxlength="220" required value="<%= draft.title %>">
        </div>
        <div class="mb-3">
          <label class="form-label" for="roleplayDescription"><%= t('resources.description') %></label>
          <div class="form-text mb-2"><%= t('roleplays.descriptionHelp') %></div>
          <textarea
            class="form-control"
            id="roleplayDescription"
            name="description"
            rows="8"
            maxlength="5000"
            required
            data-markdown-editor
            data-markdown-editor-required="true"
            data-markdown-editor-error="roleplayDescriptionError"
            data-markdown-editor-min-height="14rem"
          ><%= draft.description %></textarea>
          <div class="invalid-feedback" id="roleplayDescriptionError" hidden>
            <%= t('roleplays.descriptionError') %>
          </div>
        </div>
        <div>
          <label class="form-label" for="roleplayLevel"><%= t('quizzes.level') %></label>
          <select class="form-select" id="roleplayLevel" name="level" required>
            <option value="" disabled <%= roleplayLevelOptions.includes(draft.level) ? '' : 'selected' %>><%= t('roleplays.selectLevel') %></option>
            <% roleplayLevelOptions.forEach((level) => { %>
              <option value="<%= level %>" <%= draft.level === level ? 'selected' : '' %>><%= level %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="card-body border-top">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
          <h2 class="h5 mb-0"><%= t('roleplays.characters') %></h2>
        </div>
        <div class="row g-3">
          <div class="col-12">
            <div class="border rounded p-3">
              <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <div
                  class="roleplay-character-avatar-preview"
                  data-roleplay-avatar-preview="learner"
                  aria-hidden="true"
                >
                  <% if (learnerAvatar) { %>
                    <img src="<%= learnerAvatar.imagePath %>" alt="">
                  <% } else { %>
                    <i class="bi bi-person"></i>
                  <% } %>
                </div>
                <div class="min-w-0">
                  <h3 class="h6 mb-1"><%= t('roleplays.studentRole') %></h3>
                  <button
                    class="btn btn-outline-secondary btn-sm"
                    type="button"
                    data-roleplay-avatar-open
                    data-roleplay-avatar-target="learner"
                  >
                    <i class="bi bi-person-bounding-box me-1" aria-hidden="true"></i><%= t('roleplays.chooseAvatar') %>
                  </button>
                </div>
              </div>
              <input
                type="hidden"
                name="learnerCharacterAvatarId"
                value="<%= learnerCharacter.avatarId || '' %>"
                data-roleplay-avatar-input="learner"
              >
              <div class="mb-3">
                <label class="form-label" for="learnerCharacterName"><%= t('roleplays.visibleName') %></label>
                <input class="form-control" id="learnerCharacterName" name="learnerCharacterName" maxlength="120" value="<%= learnerCharacter.name %>" required>
              </div>
              <label class="form-label" for="learnerCharacterDescription"><%= t('resources.description') %></label>
              <textarea class="form-control" id="learnerCharacterDescription" name="learnerCharacterDescription" rows="4" maxlength="1200" required><%= learnerCharacter.description %></textarea>
            </div>
          </div>
          <div class="col-12">
            <div class="border rounded p-3">
              <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <div
                  class="roleplay-character-avatar-preview"
                  data-roleplay-avatar-preview="ai"
                  aria-hidden="true"
                >
                  <% if (aiAvatar) { %>
                    <img src="<%= aiAvatar.imagePath %>" alt="">
                  <% } else { %>
                    <i class="bi bi-person-video3"></i>
                  <% } %>
                </div>
                <div class="min-w-0">
                  <h3 class="h6 mb-1"><%= t('roleplays.aiRole') %></h3>
                  <button
                    class="btn btn-outline-secondary btn-sm"
                    type="button"
                    data-roleplay-avatar-open
                    data-roleplay-avatar-target="ai"
                  >
                    <i class="bi bi-person-bounding-box me-1" aria-hidden="true"></i><%= t('roleplays.chooseAvatar') %>
                  </button>
                </div>
              </div>
              <input
                type="hidden"
                name="aiCharacterAvatarId"
                value="<%= aiCharacter.avatarId || '' %>"
                data-roleplay-avatar-input="ai"
              >
              <div class="mb-3">
                <label class="form-label" for="aiCharacterName"><%= t('roleplays.visibleName') %></label>
                <input class="form-control" id="aiCharacterName" name="aiCharacterName" maxlength="120" value="<%= aiCharacter.name %>" required>
              </div>
              <label class="form-label" for="aiCharacterDescription"><%= t('resources.description') %></label>
              <textarea class="form-control" id="aiCharacterDescription" name="aiCharacterDescription" rows="4" maxlength="1200" required><%= aiCharacter.description %></textarea>
            </div>
          </div>
        </div>
      </div>

      <div class="card-footer d-flex justify-content-end gap-2">
        <a class="btn btn-secondary" href="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>"><%= t('common.cancel') %></a>
        <button class="btn btn-primary" type="submit"><%= t('common.saveChanges') %></button>
      </div>
  </form>
</section>

<div
  class="modal fade"
  id="roleplayModifyModal"
  tabindex="-1"
  aria-labelledby="roleplayModifyModalTitle"
  aria-hidden="true"
  data-roleplay-modify-modal
  data-bs-backdrop="static"
  data-bs-keyboard="false"
  data-roleplay-modify-endpoint="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit/modify"
  data-roleplay-modify-apply-endpoint="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit/modify/apply"
  data-roleplay-modify-discard-endpoint="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit/modify/discard"
  data-generic-error="<%= t('roleplays.modificationFailed') %>"
  data-current-label="<%= t('roleplays.currentVersion') %>"
  data-proposed-label="<%= t('roleplays.proposedVersion') %>"
  data-field-title="<%= t('quizzes.titleLabel') %>"
  data-field-description="<%= t('roleplays.generalDescriptionField') %>"
  data-field-level="<%= t('quizzes.level') %>"
  data-field-learner-name="<%= t('roleplays.learnerNameField') %>"
  data-field-learner-description="<%= t('roleplays.learnerDescriptionField') %>"
  data-field-learner-avatarid="<%= t('roleplays.learnerAvatarField') %>"
  data-field-ai-name="<%= t('roleplays.aiNameField') %>"
  data-field-ai-description="<%= t('roleplays.aiDescriptionField') %>"
  data-field-ai-avatarid="<%= t('roleplays.aiAvatarField') %>"
  data-no-avatar-label="<%= t('roleplays.noAvatar') %>"
  data-apply-label="<%= t('roleplays.approveAndSave') %>"
  data-applying-label="<%= t('roleplays.approvingChanges') %>"
>
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5" id="roleplayModifyModalTitle"><%= t('roleplays.modifyRoleplayTitle') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>" data-roleplay-modify-dismiss></button>
      </div>
      <div class="modal-body">
          <div data-roleplay-modify-phase="describe">
            <label class="form-label" for="roleplayModificationRequest"><%= t('roleplays.modificationLabel') %></label>
            <textarea
              class="form-control"
              id="roleplayModificationRequest"
              name="requestedChange"
              rows="5"
              minlength="3"
              maxlength="2000"
              required
              data-roleplay-modify-request
              placeholder="<%= t('roleplays.modificationPlaceholder') %>"
            ></textarea>
            <div class="form-text"><%= t('roleplays.modificationHelp') %></div>
          </div>

          <div class="text-center py-4 d-none" data-roleplay-modify-phase="generating">
            <div class="spinner-border text-primary mb-3" role="status">
              <span class="visually-hidden"><%= t('common.loading') %></span>
            </div>
            <p class="mb-0 fw-semibold"><%= t('roleplays.generatingProposal') %></p>
          </div>

          <div class="d-none" data-roleplay-modify-phase="preview">
            <p class="text-body-secondary"><%= t('roleplays.reviewModificationHelp') %></p>
            <div data-roleplay-modify-comparison></div>
          </div>

          <div class="alert alert-danger d-none mb-0" role="alert" data-roleplay-modify-error>
            <span data-roleplay-modify-error-message><%= t('roleplays.modificationFailed') %></span>
            <a
              class="alert-link d-none ms-1"
              href="/credits?returnTo=<%= encodeURIComponent(`/roleplays/${selectedRoleplay.id}/edit`) %>"
              data-roleplay-modify-credit-link
            ><%= t('credits.buyCredits') %></a>
          </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-roleplay-modify-dismiss><%= t('common.cancel') %></button>
        <button class="btn btn-outline-primary d-none" type="button" data-roleplay-modify-retry>
          <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i><%= t('roleplays.tryAnotherModification') %>
        </button>
        <button class="btn btn-primary" type="button" data-roleplay-modify-generate>
          <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('roleplays.generateProposal') %>
        </button>
        <button class="btn btn-primary d-none" type="button" data-roleplay-modify-apply>
          <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true" data-roleplay-modify-apply-spinner></span>
          <i class="bi bi-check-lg me-1" aria-hidden="true" data-roleplay-modify-apply-icon></i><span data-roleplay-modify-apply-label><%= t('roleplays.approveAndSave') %></span>
        </button>
      </div>
    </div>
  </div>
</div>

<div
  class="modal fade"
  id="roleplayAvatarSelectorModal"
  tabindex="-1"
  aria-labelledby="roleplayAvatarSelectorTitle"
  aria-hidden="true"
  data-roleplay-avatar-selector-modal
>
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5" id="roleplayAvatarSelectorTitle"><%= t('roleplays.chooseAvatar') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body">
        <div class="roleplay-avatar-grid" role="list" aria-label="<%= t('roleplays.availableAvatarsAria') %>">
          <button
            class="roleplay-avatar-option"
            type="button"
            data-roleplay-avatar-option
            data-avatar-id=""
            data-avatar-name="<%= t('roleplays.noAvatar') %>"
            data-avatar-src=""
            role="listitem"
          >
            <span class="roleplay-avatar-option-image" aria-hidden="true">
              <i class="bi bi-person"></i>
            </span>
            <span class="roleplay-avatar-option-name"><%= t('roleplays.noAvatar') %></span>
            <span class="roleplay-avatar-option-meta"><%= t('roleplays.useIcon') %></span>
          </button>
          <% roleplayAvatarOptions.forEach((avatar) => { %>
            <button
              class="roleplay-avatar-option"
              type="button"
              data-roleplay-avatar-option
              data-avatar-id="<%= avatar.id %>"
              data-avatar-name="<%= avatar.name %>"
              data-avatar-src="<%= avatar.imagePath %>"
              role="listitem"
            >
              <span class="roleplay-avatar-option-image" aria-hidden="true">
                <img src="<%= avatar.imagePath %>" alt="">
              </span>
              <span class="roleplay-avatar-option-name"><%= avatar.name %></span>
              <span class="roleplay-avatar-option-meta"><%= avatar.age %> · <%= avatar.gender %></span>
            </button>
          <% }) %>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-shell-close', { pageScriptPartial: 'roleplays-client-script' }) %>
