<%- include('partials/app-shell-open') %>

<%
  const quizNewFolderPath = Array.isArray(originFolderPath) ? originFolderPath : [];
  const quizNewFolderId = typeof originFolderId === 'string' ? originFolderId : null;
  const quizNewCloseHref = quizNewFolderId
    ? `/resources/folders/${encodeURIComponent(quizNewFolderId)}`
    : '/resources';
%>

<section class="app-page quizzes-page">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <p class="app-page-kicker"><%= t('quizzes.kicker') %></p>
      <h1><%= t('quizzes.newTitle') %></h1>
      <%- include('partials/breadcrumb', { crumbs: [
        { label: t('resources.title'), href: '/resources' },
        ...quizNewFolderPath.map((folder) => ({
          label: folder.title,
          href: `/resources/folders/${encodeURIComponent(folder.id)}`,
        })),
        { label: t('quizzes.newTitle') },
      ] }) %>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="<%= quizNewCloseHref %>"
        title="<%= t('common.close') %>"
        aria-label="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (generationError) { %>
    <div class="alert alert-danger" role="alert"><%= generationError %></div>
  <% } %>

  <div class="card resource-form-card">
    <div class="card-body">
      <form method="post" action="/quizzes/generate" data-quiz-generate-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (quizNewFolderId) { %><input type="hidden" name="folderId" value="<%= quizNewFolderId %>"><% } %>
        <div class="mb-3">
          <label class="form-label" for="quizPrompt"><%= t('quizzes.describeLabel') %></label>
          <textarea
            class="form-control"
            id="quizPrompt"
            name="prompt"
            rows="10"
            required
            placeholder="<%= t('quizzes.describePlaceholder') %>"
          ><%= generationPrompt || '' %></textarea>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-primary" type="submit" data-quiz-generate-submit>
            <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.create') %>
          </button>
          <a class="btn btn-outline-secondary" href="/resources"><%= t('common.cancel') %></a>
        </div>
      </form>
    </div>
  </div>
</section>

<div class="modal fade" tabindex="-1" aria-hidden="true" data-quiz-pending-modal>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body d-flex align-items-center gap-3">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <p class="mb-0"><%= t('quizzes.creating') %></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-shell-close', { pageScriptPartial: 'quizzes-client-script' }) %>
