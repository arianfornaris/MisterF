<%- include('partials/app-shell-open') %>

<section class="app-page roleplays-page roleplay-attempt-page">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <%- include('partials/resource-page-kicker', { resourceType: 'roleplay' }) %>
      <h1 class="app-page-title"><%= draft.title %></h1>
      <% if (isAuthenticated) { %>
        <%- include('partials/breadcrumb', { crumbs: [
          { label: t('resources.title'), href: '/resources' },
          { label: draft.title, href: `/roleplays/${encodeURIComponent(attempt.roleplayId)}` },
          { label: t('roleplays.attemptKicker') },
        ] }) %>
      <% } %>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="/roleplays/<%= encodeURIComponent(attempt.roleplayId) %>"
        aria-label="<%= t('common.close') %>"
        title="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <div
    class="alert alert-danger mt-3 <%= attemptError ? '' : 'd-none' %>"
    role="alert"
    data-roleplay-turn-error
  ><%= attemptError %></div>

  <div class="roleplay-stage">
    <div
      class="roleplay-transcript"
      data-roleplay-transcript
      data-learner-name="<%= learnerCharacter.name %>"
      data-ai-name="<%= aiCharacter.name %>"
      data-learner-avatar-src="<%= learnerAvatar ? learnerAvatar.imagePath : '' %>"
      data-ai-avatar-src="<%= aiAvatar ? aiAvatar.imagePath : '' %>"
    >
      <article class="roleplay-turn is-context">
        <div class="roleplay-turn-avatar" aria-hidden="true">
          <i class="bi bi-compass"></i>
        </div>
        <div class="roleplay-turn-body">
          <div class="roleplay-turn-speaker"><%= t('resources.description') %></div>
          <div class="roleplay-turn-text resource-markdown" data-render-markdown><%= draft.description %></div>
          <div class="resource-meta-row mt-2">
            <span><i class="bi bi-person" aria-hidden="true"></i> <%= t('roleplays.youLabel') %> <%= learnerCharacter.name %></span>
            <span><i class="bi bi-person-video3" aria-hidden="true"></i> <%= t('roleplays.aiLabel') %> <%= aiCharacter.name %></span>
          </div>
        </div>
      </article>
      <% attempt.turns.forEach((turn) => { %>
        <% const isLearner = turn.speaker === 'learner'; %>
        <% const speaker = isLearner ? learnerCharacter : aiCharacter; %>
        <% const speakerAvatar = isLearner ? learnerAvatar : aiAvatar; %>
        <article class="roleplay-turn <%= isLearner ? 'is-learner' : 'is-ai' %>">
          <div class="roleplay-turn-avatar" aria-hidden="true">
            <% if (speakerAvatar) { %>
              <img src="<%= speakerAvatar.imagePath %>" alt="">
            <% } else { %>
              <i class="bi <%= isLearner ? 'bi-person' : 'bi-person-video3' %>"></i>
            <% } %>
          </div>
          <div class="roleplay-turn-body">
            <div class="roleplay-turn-speaker"><%= speaker.name %></div>
            <div class="<%= isLearner ? 'roleplay-turn-text' : 'inline-character-text' %> resource-markdown" data-render-markdown><%= turn.text %></div>
          </div>
        </article>
      <% }) %>
    </div>

    <% if (attempt.status === 'in_progress') { %>
      <form class="roleplay-response-form" method="post" action="/roleplay-attempts/<%= encodeURIComponent(attempt.id) %>/turns" data-roleplay-turn-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="visually-hidden" for="roleplayTurnText"><%= t('roleplays.yourTurnLabel', { name: learnerCharacter.name }) %></label>
          <div class="roleplay-response-input-wrap">
            <textarea
              class="roleplay-response-textarea"
              id="roleplayTurnText"
              name="text"
              rows="2"
              placeholder="<%= t('roleplays.yourTurnPlaceholder', { name: learnerCharacter.name }) %>"
              required
              autofocus
            ></textarea>
          </div>
          <div class="roleplay-response-actions">
            <button
              class="btn btn-outline-secondary"
              type="submit"
              form="finishRoleplayAttemptForm"
            >
              <%= t('chat.finalize') %>
            </button>
            <button
              class="btn btn-primary ms-auto"
              type="submit"
              data-roleplay-pending-submit
              data-loading-text="<%= t('roleplays.continuing') %>"
            >
              <i class="bi bi-send me-1" aria-hidden="true"></i><%= t('roleplays.sendTurn') %>
            </button>
          </div>
      </form>
      <form id="finishRoleplayAttemptForm" class="d-none" method="post" action="/roleplay-attempts/<%= encodeURIComponent(attempt.id) %>/finish" data-roleplay-pending-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
    <% } else if (attempt.status === 'failed') { %>
      <form method="post" action="/roleplay-attempts/<%= encodeURIComponent(attempt.id) %>/finish" data-roleplay-pending-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary" type="submit" data-roleplay-pending-submit data-loading-text="<%= t('roleplays.evaluating') %>">
          <%= t('roleplays.retryEvaluation') %>
        </button>
      </form>
    <% } else { %>
      <div class="alert alert-info mb-0" role="status"><%= t('roleplays.beingEvaluated') %></div>
    <% } %>
  </div>
</section>

<%- include('partials/roleplay-pending-modal', {
  roleplayPendingMessage: t('roleplays.processing'),
}) %>

<%- include('partials/app-shell-close', { pageScriptPartial: 'roleplays-client-script' }) %>
