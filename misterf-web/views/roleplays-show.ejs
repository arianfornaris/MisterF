<%- include('partials/app-shell-open') %>

<%
  const roleplayCurrentFolder = resourceCurrentFolder || null;
  const roleplayFolderOptions = Array.isArray(resourceFolderOptions) ? resourceFolderOptions : [];
  const roleplayFolderPath = Array.isArray(resourceFolderPath) ? resourceFolderPath : [];
  const showRoleplayMoveOption = canManageRoleplay && !selectedRoleplay.archivedAt && (roleplayCurrentFolder || roleplayFolderOptions.length > 0);
%>

<section class="app-page roleplays-page">
  <div class="app-page-header app-page-header-detail">
    <div>
      <%- include('partials/resource-page-kicker', { resourceType: 'roleplay' }) %>
      <h1 class="app-page-title"><%= selectedRoleplay.title %></h1>
      <%- include('partials/breadcrumb', { crumbs: [
        { label: t('resources.title'), href: '/resources' },
        ...roleplayFolderPath.map((folder) => ({
          label: folder.title,
          href: `/resources/folders/${encodeURIComponent(folder.id)}`,
        })),
        { label: selectedRoleplay.title },
      ] }) %>
    </div>
  </div>

  <% if (roleplayStartError) { %>
    <div class="alert alert-warning" role="alert"><%= roleplayStartError %></div>
  <% } %>

  <div class="resource-action-row">
    <form
      method="post"
      action="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/attempts"
      data-roleplay-pending-form
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button
        class="btn btn-primary"
        type="submit"
        data-roleplay-pending-submit
        data-loading-text="<%= t('roleplays.starting') %>"
      >
        <i class="bi bi-play-circle me-1" aria-hidden="true"></i><%= t('resources.start') %>
      </button>
    </form>
    <% if (canManageRoleplay) { %>
      <div class="dropdown">
        <button
          class="btn btn-secondary dropdown-toggle"
          type="button"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          <%= t('resources.options') %>
        </button>
        <ul class="dropdown-menu">
          <% if (!selectedRoleplay.archivedAt) { %>
            <% if (showRoleplayMoveOption) { %>
              <li>
                <button
                  class="dropdown-item"
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#moveResourceModal"
                  data-resource-move-open
                  data-resource-id="<%= selectedRoleplay.id %>"
                  data-resource-title="<%= selectedRoleplay.title %>"
                  data-resource-type="roleplay"
                  data-current-folder-id="<%= roleplayCurrentFolder ? roleplayCurrentFolder.id : '' %>"
                >
                  <i class="bi bi-folder-symlink me-2" aria-hidden="true"></i><%= t('resources.moveToFolder') %>
                </button>
              </li>
            <% } %>
            <li>
              <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#roleplayShareProfileModal">
                <i class="bi bi-person me-2" aria-hidden="true"></i><%= t('resources.shareWithProfile') %>
              </button>
            </li>
            <li>
              <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#roleplayShareLinkModal">
                <i class="bi bi-share me-2" aria-hidden="true"></i><%= t('resources.share') %>
              </button>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <a class="dropdown-item" href="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/edit">
                <i class="bi bi-pencil me-2" aria-hidden="true"></i><%= t('roleplays.editRoleplay') %>
              </a>
            </li>
            <li><hr class="dropdown-divider"></li>
          <% } %>
          <li>
            <form method="post" action="/resources/<%= encodeURIComponent(selectedRoleplay.id) %>/<%= selectedRoleplay.archivedAt ? 'restore' : 'archive' %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>">
              <button class="dropdown-item" type="submit">
                <i class="bi <%= selectedRoleplay.archivedAt ? 'bi-arrow-counterclockwise' : 'bi-archive' %> me-2" aria-hidden="true"></i>
                <%= selectedRoleplay.archivedAt ? t('roleplays.restoreRoleplay') : t('roleplays.archiveRoleplay') %>
              </button>
            </form>
          </li>
        </ul>
      </div>
    <% } %>
  </div>

  <div class="resource-detail-summary">
    <div class="resource-markdown mb-2" data-render-markdown><%= selectedRoleplay.description || t('quizzes.noDescription') %></div>
    <div class="resource-meta-row">
      <% if (draft.level) { %><span><i class="bi bi-bar-chart" aria-hidden="true"></i> <%= draft.level %></span><% } %>
      <span><i class="bi bi-people" aria-hidden="true"></i> <%= learnerCharacter.name %> / <%= aiCharacter.name %></span>
    </div>
  </div>

  <% if (selectedRoleplay.sharedVia || !canManageRoleplay) { %>
    <div class="d-flex">
      <% if (selectedRoleplaySharedFromProfileName) { %>
        <span class="badge text-bg-light border" role="status"><%= t('quizzes.sharedBy', { name: selectedRoleplaySharedFromProfileName }) %></span>
      <% } else { %>
        <span class="badge text-bg-light border" role="status"><%= t('resources.shared') %></span>
      <% } %>
    </div>
  <% } %>

  <% if (canManageRoleplay) { %>
    <section class="resource-section">
      <div class="card">
        <div class="card-body">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h2 class="h5 mb-0"><%= t('quizzes.participantsSectionTitle') %></h2>
            <a class="btn btn-outline-secondary btn-sm" href="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/participation">
              <i class="bi bi-people me-1" aria-hidden="true"></i><%= t('quizzes.participationLink') %>
            </a>
          </div>
          <% if (roleplayParticipationCounts.submissions === 0) { %>
            <p class="text-body-secondary mb-0"><%= t('quizzes.participantsEmpty') %></p>
          <% } else { %>
            <div class="resource-meta-row">
              <span><i class="bi bi-check-circle" aria-hidden="true"></i> <%= t('resources.participantsCompletedCount', { count: roleplayParticipationCounts.completed }) %></span>
              <span><i class="bi bi-inbox" aria-hidden="true"></i> <%= t('resources.participantsSubmissionsCount', { count: roleplayParticipationCounts.submissions }) %></span>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  <% } %>

  <section class="resource-section">
    <h2 class="h5"><%= t('roleplays.characters') %></h2>
    <div class="row g-3">
      <% draft.characters.forEach((character) => { %>
        <% const characterAvatar = character.avatarId ? roleplayAvatarById[character.avatarId] : null; %>
        <div class="col-12 col-md-6">
          <article class="card h-100 roleplay-character-card <%= character.id === 'learner' ? 'is-learner' : 'is-ai' %>">
            <div class="card-body">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="roleplay-character-icon" aria-hidden="true">
                  <% if (characterAvatar) { %>
                    <img src="<%= characterAvatar.imagePath %>" alt="">
                  <% } else { %>
                    <i class="bi <%= character.id === 'learner' ? 'bi-person' : 'bi-person-video3' %>"></i>
                  <% } %>
                </span>
                <div>
                  <h3 class="h6 mb-0"><%= character.name %></h3>
                  <p class="small text-body-secondary mb-0"><%= character.id === 'learner' ? t('roleplays.playedByStudent') : t('roleplays.playedByAi') %></p>
                </div>
              </div>
              <p class="mb-0"><%= character.description %></p>
            </div>
          </article>
        </div>
      <% }) %>
    </div>
  </section>

  <%# Mirrors the quiz detail page: the owner's own attempts here are their test
      runs, and they already have the Participantes card for other people's
      attempts, so this list only serves a non-owner recipient who needs to
      reach their own result. %>
  <% if (!canManageRoleplay) { %>
  <section class="resource-section">
    <h2 class="h5"><%= t('roleplays.attemptsTitle') %></h2>
    <% if (roleplayAttempts.length > 0) { %>
      <div class="list-group">
        <% roleplayAttempts.forEach((attempt) => { %>
          <a class="list-group-item list-group-item-action" href="/roleplay-attempts/<%= encodeURIComponent(attempt.id) %><%= attempt.status === 'evaluated' ? '/result' : '' %>">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
              <span>
                <%= t('roleplays.attempt') %>
                <span class="badge <%= attempt.statusBadgeClass %> ms-1"><%= attempt.statusLabel %></span>
                <span class="text-body-secondary ms-1"><%= attempt.learnerTurnCount %> <%= t('roleplays.turnsSuffix') %></span>
              </span>
              <span class="text-body-secondary"><%= attempt.relativeUpdatedAt %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-body-secondary mb-0"><%= t('roleplays.noAttempts') %></p>
    <% } %>
  </section>
  <% } %>
</section>

<% if (canManageRoleplay) { %>
  <div
    class="modal fade"
    id="roleplayShareProfileModal"
    tabindex="-1"
    aria-labelledby="roleplayShareProfileModalLabel"
    aria-hidden="true"
    <%= roleplayShareMode === 'profile' ? 'data-auto-open-roleplay-share-modal' : '' %>
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="roleplayShareProfileModalLabel"><%= t('resources.shareWithProfile') %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
        </div>
        <div class="modal-body">
          <% if (shareTargetRoleplayProfiles.length > 0) { %>
            <form method="post" action="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>/share/profile" class="d-grid gap-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div>
                <label class="form-label" for="shareTargetRoleplayProfileId"><%= t('resources.targetProfile') %></label>
                <select class="form-select" id="shareTargetRoleplayProfileId" name="targetProfileId" required>
                  <% shareTargetRoleplayProfiles.forEach((profile) => { %>
                    <option value="<%= profile.id %>"><%= profile.name %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <div class="form-check form-switch mb-1">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    role="switch"
                    id="roleplayShareProfileCollectResults"
                    name="collectResults"
                    checked
                  >
                  <label class="form-check-label" for="roleplayShareProfileCollectResults">
                    <%= t('resources.shareCollectResultsLabel') %>
                  </label>
                </div>
                <p class="form-text mb-0"><%= t('resources.shareCollectResultsProfileHint') %></p>
              </div>
              <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                <button type="submit" class="btn btn-primary"><%= t('resources.shareNow') %></button>
              </div>
            </form>
          <% } else { %>
            <p class="mb-0 text-body-secondary"><%= t('roleplays.noOtherProfiles') %></p>
          <% } %>
        </div>
        <% if (shareTargetRoleplayProfiles.length === 0) { %>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div
    class="modal fade"
    id="roleplayShareLinkModal"
    tabindex="-1"
    aria-labelledby="roleplayShareLinkModalLabel"
    aria-hidden="true"
    <%= roleplayShareMode === 'link' ? 'data-auto-open-roleplay-share-modal' : '' %>
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="roleplayShareLinkModalLabel"><%= t('resources.shareLinkTitle') %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
        </div>
        <div class="modal-body d-grid gap-3">
          <p class="mb-0 text-body-secondary"><%= t('roleplays.shareLinkBody') %></p>
          <div>
            <form
              method="post"
              action="/resources/<%= encodeURIComponent(selectedRoleplay.id) %>/share/collect-results"
              class="form-check form-switch mb-1"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="/roleplays/<%= encodeURIComponent(selectedRoleplay.id) %>?share=link">
              <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="roleplayShareCollectResults"
                name="collectResults"
                <%= shareLink && shareLink.collectResults ? 'checked' : '' %>
                onchange="this.form.requestSubmit()"
              >
              <label class="form-check-label" for="roleplayShareCollectResults">
                <%= t('resources.shareCollectResultsLabel') %>
              </label>
            </form>
            <p class="form-text mb-0"><%= t('resources.shareCollectResultsHint') %></p>
          </div>
          <label class="form-label" for="roleplayShareLink"><%= t('resources.link') %></label>
          <input class="form-control" id="roleplayShareLink" value="<%= shareUrl %>" readonly data-roleplay-share-link-field>
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary" type="button" data-copy-roleplay-share-link>
              <i class="bi bi-copy me-1" aria-hidden="true"></i><%= t('resources.copy') %>
            </button>
            <button class="btn btn-outline-secondary" type="button" data-native-share-roleplay-link>
              <i class="bi bi-share me-1" aria-hidden="true"></i><%= t('resources.share') %>
            </button>
          </div>
          <% if (roleplayShareQrDataUrl) { %>
            <div class="d-flex justify-content-center">
              <img src="<%= roleplayShareQrDataUrl %>" alt="<%= t('roleplays.qrAlt') %>" width="180" height="180">
            </div>
          <% } %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/resource-move-modal', {
    resourceMoveCurrentFolder: roleplayCurrentFolder,
    resourceMoveFolderOptions: roleplayFolderOptions,
  }) %>
<% } %>

<%- include('partials/roleplay-pending-modal', {
  roleplayPendingMessage: t('roleplays.starting'),
}) %>

<%- include('partials/app-shell-close', { pageScriptPartial: 'roleplays-client-script' }) %>
