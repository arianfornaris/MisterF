<%- include('partials/app-shell-open') %>

<section class="app-resource-view" aria-label="<%= t('settings.title') %>">
  <div class="resource-page-header">
    <div>
      <p class="resource-page-kicker"><%= t('settings.kicker') %></p>
      <h1 class="resource-page-title"><%= t('settings.title') %></h1>
      <p class="resource-page-copy">
        <%= t('settings.intro') %>
      </p>
    </div>
  </div>

  <% if (activeProfile) { %>
    <section class="resource-page-detail-shell">
      <div class="resource-page-section-copy">
        <p class="resource-page-section-kicker"><%= t('settings.languageSectionKicker') %></p>
        <div class="card shadow-sm">
          <div class="card-body">
            <h2 class="h4 mb-1"><%= t('settings.languageTitle') %></h2>
            <p class="text-body-secondary">
              <%= t('settings.languageCopy') %>
            </p>
            <form method="post" action="/settings/language" class="d-flex flex-wrap align-items-center gap-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="btn-group" role="group" aria-label="<%= t('settings.languageTitle') %>">
                <% languages.forEach((language) => { %>
                  <input
                    class="btn-check"
                    type="radio"
                    name="instructionLanguage"
                    id="settingsLanguage-<%= language.code %>"
                    value="<%= language.code %>"
                    <%= activeProfile.instructionLanguage === language.code ? 'checked' : '' %>
                  >
                  <label class="btn btn-outline-secondary" for="settingsLanguage-<%= language.code %>"><%= language.endonym %></label>
                <% }) %>
              </div>
              <button type="submit" class="btn btn-primary"><%= t('settings.languageSave') %></button>
            </form>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <section class="resource-page-detail-shell">
    <div class="resource-page-section-copy">
      <p class="resource-page-section-kicker"><%= t('settings.securityKicker') %></p>
      <div class="card shadow-sm">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-start gap-3">
          <div>
            <h2 class="h4 mb-1"><%= t('settings.passwordTitle') %></h2>
            <p class="mb-0 text-body-secondary">
              <%= t('settings.passwordCopy') %>
            </p>
          </div>
          <a class="btn btn-secondary" href="/change-password"><%= t('settings.changePassword') %></a>
        </div>
      </div>
    </div>
  </section>
</section>

<%- include('partials/app-shell-close') %>
