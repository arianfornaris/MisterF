<%- include('partials/app-shell-open') %>

<section class="app-page" aria-label="<%= t('settings.title') %>">
  <div class="app-page-header">
    <div>
      <p class="app-page-kicker"><%= t('settings.kicker') %></p>
      <h1 class="app-page-title"><%= t('settings.title') %></h1>
      <p class="app-page-copy">
        <%= t('settings.intro') %>
      </p>
    </div>
  </div>

  <section class="app-page-detail-shell">
    <div class="app-page-section-copy">
      <p class="app-page-kicker"><%= t('settings.securityKicker') %></p>
      <div class="card shadow-sm">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-start gap-3">
          <div>
            <h2 class="h4 mb-1"><%= t('settings.passwordTitle') %></h2>
            <p class="mb-0 text-body-secondary">
              <%= t('settings.passwordCopy') %>
            </p>
          </div>
          <a class="btn btn-secondary" href="/change-password"><%= t('settings.changePassword') %></a>
        </div>
      </div>
    </div>
  </section>
</section>

<%- include('partials/app-shell-close') %>
