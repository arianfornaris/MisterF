<!doctype html>
<html lang="<%= htmlLang %>">
  <head>
    <%- include('partials/document-head', { includeBootstrapIcons: true }) %>
  </head>
  <body>
    <main class="container min-vh-100 d-flex align-items-center py-5">
      <section class="row justify-content-center w-100" aria-label="<%= t('profiles.onbAria') %>">
        <div class="col-12 col-sm-10 col-lg-8 col-xl-7">
          <div class="card shadow-sm">
            <div class="card-body p-4 p-md-5">
              <div class="mb-4">
                <p class="text-uppercase text-body-secondary small fw-semibold mb-2"><%= t('profiles.onbKicker') %></p>
                <h1 class="h3 mb-2"><%= t('profiles.onbTitle') %></h1>
                <p class="text-body-secondary mb-0">
                  <%= t('profiles.onbIntro') %>
                </p>
              </div>

              <% if (error) { %>
                <div class="alert alert-danger" role="alert"><%= error %></div>
              <% } %>

              <form class="d-grid gap-3" method="post" action="/profiles/onboarding">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="returnTo" value="<%= returnTo %>">

                <div>
                  <label class="form-label" for="onboardingProfileName"><%= t('profiles.onbNameLabel') %></label>
                  <input
                    class="form-control"
                    id="onboardingProfileName"
                    name="name"
                    maxlength="<%= profileFieldLimits.name %>"
                    value="<%= values.name %>"
                    required
                    autofocus
                  >
                  <div class="form-text">
                    <%= t('profiles.onbNameHelp') %>
                  </div>
                </div>

                <fieldset>
                  <legend class="form-label mb-1"><%= t('profiles.languageLegend') %></legend>
                  <p class="form-text mt-0 mb-2" id="onboardingInstructionLanguageHelp">
                    <%= t('profiles.languageHelpOnboarding') %>
                  </p>
                  <div class="list-group" aria-describedby="onboardingInstructionLanguageHelp">
                    <label class="list-group-item d-flex gap-3">
                      <input
                        class="form-check-input flex-shrink-0 mt-1"
                        type="radio"
                        name="instructionLanguage"
                        value="es"
                        <%= values.instructionLanguage !== 'en' ? 'checked' : '' %>
                      >
                      <span class="d-block">
                        <span class="fw-semibold d-block">Español</span>
                        <small class="text-body-secondary"><%= t('profiles.spanishDescOnboarding') %></small>
                      </span>
                    </label>
                    <label class="list-group-item d-flex gap-3">
                      <input
                        class="form-check-input flex-shrink-0 mt-1"
                        type="radio"
                        name="instructionLanguage"
                        value="en"
                        <%= values.instructionLanguage === 'en' ? 'checked' : '' %>
                      >
                      <span class="d-block">
                        <span class="fw-semibold d-block">English</span>
                        <small class="text-body-secondary"><%= t('profiles.englishDesc') %></small>
                      </span>
                    </label>
                  </div>
                </fieldset>

                <div>
                  <label class="form-label" for="onboardingProfileDescription"><%= t('profiles.onbDescLabel') %></label>
                  <textarea
                    class="form-control"
                    id="onboardingProfileDescription"
                    name="description"
                    rows="3"
                    maxlength="<%= profileFieldLimits.description %>"
                  ><%= values.description %></textarea>
                  <div class="form-text">
                    <%= t('profiles.onbDescHelp') %>
                  </div>
                </div>

                <div>
                  <label class="form-label" for="onboardingLearningContext"><%= t('profiles.context') %></label>
                  <textarea
                    class="form-control"
                    id="onboardingLearningContext"
                    name="learningContext"
                    rows="7"
                    maxlength="<%= profileFieldLimits.learningContext %>"
                    aria-describedby="onboardingLearningContextHelp"
                  ><%= values.learningContext %></textarea>
                  <div class="form-text" id="onboardingLearningContextHelp">
                    <%= t('profiles.onbContextHelp') %>
                  </div>
                </div>

                <div class="pt-2">
                  <button class="btn btn-primary" type="submit"><%= t('profiles.save') %></button>
                </div>
              </form>

              <form class="mt-3" method="post" action="/profiles/onboarding/skip">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="returnTo" value="<%= returnTo %>">
                <button class="btn btn-secondary" type="submit"><%= t('profiles.skip') %></button>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>
    <%- include('partials/legal-footer') %>
  </body>
</html>
