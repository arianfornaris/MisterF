<%- include('partials/app-shell-open') %>

<section class="app-page resources-page">
  <div class="app-page-header">
    <div>
      <p class="app-page-kicker"><%= t('resources.sharedResourceKicker') %></p>
      <h1 class="app-page-title"><%= sharedResource.title %></h1>
      <% if (quizTakeAction) { %>
        <p class="app-page-copy">
          <%= t('resources.quizTakeCopy') %>
        </p>
      <% } else { %>
        <p class="app-page-copy">
          <%= t('resources.addToProfileCopy') %>
        </p>
      <% } %>
    </div>
  </div>

  <section class="app-page-detail-shell">
    <div class="d-grid gap-4">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge rounded-pill <%= sharedResource.badgeClass %>">
          <i class="bi <%= sharedResource.iconClass %> me-1" aria-hidden="true"></i>
          <%= sharedResource.label %>
        </span>
        <span class="badge text-bg-light border"><%= t('resources.shared') %></span>
      </div>

      <% if (sharedResource.description) { %>
        <div class="resource-markdown" data-render-markdown><%= sharedResource.description %></div>
      <% } %>

      <% if ((quizTakeAction || startAction) && shareLink.collectResults) { %>
        <div class="alert alert-info d-flex align-items-start gap-2 mb-0" role="note">
          <i class="bi bi-eye flex-shrink-0" aria-hidden="true"></i>
          <span><%= t('resources.sharedResultsNotice') %></span>
        </div>
      <% } %>

      <% if (quizTakeAction) { %>
        <form method="post" action="<%= quizTakeAction %>" class="d-flex flex-wrap justify-content-end gap-2 align-items-center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <a class="btn btn-link" href="/resources"><%= t('resources.notNow') %></a>
          <button class="btn btn-primary" type="submit">
            <i class="bi bi-play-fill me-1" aria-hidden="true"></i><%= t('resources.takeQuiz') %>
          </button>
        </form>
      <% } else if (startAction) { %>
        <div class="d-flex flex-wrap justify-content-end gap-2 align-items-center">
          <a class="btn btn-link" href="/resources"><%= t('resources.notNow') %></a>
          <a class="btn btn-primary" href="<%= startAction %>" data-shared-resource-start>
            <i class="bi bi-play-fill me-1" aria-hidden="true"></i><%= t('resources.start') %>
          </a>
        </div>
      <% } else { %>
        <div class="d-flex flex-wrap justify-content-end gap-2">
          <a class="btn btn-secondary" href="/resources"><%= t('resources.notNow') %></a>
          <% if (isAuthenticated && activeProfile) { %>
            <form method="post" action="/resources/shared/<%= encodeURIComponent(shareLink.id) %>/accept">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-primary" type="submit"><%= t('resources.addToMyResources') %></button>
            </form>
          <% } else { %>
            <a class="btn btn-secondary" href="/signup?returnTo=<%= encodeURIComponent(returnTo) %>"><%= t('nav.createAccount') %></a>
            <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent(returnTo) %>"><%= t('nav.signIn') %></a>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>
</section>

<% if (startAction) { %>
  <div
    class="modal fade"
    tabindex="-1"
    aria-hidden="true"
    data-shared-resource-pending-modal
    data-bs-backdrop="static"
    data-bs-keyboard="false"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body d-flex align-items-center gap-3">
          <div class="spinner-border text-primary" aria-hidden="true"></div>
          <p class="mb-0"><%= t('resources.starting') %></p>
        </div>
      </div>
    </div>
  </div>
<% } %>

<%- include('partials/app-shell-close', { pageScriptPartial: 'resources-client-script' }) %>
