<%- include('partials/app-shell-open') %>

<section class="app-page practice-guides-page">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <p class="app-page-kicker"><%= t('practiceGuides.editingKicker') %></p>
      <h1><%= selectedPracticeGuide.title %></h1>
      <form class="d-inline-block mt-3" method="post" action="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/chats">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary" type="submit">
          <i class="bi bi-play-circle me-1" aria-hidden="true"></i><%= t('quizzes.test') %>
        </button>
      </form>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>"
        title="<%= t('common.close') %>"
        aria-label="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (authoringError) { %>
    <div class="alert alert-danger" role="alert"><%= authoringError %></div>
  <% } %>

  <ul class="nav nav-pills authoring-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'general' ? 'active' : '' %>"
        href="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit?tab=general"
        role="tab"
        aria-selected="<%= activeTab === 'general' ? 'true' : 'false' %>"
      >
        <i class="bi bi-card-text me-1" aria-hidden="true"></i><%= t('quizzes.tabGeneral') %>
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'chat' ? 'active' : '' %>"
        href="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit?tab=chat"
        role="tab"
        aria-selected="<%= activeTab === 'chat' ? 'true' : 'false' %>"
      >
        <i class="bi bi-chat-dots me-1" aria-hidden="true"></i><%= t('quizzes.tabChat') %>
      </a>
    </li>
  </ul>

  <% if (activeTab === 'general') { %>
    <form class="card resource-form-card" method="post" action="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit/save" autocomplete="off">
      <div class="card-body">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label" for="practiceGuideTitle"><%= t('quizzes.titleLabel') %></label>
            <input class="form-control" id="practiceGuideTitle" name="title" maxlength="120" value="<%= selectedPracticeGuide.title %>" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="practiceGuideDescription"><%= t('resources.description') %></label>
            <textarea
              class="form-control"
              id="practiceGuideDescription"
              name="description"
              rows="4"
              maxlength="500"
              required
              placeholder="<%= t('practiceGuides.descriptionPlaceholder') %>"
              data-markdown-editor
              data-markdown-editor-required="true"
              data-markdown-editor-error="practiceGuideDescriptionError"
              data-markdown-editor-min-height="8rem"
            ><%= selectedPracticeGuide.description %></textarea>
            <div class="invalid-feedback" id="practiceGuideDescriptionError" hidden>
              <%= t('practiceGuides.descriptionError') %>
            </div>
          </div>
          <div class="col-12">
            <div class="practice-guide-help-row">
              <label class="form-label" for="practiceGuideTutorInstructions"><%= t('practiceGuides.tutorInstructions') %></label>
              <button
                class="btn btn-link practice-guide-help-button"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#practiceGuideHelpModal"
              >
                <i class="bi bi-question-circle me-1" aria-hidden="true"></i>
                <%= t('practiceGuides.help') %>
              </button>
            </div>
            <textarea
              class="form-control"
              id="practiceGuideTutorInstructions"
              name="tutorInstructions"
              rows="10"
              maxlength="4000"
              required
              placeholder="<%= t('practiceGuides.tutorInstructionsPlaceholder') %>"
              data-markdown-editor
              data-markdown-editor-required="true"
              data-markdown-editor-error="practiceGuideTutorInstructionsError"
              data-markdown-editor-min-height="18rem"
            ><%= selectedPracticeGuide.tutorInstructions %></textarea>
            <div class="invalid-feedback" id="practiceGuideTutorInstructionsError" hidden>
              <%= t('practiceGuides.tutorInstructionsError') %>
            </div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <button class="btn btn-primary" type="submit">
            <i class="bi bi-save me-1" aria-hidden="true"></i><%= t('quizzes.saveDetails') %>
          </button>
        </div>
      </div>
    </form>
  <% } %>

  <% if (activeTab === 'chat') { %>
    <div class="authoring-chat-panel">
      <div class="authoring-chat-context">
        <div class="authoring-chat-context-icon" aria-hidden="true">
          <i class="bi bi-stars"></i>
        </div>
        <div>
          <h2 class="authoring-chat-context-title"><%= t('practiceGuides.modifyWithAi') %></h2>
          <p class="authoring-chat-context-copy mb-0">
            <%= t('practiceGuides.modifyWithAiCopy') %>
          </p>
        </div>
      </div>
      <div class="authoring-chat-history messages" aria-label="<%= t('quizzes.authoringChatHistoryAria') %>" data-authoring-chat-history>
        <% if (practiceGuideAuthoringMessages.length === 0) { %>
          <article class="message-row is-model authoring-chat-message-row">
            <div class="message-bubble">
              <p class="authoring-chat-message-content mb-0"><%= t('practiceGuides.authoringChatEmpty') %></p>
            </div>
          </article>
        <% } else { %>
          <% practiceGuideAuthoringMessages.forEach((message) => { %>
            <article class="message-row <%= message.role === 'user' ? 'is-user' : 'is-model' %> authoring-chat-message-row">
              <div class="message-bubble">
                <p class="authoring-chat-message-content mb-0"><%= message.content %></p>
              </div>
            </article>
          <% }) %>
        <% } %>
      </div>
      <form
        class="composer authoring-chat-composer"
        method="post"
        action="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit/revise"
        data-authoring-chat-form
        data-authoring-chat-credits-return-to="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit?tab=chat"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="visually-hidden" for="practiceGuideRevisionMessage"><%= t('quizzes.message') %></label>
        <div class="composer-input-wrap">
          <textarea
            class="composer-input"
            id="practiceGuideRevisionMessage"
            name="message"
            rows="2"
            maxlength="4000"
            placeholder="<%= t('quizzes.describeChangesPlaceholder') %>"
            required
          ></textarea>
        </div>
        <div class="composer-footer">
          <button class="btn btn-primary authoring-chat-submit-button" type="submit" data-authoring-chat-submit>
            <i class="bi bi-stars me-1" aria-hidden="true"></i><%= t('quizzes.applyChanges') %>
          </button>
        </div>
      </form>
    </div>
  <% } %>
</section>

<div
  class="modal fade"
  id="practiceGuideHelpModal"
  tabindex="-1"
  aria-labelledby="practiceGuideHelpModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="practiceGuideHelpModalLabel"><%= t('practiceGuides.tutorInstructions') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">
          <%= t('practiceGuides.helpBody1') %>
        </p>
        <p class="mb-0 text-body-secondary">
          <%= t('practiceGuides.helpBody2') %>
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-shell-close', { pageScriptPartial: 'practice-guides-client-script' }) %>
