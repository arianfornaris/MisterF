<%- include('partials/app-shell-open') %>

<section class="app-resource-view practice-guides-page">
  <div class="resource-page-header resource-page-header-has-close">
    <div>
      <p class="resource-eyebrow">Guía de práctica en edición</p>
      <h1><%= selectedPracticeGuide.title %></h1>
      <form class="d-inline-block mt-3" method="post" action="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/chats">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary" type="submit">
          <i class="bi bi-play-circle me-1" aria-hidden="true"></i>Probar
        </button>
      </form>
    </div>
    <div class="resource-page-header-actions">
      <a
        class="resource-page-close-button"
        href="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>"
        title="Cerrar"
        aria-label="Cerrar"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (authoringError) { %>
    <div class="alert alert-danger" role="alert"><%= authoringError %></div>
  <% } %>

  <ul class="nav nav-pills quiz-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'general' ? 'active' : '' %>"
        href="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit?tab=general"
        role="tab"
        aria-selected="<%= activeTab === 'general' ? 'true' : 'false' %>"
      >
        <i class="bi bi-card-text me-1" aria-hidden="true"></i>General
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a
        class="nav-link <%= activeTab === 'chat' ? 'active' : '' %>"
        href="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit?tab=chat"
        role="tab"
        aria-selected="<%= activeTab === 'chat' ? 'true' : 'false' %>"
      >
        <i class="bi bi-chat-dots me-1" aria-hidden="true"></i>Chat IA
      </a>
    </li>
  </ul>

  <% if (activeTab === 'general') { %>
    <form class="card resource-form-card" method="post" action="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit/save" autocomplete="off">
      <div class="card-body">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label" for="practiceGuideTitle">Título</label>
            <input class="form-control" id="practiceGuideTitle" name="title" maxlength="120" value="<%= selectedPracticeGuide.title %>" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="practiceGuideDescription">Descripción</label>
            <textarea
              class="form-control"
              id="practiceGuideDescription"
              name="description"
              rows="4"
              maxlength="500"
              required
              placeholder="Describe la práctica con Markdown sencillo."
              data-markdown-editor
              data-markdown-editor-required="true"
              data-markdown-editor-error="practiceGuideDescriptionError"
              data-markdown-editor-min-height="8rem"
            ><%= selectedPracticeGuide.description %></textarea>
            <div class="invalid-feedback" id="practiceGuideDescriptionError" hidden>
              Escribe una descripción para la guía.
            </div>
          </div>
          <div class="col-12">
            <div class="practice-guide-help-row">
              <label class="form-label" for="practiceGuideTutorInstructions">Instrucciones al tutor</label>
              <button
                class="btn btn-link practice-guide-help-button"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#practiceGuideHelpModal"
              >
                <i class="bi bi-question-circle me-1" aria-hidden="true"></i>
                Ayuda
              </button>
            </div>
            <textarea
              class="form-control"
              id="practiceGuideTutorInstructions"
              name="tutorInstructions"
              rows="10"
              maxlength="4000"
              required
              placeholder="Escribe las instrucciones del tutor con Markdown sencillo."
              data-markdown-editor
              data-markdown-editor-required="true"
              data-markdown-editor-error="practiceGuideTutorInstructionsError"
              data-markdown-editor-min-height="18rem"
            ><%= selectedPracticeGuide.tutorInstructions %></textarea>
            <div class="invalid-feedback" id="practiceGuideTutorInstructionsError" hidden>
              Escribe las instrucciones del tutor.
            </div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <button class="btn btn-primary" type="submit">
            <i class="bi bi-save me-1" aria-hidden="true"></i>Guardar detalles
          </button>
        </div>
      </div>
    </form>
  <% } %>

  <% if (activeTab === 'chat') { %>
    <div class="quiz-chat-panel">
      <div class="quiz-chat-context">
        <div class="quiz-chat-context-icon" aria-hidden="true">
          <i class="bi bi-stars"></i>
        </div>
        <div>
          <h2 class="quiz-chat-context-title">Modificar la guía con IA</h2>
          <p class="quiz-chat-context-copy mb-0">
            Usa este chat para pedir cambios concretos a la guía. Mister F actualizará el título, la descripción o las instrucciones al tutor y te responderá qué modificó.
          </p>
        </div>
      </div>
      <div class="quiz-chat-history messages" aria-label="Historial del chat de autoría" data-authoring-chat-history>
        <% if (practiceGuideAuthoringMessages.length === 0) { %>
          <article class="message-row is-model quiz-chat-message-row">
            <div class="message-bubble quiz-chat-message-bubble">
              <p class="quiz-chat-message-content mb-0">Cuéntame qué quieres ajustar en esta guía.</p>
            </div>
          </article>
        <% } else { %>
          <% practiceGuideAuthoringMessages.forEach((message) => { %>
            <article class="message-row <%= message.role === 'user' ? 'is-user' : 'is-model' %> quiz-chat-message-row">
              <div class="message-bubble quiz-chat-message-bubble">
                <p class="quiz-chat-message-content mb-0"><%= message.content %></p>
              </div>
            </article>
          <% }) %>
        <% } %>
      </div>
      <form
        class="composer quiz-chat-composer"
        method="post"
        action="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit/revise"
        data-authoring-chat-form
        data-authoring-chat-credits-return-to="/practice-guides/<%= encodeURIComponent(selectedPracticeGuide.id) %>/edit?tab=chat"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="visually-hidden" for="practiceGuideRevisionMessage">Mensaje</label>
        <div class="composer-input-wrap">
          <textarea
            class="composer-input"
            id="practiceGuideRevisionMessage"
            name="message"
            rows="2"
            maxlength="4000"
            placeholder="Describe los cambios que deseas aplicar"
            required
          ></textarea>
        </div>
        <div class="composer-footer">
          <button class="btn btn-primary quiz-chat-submit-button" type="submit" data-authoring-chat-submit>
            <i class="bi bi-stars me-1" aria-hidden="true"></i>Aplicar cambios
          </button>
        </div>
      </form>
    </div>
  <% } %>
</section>

<div
  class="modal fade"
  id="practiceGuideHelpModal"
  tabindex="-1"
  aria-labelledby="practiceGuideHelpModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="practiceGuideHelpModalLabel">Instrucciones al tutor</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">
          Describe el objetivo de práctica, el nivel esperado, los errores que quieres corregir y el tipo de ayuda que debe ofrecer Mr. F.
        </p>
        <p class="mb-0 text-body-secondary">
          También puedes indicar si quieres que el tutor use ejemplos, preguntas de seguimiento, correcciones breves o práctica guiada.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-shell-close', { pageScriptPartial: 'practice-guides-client-script' }) %>
