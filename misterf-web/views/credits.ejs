<%- include('partials/app-shell-open') %>

<%
  const moneyFormatter = new Intl.NumberFormat('en-US', {
    currency: 'USD',
    style: 'currency',
  });
  const dateFormatter = new Intl.DateTimeFormat(locale, {
    dateStyle: 'medium',
    timeStyle: 'short',
  });
  const formatMoney = (cents) => moneyFormatter.format(cents / 100);
  const formatUsd = (value) => value === null || value === undefined
    ? t('credits.notAvailable')
    : moneyFormatter.format(value);
  const formatDate = (value) => {
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
  };
  const statusLabels = {
    failed: t('credits.statusFailed'),
    fulfilled: t('credits.statusFulfilled'),
    pending: t('credits.statusPending'),
  };
  const statusClasses = {
    failed: 'text-bg-danger',
    fulfilled: 'text-bg-success',
    pending: 'text-bg-warning',
  };
%>

<section class="app-page" aria-label="<%= t('credits.title') %>">
  <div class="app-page-header">
    <div>
      <p class="app-page-kicker"><%= t('credits.kicker') %></p>
      <h1 class="app-page-title"><%= t('credits.title') %></h1>
      <p class="app-page-copy">
        <%= t('credits.copy') %>
      </p>
    </div>
  </div>

  <section class="app-page-detail-shell">
    <% if (checkoutStatus === 'success') { %>
      <div class="alert alert-success" role="status">
        <%= t('credits.paySuccess') %>
      </div>
    <% } else if (checkoutStatus === 'cancelled') { %>
      <div class="alert alert-secondary" role="status">
        <%= t('credits.payCancelled') %>
      </div>
    <% } else if (checkoutStatus === 'error') { %>
      <div class="alert alert-danger" role="alert">
        <%= checkoutError || t('credits.payErrorDefault') %>
      </div>
    <% } %>

    <div class="row g-4">
      <div class="col-12 col-xl-7">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
              <div>
                <p class="app-page-kicker mb-2"><%= t('credits.currentBalance') %></p>
                <h2 class="display-5 fw-semibold mb-1">
                  <% if (balance.availableCredits === null) { %>
                    <%= t('credits.notAvailable') %>
                  <% } else { %>
                    <%= balance.availableCredits %>
                  <% } %>
                </h2>
                <p class="mb-0 text-body-secondary">
                  <%= t('credits.creditsAvailable') %>
                </p>
              </div>
            </div>

            <% if (balance.error) { %>
              <div class="alert alert-warning mt-4 mb-0" role="alert">
                <strong><%= t('credits.balanceError') %></strong>
                <span class="d-block"><%= balance.error %></span>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-5">
        <div class="card shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <p class="app-page-kicker mb-2"><%= t('credits.buyCredits') %></p>
            <h2 class="h3 mb-2"><%= creditPackage.label %></h2>
            <p class="text-body-secondary">
              <%= creditPackage.description %>
            </p>

            <div class="list-group list-group-flush mb-4">
              <div class="list-group-item px-0 d-flex justify-content-between">
                <span><%= t('credits.youPay') %></span>
                <strong><%= formatMoney(creditPackage.customerAmountCents) %></strong>
              </div>
              <div class="list-group-item px-0 d-flex justify-content-between">
                <span><%= t('credits.youReceive') %></span>
                <strong><%= creditPackage.creditedAmountCents %> <%= t('credits.creditsSuffix') %></strong>
              </div>
            </div>

            <% if (stripeConfigurationError) { %>
              <div class="alert alert-warning mt-auto mb-0" role="alert">
                <%= stripeConfigurationError %>
              </div>
            <% } else { %>
              <form method="post" action="/credits/checkout" class="mt-auto">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="returnTo" value="<%= returnTo %>">
                <button class="btn btn-primary w-100" type="submit">
                  <%= t('credits.buyFor', { amount: formatMoney(creditPackage.customerAmountCents) }) %>
                </button>
                <p class="small text-body-secondary mt-3 mb-0">
                  <%- t('credits.payDisclaimer') %>
                </p>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="app-page-section-copy mt-4">
      <p class="app-page-kicker"><%= t('credits.recentHistory') %></p>
      <div class="card shadow-sm">
        <div class="card-body">
          <% if (purchases.length > 0) { %>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead>
                  <tr>
                    <th scope="col"><%= t('credits.colDate') %></th>
                    <th scope="col"><%= t('credits.colPackage') %></th>
                    <th scope="col"><%= t('credits.colPayment') %></th>
                    <th scope="col"><%= t('credits.colCredits') %></th>
                    <th scope="col"><%= t('credits.colStatus') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% purchases.forEach((purchase) => { %>
                    <tr>
                      <td><%= formatDate(purchase.createdAt) %></td>
                      <td><%= purchase.packageCode === 'credits_200' ? t('credits.package200') : purchase.packageCode %></td>
                      <td><%= formatMoney(purchase.customerAmountCents) %></td>
                      <td><%= purchase.creditedAmountCents %></td>
                      <td>
                        <span class="badge <%= statusClasses[purchase.status] || 'text-bg-secondary' %>">
                          <%= statusLabels[purchase.status] || purchase.status %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="mb-0 text-body-secondary">
              <%= t('credits.noPurchases') %>
            </p>
          <% } %>
        </div>
      </div>
    </div>
  </section>
</section>

<%- include('partials/app-shell-close') %>
