<%- include('partials/app-shell-open') %>

<section class="app-page quizzes-page">
  <div class="app-page-header">
    <div>
      <p class="app-page-kicker"><%= t('quizzes.resultKicker') %></p>
      <h1 class="app-page-title"><%= draft.title %></h1>
      <% if (isAuthenticated) { %>
        <%- include('partials/breadcrumb', { crumbs: [
          { label: t('resources.title'), href: '/resources' },
          { label: draft.title, href: `/quizzes/${encodeURIComponent(attempt.quizId)}` },
          { label: t('quizzes.resultKicker') },
        ] }) %>
      <% } %>
      <p class="app-page-copy"><%= t('quizzes.evaluatingCopy') %></p>
    </div>
  </div>

  <section class="app-page-detail-shell">
    <form
      method="post"
      action="/quiz-attempts/<%= encodeURIComponent(attempt.id) %>/evaluate"
      class="d-grid gap-3"
      data-quiz-auto-submit-form
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (guestToken) { %><input type="hidden" name="guestToken" value="<%= guestToken %>"><% } %>
      <div class="d-flex align-items-center gap-3">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <p class="mb-0" role="status"><%= t('quizzes.evaluating') %></p>
      </div>
      <div class="d-flex justify-content-end">
        <button class="btn btn-primary" type="submit" data-quiz-auto-submit-button>
          <i class="bi bi-check2-circle me-1" aria-hidden="true"></i><%= t('quizzes.seeResult') %>
        </button>
      </div>
    </form>
  </section>
</section>

<%- include('partials/app-shell-close', { pageScriptPartial: 'quizzes-client-script' }) %>
