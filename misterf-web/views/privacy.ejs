<!doctype html>
<html lang="<%= htmlLang %>">
  <head>
    <%- include('partials/document-head', { includeBootstrapIcons: false }) %>
  </head>
  <body>
    <main class="container py-5">
      <article class="mx-auto" style="max-width: 48rem;">
        <div class="mb-4">
          <p class="text-uppercase text-body-secondary small fw-semibold mb-2">Mister F</p>
          <h1 class="h2"><%= t('legal.privacyTitle') %></h1>
          <p class="text-body-secondary mb-0"><%= t('legal.lastUpdated') %></p>
        </div>

        <div class="card shadow-sm">
          <div class="card-body p-4 p-md-5 d-grid gap-4">
            <section>
              <h2 class="h5"><%= t('legal.p1Title') %></h2>
              <p class="mb-0"><%- t('legal.p1Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.p2Title') %></h2>
              <p><%= t('legal.p2Body1') %></p>
              <p class="mb-0"><%= t('legal.p2Body2') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.p3Title') %></h2>
              <p class="mb-0"><%= t('legal.p3Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.p4Title') %></h2>
              <p><%= t('legal.p4Body1') %></p>
              <p class="mb-0"><%= t('legal.p4Body2') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.p5Title') %></h2>
              <p class="mb-0"><%= t('legal.p5Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.p6Title') %></h2>
              <p class="mb-0"><%- t('legal.p6Body') %></p>
            </section>

            <section>
              <h2 class="h5"><%= t('legal.p7Title') %></h2>
              <p class="mb-0"><%= t('legal.p7Body') %></p>
            </section>
          </div>
        </div>

        <div class="mt-4">
          <a class="btn btn-secondary" href="/"><%= t('legal.back') %></a>
        </div>
      </article>
    </main>
    <%- include('partials/legal-footer') %>
  </body>
</html>
