<%- include('partials/app-shell-open') %>

<section class="app-page quizzes-page">
  <div class="app-page-header app-page-header-has-close">
    <div>
      <p class="app-page-kicker"><%= t('quizzes.resultKicker') %></p>
      <h1><%= resultTitle %></h1>
      <% if (resultOwnerView) { %>
        <div class="alert alert-info d-flex align-items-start gap-2 mt-3 mb-0" role="note">
          <i class="bi bi-person-circle flex-shrink-0" aria-hidden="true"></i>
          <span><%= t('quizzes.resultOwnerView', { name: resultOwnerViewParticipantLabel }) %></span>
        </div>
      <% } else { %>
      <div class="resource-action-row mt-3">
        <% if (isAuthenticated) { %>
          <form method="post" action="/quiz-attempts/<%= encodeURIComponent(attempt.id) %>/practice">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (guestToken) { %><input type="hidden" name="guestToken" value="<%= guestToken %>"><% } %>
            <button class="btn btn-primary" type="submit">
              <i class="bi bi-chat-dots me-1" aria-hidden="true"></i><%= t('quizzes.practice') %>
            </button>
          </form>
          <%- include('partials/create-resource-from-context', {
            action: `/quiz-attempts/${encodeURIComponent(attempt.id)}/resource`,
          }) %>
          <% if (!attempt.userId && guestToken) { %>
            <form method="post" action="/quiz-attempts/<%= encodeURIComponent(attempt.id) %>/claim">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="guestToken" value="<%= guestToken %>">
              <button class="btn btn-outline-secondary" type="submit"><%= t('quizzes.saveProgress') %></button>
            </form>
          <% } %>
        <% } else { %>
          <% const resultReturnTo = `/quiz-attempts/${encodeURIComponent(attempt.id)}/result${guestToken ? `?guestToken=${encodeURIComponent(guestToken)}` : ''}`; %>
          <a class="btn btn-primary" href="/signup?returnTo=<%= encodeURIComponent(resultReturnTo) %>">
            <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i><%= t('quizzes.createAccountForResult') %>
          </a>
          <a class="btn btn-outline-secondary" href="/login?returnTo=<%= encodeURIComponent(resultReturnTo) %>"><%= t('quizzes.alreadyHaveAccount') %></a>
        <% } %>
      </div>
      <% } %>
    </div>
    <div class="app-page-header-actions">
      <a
        class="app-page-close-button"
        href="/quizzes/<%= encodeURIComponent(attempt.quizId) %>"
        aria-label="<%= t('common.close') %>"
        title="<%= t('common.close') %>"
      >
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <% if (resultActionError) { %>
    <div class="alert alert-warning" role="alert">
      <p class="mb-2"><%= resultActionError %></p>
      <% if (resultActionErrorIsCredit) { %>
        <a class="btn btn-primary btn-sm" href="/credits?returnTo=<%= encodeURIComponent(`/quiz-attempts/${attempt.id}/result${guestToken ? `?guestToken=${guestToken}` : ''}`) %>"><%= t('credit.buy') %></a>
      <% } %>
    </div>
  <% } %>

  <div class="resource-detail-summary">
    <p><%= draft.title %></p>
    <div class="resource-meta-row">
      <span><i class="bi bi-check-circle" aria-hidden="true"></i> <%= summary.correctCount %> <%= t('quizzes.correctSuffix') %></span>
      <span><i class="bi bi-exclamation-circle" aria-hidden="true"></i> <%= summary.partialCount %> <%= t('quizzes.partialSuffix') %></span>
      <span><i class="bi bi-x-circle" aria-hidden="true"></i> <%= summary.incorrectCount %> <%= t('quizzes.toImproveSuffix') %></span>
    </div>
  </div>

  <div data-quiz-result-host></div>
  <div class="quiz-block-list" data-quiz-result-fallback>
    <% resultBlock.items.forEach((resultItem, index) => { %>
      <%- include('partials/quiz-result-item', { index, resultItem }) %>
    <% }) %>
  </div>
</section>

<script type="application/json" data-quiz-result-json><%- resultBlockJson %></script>

<div class="modal fade" tabindex="-1" aria-hidden="true" data-quiz-pending-modal>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body d-flex align-items-center gap-3">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <p class="mb-0"><%= t('quizzes.creatingGuide') %></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-shell-close', { pageScriptPartial: 'quizzes-client-script' }) %>
