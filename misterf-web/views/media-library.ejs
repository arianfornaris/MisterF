<%- include('partials/app-shell-open') %>

<%
  const formatLabel = (format) => t(`mediaLibrary.format.${format}`);
  const levelLabel = (level) => level || t('mediaLibrary.levelNone');
  const layerLabels = (item) => [
    item.image ? t('mediaLibrary.layerImage') : null,
    item.audio ? t('mediaLibrary.layerAudio') : null,
    item.script ? t('mediaLibrary.layerScript') : null,
  ].filter(Boolean);
%>

<section class="app-page" aria-label="<%= t('mediaLibrary.title') %>">
  <div class="app-page-header">
    <div>
      <p class="app-page-kicker"><%= t('mediaLibrary.kicker') %></p>
      <h1 class="app-page-title"><%= t('mediaLibrary.title') %></h1>
      <p class="app-page-copy">
        <%= t('mediaLibrary.intro') %>
      </p>
    </div>
  </div>

  <section class="app-page-detail-shell">
    <form class="card mb-4" method="get" action="/media-library" aria-label="<%= t('mediaLibrary.filtersAria') %>">
      <div class="card-body">
        <div class="row g-3 align-items-end">
          <div class="col-12 col-lg-5">
            <label class="form-label" for="mediaLibrarySearch"><%= t('mediaLibrary.search') %></label>
            <input
              class="form-control"
              id="mediaLibrarySearch"
              type="search"
              name="q"
              value="<%= searchQuery %>"
              placeholder="<%= t('mediaLibrary.searchPlaceholder') %>"
            >
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="mediaLibraryLevel"><%= t('mediaLibrary.level') %></label>
            <select class="form-select" id="mediaLibraryLevel" name="level">
              <option value=""><%= t('mediaLibrary.levelAll') %></option>
              <% sceneMediaLevels.forEach((level) => { %>
                <option value="<%= level %>" <%= selectedLevel === level ? 'selected' : '' %>><%= levelLabel(level) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="mediaLibraryFormat"><%= t('mediaLibrary.formatLabel') %></label>
            <select class="form-select" id="mediaLibraryFormat" name="format">
              <option value=""><%= t('mediaLibrary.formatAll') %></option>
              <% formatOptions.forEach((format) => { %>
                <option value="<%= format %>" <%= selectedFormat === format ? 'selected' : '' %>><%= formatLabel(format) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-lg-1 d-grid">
            <button class="btn btn-primary" type="submit">
              <i class="bi bi-search" aria-hidden="true"></i>
              <span class="visually-hidden"><%= t('mediaLibrary.applyFilters') %></span>
            </button>
          </div>
        </div>
      </div>
    </form>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <p class="mb-0 text-body-secondary">
        <%= t('mediaLibrary.count', { shown: mediaItems.length, total: totalMediaCount }) %>
      </p>
      <% if (searchQuery || selectedLevel || selectedFormat) { %>
        <a class="btn btn-outline-secondary btn-sm" href="/media-library"><%= t('mediaLibrary.clearFilters') %></a>
      <% } %>
    </div>

    <% if (mediaItems.length > 0) { %>
      <div class="scene-media-grid">
        <% mediaItems.forEach((item) => { %>
          <article class="card scene-media-card h-100">
            <% if (item.image) { %>
              <img
                class="card-img-top scene-media-card-image"
                src="<%= item.image.src %>"
                alt="<%= item.image.alt %>"
                loading="lazy"
              >
            <% } %>
            <div class="card-body d-flex flex-column">
              <div class="d-flex flex-wrap gap-2 mb-2">
                <% if (item.level) { %>
                  <span class="badge text-bg-primary"><%= levelLabel(item.level) %></span>
                <% } %>
                <span class="badge text-bg-light border"><%= formatLabel(item.format) %></span>
              </div>
              <h2 class="h5 mb-2"><%= item.title %></h2>
              <p class="text-body-secondary small mb-3">
                <%= item.visualSummary[0] || item.setting || t('mediaLibrary.summaryFallback') %>
              </p>
              <div class="d-flex flex-wrap gap-2 mb-3">
                <% layerLabels(item).forEach((label) => { %>
                  <span class="badge text-bg-secondary"><%= label %></span>
                <% }) %>
              </div>
              <div class="mt-auto">
                <a
                  class="btn btn-outline-primary btn-sm stretched-link"
                  href="/media-library/<%= encodeURIComponent(item.id) %>?returnTo=<%= encodeURIComponent(currentPath) %>"
                >
                  <%= t('mediaLibrary.open') %>
                </a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="alert alert-info mb-0" role="status">
        <%= t('mediaLibrary.empty') %>
      </div>
    <% } %>
  </section>
</section>

<%- include('partials/app-shell-close') %>
