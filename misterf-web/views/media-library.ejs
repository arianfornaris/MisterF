<%- include('partials/app-shell-open') %>

<%
  const formatLabel = (format) => t(`mediaLibrary.format.${format}`);
  const levelLabel = (level) => level || t('mediaLibrary.levelNone');
  const sourceLabel = (source) => t(`mediaLibrary.source.${source}`);
%>

<section class="app-page" aria-label="<%= t('mediaLibrary.title') %>">
  <div class="app-page-header">
    <div>
      <p class="app-page-kicker"><%= t('mediaLibrary.kicker') %></p>
      <h1 class="app-page-title"><%= t('mediaLibrary.title') %></h1>
      <p class="app-page-copy">
        <%= t('mediaLibrary.intro') %>
      </p>
    </div>
    <div class="app-page-header-actions">
      <a class="btn btn-primary" href="/media-library/new">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
        <%= t('resources.new') %>
      </a>
    </div>
  </div>

  <section class="app-page-detail-shell">
    <form class="card mb-2" method="get" action="/media-library" aria-label="<%= t('mediaLibrary.filtersAria') %>">
      <div class="card-body">
        <div class="row g-3 align-items-end">
          <div class="col-12 col-lg-5">
            <label class="form-label" for="mediaLibrarySearch"><%= t('mediaLibrary.search') %></label>
            <input
              class="form-control"
              id="mediaLibrarySearch"
              type="search"
              name="q"
              value="<%= searchQuery %>"
              placeholder="<%= t('mediaLibrary.searchPlaceholder') %>"
            >
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="mediaLibraryLevel"><%= t('mediaLibrary.level') %></label>
            <select class="form-select" id="mediaLibraryLevel" name="level">
              <option value=""><%= t('mediaLibrary.levelAll') %></option>
              <% sceneMediaLevels.forEach((level) => { %>
                <option value="<%= level %>" <%= selectedLevel === level ? 'selected' : '' %>><%= levelLabel(level) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="mediaLibraryFormat"><%= t('mediaLibrary.formatLabel') %></label>
            <select class="form-select" id="mediaLibraryFormat" name="format">
              <option value=""><%= t('mediaLibrary.formatAll') %></option>
              <% formatOptions.forEach((format) => { %>
                <option value="<%= format %>" <%= selectedFormat === format ? 'selected' : '' %>><%= formatLabel(format) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-lg-1 d-grid">
            <button class="btn btn-primary" type="submit">
              <i class="bi bi-search" aria-hidden="true"></i>
              <span class="visually-hidden"><%= t('mediaLibrary.applyFilters') %></span>
            </button>
          </div>
        </div>
      </div>
    </form>

    <div class="mb-4">
      <a class="small link-secondary text-decoration-none" href="/media-library/trash">
        <i class="bi bi-trash me-1" aria-hidden="true"></i><%= t('mediaLibrary.trash') %>
      </a>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <p class="mb-0 text-body-secondary">
        <%= t('mediaLibrary.count', { shown: mediaItems.length, total: totalMediaCount }) %>
      </p>
      <% if (searchQuery || selectedLevel || selectedFormat) { %>
        <a class="btn btn-outline-secondary btn-sm" href="/media-library"><%= t('mediaLibrary.clearFilters') %></a>
      <% } %>
    </div>

    <% if (mediaItems.length > 0) { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 row-cols-xxl-5 g-3">
        <% mediaItems.forEach((item) => { %>
          <div class="col">
            <article class="card scene-media-card h-100 position-relative <%= item.source === 'user_generated' ? 'scene-media-card-user' : '' %>">
              <div class="card-header d-flex align-items-center justify-content-between gap-2 py-2 px-3">
                <span class="badge <%= item.source === 'user_generated' ? 'text-bg-info' : 'text-bg-light border' %>">
                  <%= sourceLabel(item.source) %>
                </span>
              </div>
              <% if (item.image) { %>
                <div class="ratio ratio-4x3 bg-body-tertiary">
                  <img
                    class="card-img-top scene-media-card-image w-100 h-100"
                    src="<%= item.image.src %>"
                    alt="<%= item.image.alt %>"
                    loading="lazy"
                  >
                </div>
              <% } else { %>
                <div class="ratio ratio-4x3 bg-body-tertiary">
                  <div class="d-flex h-100 w-100 align-items-center justify-content-center text-body-secondary">
                    <i class="bi bi-image fs-2" aria-hidden="true"></i>
                  </div>
                </div>
              <% } %>
              <div class="card-body d-flex flex-column p-3">
                <% if (item.level) { %>
                  <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge text-bg-primary"><%= levelLabel(item.level) %></span>
                  </div>
                <% } %>
                <p class="mb-2"><%= item.title %></p>
                <a
                  class="stretched-link"
                  href="/media-library/<%= encodeURIComponent(item.id) %>?returnTo=<%= encodeURIComponent(currentPath) %>"
                  aria-label="<%= t('mediaLibrary.details') %>"
                  title="<%= t('mediaLibrary.details') %>"
                ></a>
                <div class="mt-auto d-flex flex-wrap gap-2">
                  <% if (item.image || item.audio || item.script) { %>
                    <button
                      class="btn btn-primary btn-sm position-relative z-2"
                      type="button"
                      aria-label="<%= t('mediaLibrary.play') %>"
                      title="<%= t('mediaLibrary.play') %>"
                      data-scene-media-play
                      data-media-id="<%= item.id %>"
                    >
                      <i class="bi bi-play-fill" aria-hidden="true"></i>
                    </button>
                  <% } %>
                </div>
              </div>
            </article>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="alert alert-info mb-0" role="status">
        <%= t('mediaLibrary.empty') %>
      </div>
    <% } %>
  </section>
</section>

<div
  class="modal fade"
  id="sceneMediaPreviewModal"
  tabindex="-1"
  aria-labelledby="sceneMediaPreviewModalLabel"
  aria-hidden="true"
  data-scene-media-preview-modal
>
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="sceneMediaPreviewModalLabel" data-scene-media-preview-title>
          <%= t('mediaLibrary.preview') %>
        </h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body d-grid gap-3">
        <img
          class="scene-media-detail-image d-none"
          src=""
          alt=""
          data-scene-media-preview-image
        >
        <%- include('partials/scene-media-audio-player', { audio: undefined }) %>
        <section class="d-none" data-scene-media-preview-script-section>
          <h3 class="h6 mb-2"><%= t('mediaLibrary.script') %></h3>
          <div data-scene-media-preview-script></div>
        </section>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" data-scene-media-preview-json><%- mediaPreviewItemsJson %></script>
<%- include('partials/app-shell-close', { pageScriptPartial: 'media-library-client-script' }) %>
