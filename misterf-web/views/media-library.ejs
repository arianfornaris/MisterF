<%- include('partials/app-shell-open') %>

<%
  const formatLabel = (format) => t(`mediaLibrary.format.${format}`);
  const levelLabel = (level) => level || t('mediaLibrary.levelNone');
  const sourceLabel = (source) => t(`mediaLibrary.source.${source}`);
  const statusLabel = (status) => t(`mediaLibrary.status.${status}`);
  const failureLabel = (reason) => reason === 'provider_not_configured'
    ? t('mediaLibrary.failure.providerNotConfigured')
    : reason === 'content_policy'
      ? t('mediaLibrary.failure.contentPolicy')
      : t('mediaLibrary.failure.generic');
%>

<section class="app-page" aria-label="<%= t('mediaLibrary.title') %>">
  <div class="app-page-header">
    <div>
      <p class="app-page-kicker"><%= t('mediaLibrary.kicker') %></p>
      <h1 class="app-page-title"><%= t('mediaLibrary.title') %></h1>
      <p class="app-page-copy">
        <%= t('mediaLibrary.intro') %>
      </p>
    </div>
    <div class="app-page-header-actions">
      <button
        class="btn btn-primary"
        type="button"
        data-bs-toggle="modal"
        data-bs-target="#createSceneMediaModal"
      >
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
        <%= t('mediaLibrary.createMedia') %>
      </button>
    </div>
  </div>

  <section class="app-page-detail-shell">
    <% if (mediaError) { %>
      <div class="alert alert-warning" role="alert">
        <%= mediaError === 'credit_exhausted' ? t('mediaLibrary.creditExhausted') : t('mediaLibrary.invalidRequest') %>
      </div>
    <% } %>

    <form class="card mb-4" method="get" action="/media-library" aria-label="<%= t('mediaLibrary.filtersAria') %>">
      <div class="card-body">
        <div class="row g-3 align-items-end">
          <div class="col-12 col-lg-5">
            <label class="form-label" for="mediaLibrarySearch"><%= t('mediaLibrary.search') %></label>
            <input
              class="form-control"
              id="mediaLibrarySearch"
              type="search"
              name="q"
              value="<%= searchQuery %>"
              placeholder="<%= t('mediaLibrary.searchPlaceholder') %>"
            >
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="mediaLibraryLevel"><%= t('mediaLibrary.level') %></label>
            <select class="form-select" id="mediaLibraryLevel" name="level">
              <option value=""><%= t('mediaLibrary.levelAll') %></option>
              <% sceneMediaLevels.forEach((level) => { %>
                <option value="<%= level %>" <%= selectedLevel === level ? 'selected' : '' %>><%= levelLabel(level) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="mediaLibraryFormat"><%= t('mediaLibrary.formatLabel') %></label>
            <select class="form-select" id="mediaLibraryFormat" name="format">
              <option value=""><%= t('mediaLibrary.formatAll') %></option>
              <% formatOptions.forEach((format) => { %>
                <option value="<%= format %>" <%= selectedFormat === format ? 'selected' : '' %>><%= formatLabel(format) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-lg-1 d-grid">
            <button class="btn btn-primary" type="submit">
              <i class="bi bi-search" aria-hidden="true"></i>
              <span class="visually-hidden"><%= t('mediaLibrary.applyFilters') %></span>
            </button>
          </div>
        </div>
      </div>
    </form>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <p class="mb-0 text-body-secondary">
        <%= t('mediaLibrary.count', { shown: mediaItems.length, total: totalMediaCount }) %>
      </p>
      <% if (searchQuery || selectedLevel || selectedFormat) { %>
        <a class="btn btn-outline-secondary btn-sm" href="/media-library"><%= t('mediaLibrary.clearFilters') %></a>
      <% } %>
    </div>

    <% if (mediaItems.length > 0) { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 row-cols-xxl-5 g-3">
        <% mediaItems.forEach((item) => { %>
          <div class="col">
            <article class="card scene-media-card h-100 position-relative <%= item.source === 'user_generated' ? 'scene-media-card-user' : '' %>">
              <div class="card-header d-flex align-items-center justify-content-between gap-2 py-2 px-3">
                <span class="badge <%= item.source === 'user_generated' ? 'text-bg-info' : 'text-bg-light border' %>">
                  <%= sourceLabel(item.source) %>
                </span>
                <% if (item.status !== 'ready') { %>
                  <span class="badge <%= item.status === 'failed' ? 'text-bg-danger' : 'text-bg-warning' %>">
                    <%= statusLabel(item.status) %>
                  </span>
                <% } %>
              </div>
              <% if (item.image) { %>
                <div class="ratio ratio-4x3 bg-body-tertiary">
                  <img
                    class="card-img-top scene-media-card-image w-100 h-100"
                    src="<%= item.image.src %>"
                    alt="<%= item.image.alt %>"
                    loading="lazy"
                  >
                </div>
              <% } else { %>
                <div class="ratio ratio-4x3 bg-body-tertiary">
                  <div class="d-flex h-100 w-100 align-items-center justify-content-center text-body-secondary">
                    <i class="bi bi-image fs-2" aria-hidden="true"></i>
                  </div>
                </div>
              <% } %>
              <div class="card-body d-flex flex-column p-3">
                <% if (item.level) { %>
                  <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge text-bg-primary"><%= levelLabel(item.level) %></span>
                  </div>
                <% } %>
                <p class="mb-2"><%= item.title %></p>
                <% if (item.status === 'failed') { %>
                  <p class="small text-danger mb-2"><%= failureLabel(item.failureReason) %></p>
                <% } %>
                <a
                  class="stretched-link"
                  href="/media-library/<%= encodeURIComponent(item.id) %>?returnTo=<%= encodeURIComponent(currentPath) %>"
                  aria-label="<%= t('mediaLibrary.details') %>"
                  title="<%= t('mediaLibrary.details') %>"
                ></a>
                <div class="mt-auto d-flex flex-wrap gap-2">
                  <% if (item.image || item.audio || item.script) { %>
                    <button
                      class="btn btn-primary btn-sm position-relative z-2"
                      type="button"
                      aria-label="<%= t('mediaLibrary.play') %>"
                      title="<%= t('mediaLibrary.play') %>"
                      data-scene-media-play
                      data-media-id="<%= item.id %>"
                    >
                      <i class="bi bi-play-fill" aria-hidden="true"></i>
                    </button>
                  <% } %>
                </div>
              </div>
            </article>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="alert alert-info mb-0" role="status">
        <%= t('mediaLibrary.empty') %>
      </div>
    <% } %>
  </section>
</section>

<div
  class="modal fade"
  id="createSceneMediaModal"
  tabindex="-1"
  aria-labelledby="createSceneMediaModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <form class="modal-content" method="post" action="/media-library" data-scene-media-create-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="createSceneMediaModalLabel"><%= t('mediaLibrary.createMedia') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body d-grid gap-3">
        <div>
          <label class="form-label" for="sceneMediaPrompt"><%= t('mediaLibrary.prompt') %></label>
          <textarea
            class="form-control"
            id="sceneMediaPrompt"
            name="prompt"
            rows="4"
            maxlength="2000"
            required
            placeholder="<%= t('mediaLibrary.promptPlaceholder') %>"
          ></textarea>
          <div class="form-text"><%= t('mediaLibrary.promptGuide') %></div>
        </div>

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label class="form-label" for="sceneMediaCreateLevel"><%= t('mediaLibrary.level') %></label>
            <select class="form-select" id="sceneMediaCreateLevel" name="level" required>
              <% sceneMediaLevels.forEach((level) => { %>
                <option value="<%= level %>"><%= levelLabel(level) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label" for="sceneMediaCreateFormat"><%= t('mediaLibrary.formatLabel') %></label>
            <select class="form-select" id="sceneMediaCreateFormat" name="format" required>
              <% formatOptions.forEach((format) => { %>
                <option value="<%= format %>"><%= formatLabel(format) %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <fieldset>
          <legend class="form-label"><%= t('mediaLibrary.generationMode') %></legend>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="generationMode" id="sceneMediaModeImageOnly" value="image_only" checked data-scene-media-mode>
            <label class="form-check-label" for="sceneMediaModeImageOnly"><%= t('mediaLibrary.modeImageOnly') %></label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="generationMode" id="sceneMediaModeComplete" value="complete_scene" data-scene-media-mode>
            <label class="form-check-label" for="sceneMediaModeComplete"><%= t('mediaLibrary.modeCompleteScene') %></label>
          </div>
        </fieldset>

        <div class="d-none" data-scene-media-script-type-wrap>
          <label class="form-label" for="sceneMediaCreateScriptType"><%= t('mediaLibrary.scriptType') %></label>
          <select class="form-select" id="sceneMediaCreateScriptType" name="scriptTypePreference">
            <option value="unspecified"><%= t('mediaLibrary.scriptTypeUnspecified') %></option>
            <option value="dialogue"><%= t('mediaLibrary.scriptTypeDialogue') %></option>
            <option value="narration"><%= t('mediaLibrary.scriptTypeNarration') %></option>
            <option value="monologue"><%= t('mediaLibrary.scriptTypeMonologue') %></option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
        <button class="btn btn-primary" type="submit" data-scene-media-submit>
          <%= t('mediaLibrary.createMedia') %>
        </button>
      </div>
    </form>
  </div>
</div>

<div
  class="modal fade"
  id="sceneMediaPreviewModal"
  tabindex="-1"
  aria-labelledby="sceneMediaPreviewModalLabel"
  aria-hidden="true"
  data-scene-media-preview-modal
>
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="sceneMediaPreviewModalLabel" data-scene-media-preview-title>
          <%= t('mediaLibrary.preview') %>
        </h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body d-grid gap-3">
        <img
          class="scene-media-detail-image d-none"
          src=""
          alt=""
          data-scene-media-preview-image
        >
        <audio
          class="w-100 d-none"
          controls
          preload="metadata"
          data-scene-media-preview-audio
        ></audio>
        <section class="d-none" data-scene-media-preview-script-section>
          <h3 class="h6 mb-2"><%= t('mediaLibrary.script') %></h3>
          <div data-scene-media-preview-script></div>
        </section>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" data-scene-media-preview-json><%- mediaPreviewItemsJson %></script>
<script>
  (() => {
    document.addEventListener('DOMContentLoaded', () => {
      const dataEl = document.querySelector('[data-scene-media-preview-json]');
      const modalEl = document.querySelector('[data-scene-media-preview-modal]');
      if (!dataEl || !modalEl || !window.bootstrap) {
        return;
      }

      let mediaItems = [];
      try {
        mediaItems = JSON.parse(dataEl.textContent || '[]');
      } catch {
        mediaItems = [];
      }

      const itemsById = new Map(mediaItems.map((item) => [item.id, item]));
      const modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
      const titleEl = modalEl.querySelector('[data-scene-media-preview-title]');
      const imageEl = modalEl.querySelector('[data-scene-media-preview-image]');
      const audioEl = modalEl.querySelector('[data-scene-media-preview-audio]');
      const scriptSectionEl = modalEl.querySelector('[data-scene-media-preview-script-section]');
      const scriptEl = modalEl.querySelector('[data-scene-media-preview-script]');

      document.querySelectorAll('[data-scene-media-play]').forEach((button) => {
        button.addEventListener('click', () => {
          const item = itemsById.get(button.getAttribute('data-media-id'));
          if (!item) {
            return;
          }

          if (titleEl) {
            titleEl.textContent = item.title;
          }
          renderPreviewImage(imageEl, item.image);
          renderPreviewAudio(audioEl, item.audio);
          renderPreviewScript(scriptSectionEl, scriptEl, item.script);
          modal.show();

          if (audioEl && item.audio?.src) {
            void audioEl.play().catch(() => {});
          }
        });
      });

      modalEl.addEventListener('hidden.bs.modal', () => {
        if (!audioEl) {
          return;
        }
        audioEl.pause();
        audioEl.removeAttribute('src');
        audioEl.load();
      });

      const createForm = document.querySelector('[data-scene-media-create-form]');
      const scriptTypeWrap = document.querySelector('[data-scene-media-script-type-wrap]');
      const submitButton = document.querySelector('[data-scene-media-submit]');
      const creatingLabel = <%- JSON.stringify(t('mediaLibrary.creating')) %>;
      document.querySelectorAll('[data-scene-media-mode]').forEach((radio) => {
        radio.addEventListener('change', () => {
          const complete = document.querySelector('[name="generationMode"][value="complete_scene"]')?.checked;
          scriptTypeWrap?.classList.toggle('d-none', !complete);
        });
      });
      createForm?.addEventListener('submit', () => {
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = creatingLabel;
        }
      });

      if (window.io && document.body.dataset.socketAuthToken) {
        const socket = window.io({ auth: { token: document.body.dataset.socketAuthToken } });
        ['media_generation:created', 'media_generation:updated', 'media_generation:completed', 'media_generation:failed'].forEach((eventName) => {
          socket.on(eventName, () => {
            window.location.reload();
          });
        });
      }
    });

    function renderPreviewImage(imageEl, image) {
      if (!imageEl || !image?.src) {
        imageEl?.classList.add('d-none');
        return;
      }
      imageEl.src = image.src;
      imageEl.alt = image.alt || '';
      imageEl.classList.remove('d-none');
    }

    function renderPreviewAudio(audioEl, audio) {
      if (!audioEl || !audio?.src) {
        audioEl?.classList.add('d-none');
        audioEl?.removeAttribute('src');
        return;
      }
      audioEl.src = audio.src;
      audioEl.classList.remove('d-none');
      audioEl.load();
    }

    function renderPreviewScript(sectionEl, scriptEl, script) {
      if (!sectionEl || !scriptEl || !script) {
        sectionEl?.classList.add('d-none');
        scriptEl?.replaceChildren();
        return;
      }

      scriptEl.replaceChildren();
      if (script.scriptType === 'dialogue') {
        const listEl = document.createElement('div');
        listEl.className = 'list-group list-group-flush';
        script.turns.forEach((turn) => {
          const itemEl = document.createElement('div');
          itemEl.className = 'list-group-item px-0';
          const speakerEl = document.createElement('p');
          speakerEl.className = 'fw-semibold mb-1';
          speakerEl.textContent = turn.speaker;
          const textEl = document.createElement('p');
          textEl.className = 'mb-0';
          textEl.textContent = turn.text;
          itemEl.append(speakerEl, textEl);
          listEl.append(itemEl);
        });
        scriptEl.append(listEl);
      } else {
        const textEl = document.createElement('p');
        textEl.className = 'mb-0 scene-media-script-text';
        textEl.textContent = script.text;
        scriptEl.append(textEl);
      }
      sectionEl.classList.remove('d-none');
    }
  })();
</script>

<%- include('partials/app-shell-close') %>
