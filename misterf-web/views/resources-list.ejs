<%- include('partials/app-shell-open') %>

<%
  const resourceFolderBreadcrumbItems = Array.isArray(folderBreadcrumbItems) ? folderBreadcrumbItems : [];
  const resourceFolderOptions = Array.isArray(folderOptions) ? folderOptions : [];
  const selectedFolderCanMove = selectedFolder
    && selectedFolderCanManage
    && (selectedFolderParent || resourceFolderOptions.some((folder) => folder.id !== selectedFolder.id));
%>

<section class="app-page resources-page">
  <div class="app-page-header">
    <div>
      <p class="app-page-kicker"><%= selectedFolder ? t('resources.kickerFolder') : t('resources.kickerLibrary') %></p>
      <h1 class="app-page-title"><%= selectedFolder ? selectedFolder.title : t('resources.title') %></h1>
      <% if (selectedFolder) { %>
        <%- include('partials/breadcrumb', { crumbs: [
          { label: t('resources.title'), href: '/resources' },
          ...resourceFolderBreadcrumbItems.map((folder) => ({
            label: folder.title,
            href: `/resources/folders/${encodeURIComponent(folder.id)}`,
          })),
        ] }) %>
        <% if (selectedFolderCanManage) { %>
        <div class="resource-action-row mt-3">
          <div class="dropdown">
            <button
              class="btn btn-primary dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <i class="bi bi-plus-lg me-1" aria-hidden="true"></i><%= t('resources.new') %>
            </button>
            <% const newInFolderQuery = `?folder=${encodeURIComponent(selectedFolder.id)}`; %>
            <ul class="dropdown-menu">
              <li>
                <a class="dropdown-item" href="/quizzes/new<%= newInFolderQuery %>">
                  <i class="bi bi-ui-checks-grid me-2" aria-hidden="true"></i><%= t('resources.typeQuiz') %>
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/practice-guides/new<%= newInFolderQuery %>">
                  <i class="bi bi-journal-plus me-2" aria-hidden="true"></i><%= t('resources.typePracticeGuide') %>
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/roleplays/new<%= newInFolderQuery %>">
                  <i class="bi bi-person-video3 me-2" aria-hidden="true"></i><%= t('resources.typeRoleplay') %>
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <button
                  class="dropdown-item"
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#createResourceFolderModal"
                >
                  <i class="bi bi-folder-plus me-2" aria-hidden="true"></i><%= t('resources.folder') %>
                </button>
              </li>
            </ul>
          </div>
          <div class="dropdown">
            <button
              class="btn btn-secondary dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <%= t('resources.options') %>
            </button>
            <ul class="dropdown-menu">
              <% if (selectedFolderCanMove) { %>
                <li>
                  <button
                    class="dropdown-item"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#moveResourceModal"
                    data-resource-move-open
                    data-resource-id="<%= selectedFolder.id %>"
                    data-resource-title="<%= selectedFolder.title %>"
                    data-resource-type="resource_folder"
                    data-current-folder-id="<%= selectedFolderParent ? selectedFolderParent.id : '' %>"
                  >
                    <i class="bi bi-folder-symlink me-2" aria-hidden="true"></i><%= t('resources.moveFolder') %>
                  </button>
                </li>
              <% } %>
              <li>
                <button
                  class="dropdown-item"
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#shareResourceFolderProfileModal"
                >
                  <i class="bi bi-person me-2" aria-hidden="true"></i><%= t('resources.shareWithProfile') %>
                </button>
              </li>
              <li>
                <button
                  class="dropdown-item"
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#shareResourceFolderLinkModal"
                >
                  <i class="bi bi-share me-2" aria-hidden="true"></i><%= t('resources.share') %>
                </button>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form method="post" action="/resources/<%= encodeURIComponent(selectedFolder.id) %>/archive">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="returnTo" value="/resources">
                  <button class="dropdown-item" type="submit">
                    <i class="bi bi-archive me-2" aria-hidden="true"></i><%= t('resources.archive') %>
                  </button>
                </form>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <button
                  class="dropdown-item"
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#editResourceFolderModal"
                  data-resource-folder-edit
                  data-resource-folder-id="<%= selectedFolder.id %>"
                  data-resource-folder-title="<%= selectedFolder.title %>"
                  data-resource-folder-description="<%= selectedFolder.description %>"
                >
                  <i class="bi bi-pencil me-2" aria-hidden="true"></i><%= t('resources.editFolder') %>
                </button>
              </li>
            </ul>
          </div>
        </div>
        <% } else { %>
          <div class="d-flex mt-3">
            <span class="badge text-bg-light border"><%= t('resources.shared') %></span>
          </div>
        <% } %>
        <% if (selectedFolder.description) { %>
          <div class="app-page-copy resource-markdown mt-2" data-render-markdown><%= selectedFolder.description %></div>
        <% } %>
      <% } %>
    </div>

    <% if (!selectedFolder) { %>
      <div class="app-page-header-actions">
        <div class="dropdown">
          <button
            class="btn btn-primary dropdown-toggle"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i><%= t('resources.new') %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li>
              <a class="dropdown-item" href="/quizzes/new">
                <i class="bi bi-ui-checks-grid me-2" aria-hidden="true"></i><%= t('resources.typeQuiz') %>
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="/practice-guides/new">
                <i class="bi bi-journal-plus me-2" aria-hidden="true"></i><%= t('resources.typePracticeGuide') %>
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="/roleplays/new">
                <i class="bi bi-person-video3 me-2" aria-hidden="true"></i><%= t('resources.typeRoleplay') %>
              </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <button
                class="dropdown-item"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#createResourceFolderModal"
              >
                <i class="bi bi-folder-plus me-2" aria-hidden="true"></i><%= t('resources.folder') %>
              </button>
            </li>
          </ul>
        </div>
      </div>
    <% } %>
  </div>

  <div class="resource-filter-toolbar mt-4" aria-label="<%= t('resources.controlsAria') %>">
    <div class="btn-group" role="group" aria-label="<%= t('resources.searchFilterSortAria') %>">
      <button
        class="btn <%= resourceFilters.query ? 'btn-primary' : 'btn-outline-secondary' %>"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#resourceSearchPanel"
        aria-expanded="false"
        aria-controls="resourceSearchPanel"
      >
        <i class="bi bi-search me-1" aria-hidden="true"></i><%= t('resources.search') %>
      </button>
      <button
        class="btn <%= resourceFilters.type !== 'all' ? 'btn-primary' : 'btn-outline-secondary' %>"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#resourceTypePanel"
        aria-expanded="false"
        aria-controls="resourceTypePanel"
      >
        <i class="bi bi-funnel me-1" aria-hidden="true"></i><%= t('resources.filter') %>
      </button>
      <button
        class="btn <%= resourceFilters.sort !== 'updated_desc' ? 'btn-primary' : 'btn-outline-secondary' %>"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#resourceSortPanel"
        aria-expanded="false"
        aria-controls="resourceSortPanel"
      >
        <i class="bi bi-sort-down me-1" aria-hidden="true"></i><%= t('resources.sort') %>
      </button>
    </div>
    <% if (resourceFilters.hasActiveFilters) { %>
      <a class="btn btn-link" href="<%= selectedFolder ? `/resources/folders/${encodeURIComponent(selectedFolder.id)}` : '/resources' %>"><%= t('resources.clear') %></a>
    <% } %>
  </div>

  <div class="resource-filter-panels">
    <div class="collapse" id="resourceSearchPanel" data-bs-parent=".resource-filter-panels">
      <form
        class="resource-filter-panel"
        method="get"
        action="<%= selectedFolder ? `/resources/folders/${encodeURIComponent(selectedFolder.id)}` : '/resources' %>"
      >
        <input type="hidden" name="type" value="<%= resourceFilters.type %>">
        <input type="hidden" name="sort" value="<%= resourceFilters.sort %>">
        <label class="form-label" for="resourceSearch"><%= t('resources.search') %></label>
        <div class="input-group">
          <span class="input-group-text" aria-hidden="true">
            <i class="bi bi-search"></i>
          </span>
          <input
            class="form-control"
            id="resourceSearch"
            name="q"
            value="<%= resourceFilters.query %>"
            placeholder="<%= t('resources.searchPlaceholder') %>"
          >
          <button class="btn btn-secondary" type="submit"><%= t('resources.search') %></button>
        </div>
      </form>
    </div>

    <div class="collapse" id="resourceTypePanel" data-bs-parent=".resource-filter-panels">
      <form
        class="resource-filter-panel"
        method="get"
        action="<%= selectedFolder ? `/resources/folders/${encodeURIComponent(selectedFolder.id)}` : '/resources' %>"
      >
        <input type="hidden" name="q" value="<%= resourceFilters.query %>">
        <input type="hidden" name="sort" value="<%= resourceFilters.sort %>">
        <label class="form-label" for="resourceTypeFilter"><%= t('resources.typeLabel') %></label>
        <div class="d-flex flex-column flex-sm-row gap-2">
          <select class="form-select" id="resourceTypeFilter" name="type">
            <option value="all" <%= resourceFilters.type === 'all' ? 'selected' : '' %>><%= t('resources.typeAll') %></option>
            <option value="resource_folder" <%= resourceFilters.type === 'resource_folder' ? 'selected' : '' %>><%= t('resources.typeFolders') %></option>
            <option value="quiz" <%= resourceFilters.type === 'quiz' ? 'selected' : '' %>><%= t('resources.typeQuizzes') %></option>
            <option value="practice_guide" <%= resourceFilters.type === 'practice_guide' ? 'selected' : '' %>><%= t('resources.typePracticeGuides') %></option>
            <option value="roleplay" <%= resourceFilters.type === 'roleplay' ? 'selected' : '' %>><%= t('resources.typeRoleplays') %></option>
            <option value="by_me" <%= resourceFilters.type === 'by_me' ? 'selected' : '' %>><%= t('resources.sharedByMeOption') %></option>
            <option value="with_me" <%= resourceFilters.type === 'with_me' ? 'selected' : '' %>><%= t('resources.sharedWithMeOption') %></option>
          </select>
          <button class="btn btn-secondary" type="submit"><%= t('resources.apply') %></button>
        </div>
      </form>
    </div>

    <div class="collapse" id="resourceSortPanel" data-bs-parent=".resource-filter-panels">
      <form
        class="resource-filter-panel"
        method="get"
        action="<%= selectedFolder ? `/resources/folders/${encodeURIComponent(selectedFolder.id)}` : '/resources' %>"
      >
        <input type="hidden" name="q" value="<%= resourceFilters.query %>">
        <input type="hidden" name="type" value="<%= resourceFilters.type %>">
        <label class="form-label" for="resourceSort"><%= t('resources.sort') %></label>
        <div class="d-flex flex-column flex-sm-row gap-2">
          <select class="form-select" id="resourceSort" name="sort">
            <option value="updated_desc" <%= resourceFilters.sort === 'updated_desc' ? 'selected' : '' %>><%= t('resources.sortDate') %></option>
            <option value="title_asc" <%= resourceFilters.sort === 'title_asc' ? 'selected' : '' %>><%= t('resources.sortAlpha') %></option>
            <option value="type" <%= resourceFilters.sort === 'type' ? 'selected' : '' %>><%= t('resources.sortType') %></option>
          </select>
          <button class="btn btn-secondary" type="submit"><%= t('resources.sort') %></button>
        </div>
      </form>
    </div>
  </div>

  <% if (resourceItems.length === 0) { %>
    <div class="resource-empty-state mt-4">
      <h2 class="h5">
        <% if (resourceFilters.hasActiveFilters) { %>
          <%= t('resources.emptyFiltered') %>
        <% } else { %>
          <%= selectedFolder ? t('resources.emptyFolder') : t('resources.emptyNone') %>
        <% } %>
      </h2>
    </div>
  <% } else { %>
    <div class="list-group shadow-sm mt-4">
      <% resourceItems.forEach((resource) => { %>
        <%- include('partials/resource-list-item', {
          csrfToken,
          currentPath,
          resource,
          resourceFolderOptions,
          selectedFolder,
        }) %>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/resource-move-modal', {
  resourceMoveCurrentFolder: selectedFolder,
  resourceMoveFolderOptions: resourceFolderOptions,
}) %>

<div class="modal fade" id="createResourceFolderModal" tabindex="-1" aria-labelledby="createResourceFolderModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" method="post" action="/resources/folders">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= currentPath %>">
      <% if (selectedFolder) { %>
        <input type="hidden" name="parentFolderId" value="<%= selectedFolder.id %>">
      <% } %>
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="createResourceFolderModalLabel"><%= t('resources.newFolder') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label" for="resourceFolderTitle"><%= t('resources.name') %></label>
          <input class="form-control" id="resourceFolderTitle" name="title" maxlength="160" required>
        </div>
        <div>
          <label class="form-label" for="resourceFolderDescription"><%= t('resources.description') %></label>
          <textarea class="form-control" id="resourceFolderDescription" name="description" rows="3" maxlength="800"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= t('resources.createFolder') %></button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="editResourceFolderModal" tabindex="-1" aria-labelledby="editResourceFolderModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form
      class="modal-content"
      method="post"
      action="<%= selectedFolder ? `/resources/folders/${encodeURIComponent(selectedFolder.id)}` : '/resources/folders' %>"
      data-resource-folder-edit-form
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= currentPath %>">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="editResourceFolderModalLabel"><%= t('resources.editFolder') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label" for="editResourceFolderTitle"><%= t('resources.name') %></label>
          <input
            class="form-control"
            id="editResourceFolderTitle"
            name="title"
            maxlength="160"
            required
            data-resource-folder-edit-title
          >
        </div>
        <div>
          <label class="form-label" for="editResourceFolderDescription"><%= t('resources.description') %></label>
          <textarea
            class="form-control"
            id="editResourceFolderDescription"
            name="description"
            rows="3"
            maxlength="800"
            data-resource-folder-edit-description
          ></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="submit" class="btn btn-primary"><%= t('common.saveChanges') %></button>
      </div>
    </form>
  </div>
</div>

<% if (selectedFolder && selectedFolderCanManage) { %>
  <div
    class="modal fade"
    id="shareResourceFolderProfileModal"
    tabindex="-1"
    aria-labelledby="shareResourceFolderProfileModalLabel"
    aria-hidden="true"
    <%= selectedFolderShareMode === 'profile' ? 'data-auto-open-resource-share-modal' : '' %>
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="shareResourceFolderProfileModalLabel"><%= t('resources.shareWithProfile') %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
        </div>
        <div class="modal-body">
          <% if (shareTargetResourceProfiles.length > 0) { %>
            <form method="post" action="/resources/<%= encodeURIComponent(selectedFolder.id) %>/share/profile" class="d-grid gap-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="/resources/folders/<%= encodeURIComponent(selectedFolder.id) %>">
              <div>
                <label class="form-label" for="shareTargetResourceProfileId"><%= t('resources.targetProfile') %></label>
                <select class="form-select" id="shareTargetResourceProfileId" name="targetProfileId" required>
                  <% shareTargetResourceProfiles.forEach((profile) => { %>
                    <option value="<%= profile.id %>"><%= profile.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                <button type="submit" class="btn btn-primary"><%= t('resources.shareNow') %></button>
              </div>
            </form>
          <% } else { %>
            <p class="mb-0 text-body-secondary"><%= t('resources.noOtherProfiles') %></p>
          <% } %>
        </div>
        <% if (shareTargetResourceProfiles.length === 0) { %>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div
    class="modal fade"
    id="shareResourceFolderLinkModal"
    tabindex="-1"
    aria-labelledby="shareResourceFolderLinkModalLabel"
    aria-hidden="true"
    <%= selectedFolderShareMode === 'link' ? 'data-auto-open-resource-share-modal' : '' %>
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="shareResourceFolderLinkModalLabel"><%= t('resources.shareLinkTitle') %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
        </div>
        <div class="modal-body d-grid gap-3">
          <p class="mb-0 text-body-secondary">
            <%= t('resources.shareLinkBody') %>
          </p>
          <div>
            <label class="form-label" for="resourceFolderShareLink"><%= t('resources.link') %></label>
            <input class="form-control" id="resourceFolderShareLink" value="<%= selectedFolderShareUrl %>" readonly data-resource-folder-share-link-field>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary" type="button" data-copy-resource-folder-share-link>
              <i class="bi bi-copy me-1" aria-hidden="true"></i><%= t('resources.copy') %>
            </button>
            <button class="btn btn-outline-secondary" type="button" data-native-share-resource-folder-link>
              <i class="bi bi-share me-1" aria-hidden="true"></i><%= t('resources.share') %>
            </button>
          </div>
          <% if (selectedFolderShareQrDataUrl) { %>
            <div class="d-flex justify-content-center">
              <img
                src="<%= selectedFolderShareQrDataUrl %>"
                alt="<%= t('resources.qrAlt') %>"
                width="180"
                height="180"
              >
            </div>
          <% } %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><%= t('common.close') %></button>
        </div>
      </div>
    </div>
  </div>
<% } %>

<%- include('partials/app-shell-close', { pageScriptPartial: 'resources-client-script' }) %>
